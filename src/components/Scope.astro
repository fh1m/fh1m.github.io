---
/**
 * Scope — a sonar/radar display as the hero backdrop.
 *
 * Not decoration for its own sake: the five contacts are real machines from
 * PROFILE data (via the `contacts` prop), placed at a bearing (fixed, just
 * for visual spread) and a RANGE that encodes how long ago each one started
 * — older work sits further from the center, the same way an operator would
 * read distance on a real scope. The sweep is the one continuously moving
 * element on the page; everything else here is static ring/label geometry
 * drawn once and only re-drawn on resize.
 *
 * Each contact is a real link to its machine page — a scope that only ever
 * looked like an instrument and did nothing when touched is the kind of
 * "decoration" this site is trying not to ship. Hovering or focusing a
 * label pulses its blip on the canvas so the reader can see the instrument
 * is actually reading the same data it displays.
 *
 * Canvas, not SVG: the sweep needs a fading trail (radial gradient wipe),
 * which is one canvas fill per frame and would otherwise be a stack of
 * animated SVG elements. `prefers-reduced-motion` freezes the sweep at 0°
 * and stops the rAF loop entirely — the rings and contacts stay visible.
 */
interface Contact {
  label: string;
  bearingDeg: number; // 0 = up, clockwise
  range: number; // 0..1, 0 = center (now), 1 = edge (oldest)
  href: string;
}

interface Props {
  contacts: Contact[];
  class?: string;
}

const { contacts, class: className } = Astro.props;
---

<div class={`scope-wrap ${className ?? ''}`} data-scope>
  <canvas class="scope-canvas" aria-hidden="true"></canvas>
  <div class="scope-labels">
    {contacts.map((c, i) => {
      // Convert polar (bearing, range) to a CSS percentage position so the
      // label div always sits exactly on the canvas-drawn blip regardless
      // of canvas pixel density.
      const rad = ((c.bearingDeg - 90) * Math.PI) / 180;
      const r = c.range * 42; // percent radius, leaves margin inside the 50% box
      const x = 50 + r * Math.cos(rad);
      const y = 50 + r * Math.sin(rad);
      return (
        <a
          class="scope-label mono-label"
          href={c.href}
          data-scope-idx={i}
          style={`left:${x}%; top:${y}%;`}
        >
          {c.label}
        </a>
      );
    })}
  </div>
  <p class="scope-caption mono-label">[SCOPE] {contacts.length} CONTACTS — CLICK ONE</p>
</div>

<script>
  interface ContactPoint {
    bearing: number;
    range: number;
  }

  function initScope(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.scope-canvas');
    const labelNodes = root.querySelectorAll<HTMLElement>('.scope-label');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Read the real polar data back off each label's inline position so the
    // canvas blips land exactly under the DOM labels (single source: the
    // Astro-rendered style attribute already did the polar→percent math).
    const contacts: ContactPoint[] = Array.from(labelNodes).map((el) => {
      const style = el.getAttribute('style') || '';
      const xm = style.match(/left:\s*([\d.]+)%/);
      const ym = style.match(/top:\s*([\d.]+)%/);
      const x = xm ? parseFloat(xm[1]) : 50;
      const y = ym ? parseFloat(ym[1]) : 50;
      return { bearing: x, range: y }; // stored as raw percent x/y, not polar — simpler to draw
    });

    // Hover/focus on a label (real <a> to the machine page) pulses its own
    // blip on the canvas — the one piece of proof that the instrument and
    // the links are reading the same underlying data, not two coincidences.
    let hovered = -1;
    labelNodes.forEach((el, i) => {
      const setHover = () => {
        hovered = i;
        if (reduce) drawStatic(); // no rAF loop running to pick this up otherwise
      };
      const clearHover = () => {
        if (hovered === i) hovered = -1;
        if (reduce) drawStatic();
      };
      el.addEventListener('pointerenter', setHover);
      el.addEventListener('pointerleave', clearHover);
      el.addEventListener('focus', setHover);
      el.addEventListener('blur', clearHover);
    });

    let w = 0;
    let h = 0;
    let dpr = 1;

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function ringColor() {
      return getComputedStyle(document.documentElement).getPropertyValue('--line').trim() || '#1B2622';
    }
    function signalColor() {
      return getComputedStyle(document.documentElement).getPropertyValue('--signal').trim() || '#E3A33B';
    }
    function signal2Color() {
      return getComputedStyle(document.documentElement).getPropertyValue('--signal-2').trim() || '#4FD1C5';
    }

    function drawStatic() {
      const cx = w / 2;
      const cy = h / 2;
      const maxR = Math.min(w, h) / 2 - 4;
      // A slow breathing pulse on the hovered ring only — driven off the
      // clock, not a separate rAF, so it costs nothing when nothing is
      // hovered and stays perfectly in sync with the sweep when it is.
      const pulse = reduce ? 0 : 2 + 2 * Math.sin(performance.now() / 220);
      ctx!.clearRect(0, 0, w, h);

      // Range rings
      ctx!.strokeStyle = ringColor();
      ctx!.lineWidth = 1;
      for (let i = 1; i <= 4; i++) {
        ctx!.beginPath();
        ctx!.arc(cx, cy, (maxR * i) / 4, 0, Math.PI * 2);
        ctx!.stroke();
      }
      // Crosshair
      ctx!.beginPath();
      ctx!.moveTo(cx - maxR, cy);
      ctx!.lineTo(cx + maxR, cy);
      ctx!.moveTo(cx, cy - maxR);
      ctx!.lineTo(cx, cy + maxR);
      ctx!.stroke();

      // Contact blips — the hovered/focused one (via the real <a> label)
      // gets a brighter fill and a wider, pulsing ring so the reader can
      // see the scope is reading the same contact the link points at.
      contacts.forEach((c, i) => {
        const px = (c.bearing / 100) * w;
        const py = (c.range / 100) * h;
        const isHover = i === hovered;
        ctx!.beginPath();
        ctx!.fillStyle = isHover ? signalColor() : signal2Color();
        ctx!.arc(px, py, isHover ? 4 : 2.5, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.beginPath();
        ctx!.strokeStyle = isHover ? signalColor() : signal2Color();
        ctx!.lineWidth = isHover ? 1.5 : 1;
        ctx!.globalAlpha = isHover ? 0.85 : 0.4;
        ctx!.arc(px, py, isHover ? 10 + pulse : 6, 0, Math.PI * 2);
        ctx!.stroke();
        ctx!.globalAlpha = 1;
      });
    }

    let angle = 0;
    let raf = 0;
    function drawSweep() {
      const cx = w / 2;
      const cy = h / 2;
      const maxR = Math.min(w, h) / 2 - 4;

      drawStatic();

      const grad = ctx!.createConicGradient(angle - Math.PI / 2, cx, cy);
      const sig = signalColor();
      grad.addColorStop(0, sig + '55');
      grad.addColorStop(0.06, sig + '22');
      grad.addColorStop(0.16, 'transparent');
      grad.addColorStop(1, 'transparent');
      ctx!.save();
      ctx!.beginPath();
      ctx!.arc(cx, cy, maxR, 0, Math.PI * 2);
      ctx!.clip();
      ctx!.fillStyle = grad;
      ctx!.fillRect(cx - maxR, cy - maxR, maxR * 2, maxR * 2);
      ctx!.restore();

      // Sweep line itself
      ctx!.strokeStyle = sig;
      ctx!.lineWidth = 1.25;
      ctx!.beginPath();
      ctx!.moveTo(cx, cy);
      ctx!.lineTo(cx + maxR * Math.cos(angle), cy + maxR * Math.sin(angle));
      ctx!.stroke();

      angle += 0.006;
      if (angle > Math.PI * 2) angle -= Math.PI * 2;
      raf = requestAnimationFrame(drawSweep);
    }

    resize();
    if (reduce) {
      drawStatic();
    } else {
      drawSweep();
    }

    const ro = new ResizeObserver(() => {
      resize();
      if (reduce) drawStatic();
    });
    ro.observe(canvas);

    // Cleanup on Astro view-transition swap.
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(raf);
        ro.disconnect();
      },
      { once: true },
    );
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-scope]').forEach(initScope);
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .scope-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  .scope-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .scope-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .scope-label {
    position: absolute;
    transform: translate(-50%, -140%);
    color: var(--ink-muted);
    white-space: nowrap;
    font-size: 0.625rem;
    pointer-events: auto;
    padding: var(--space-1) var(--space-2);
    margin: calc(var(--space-1) * -1) calc(var(--space-2) * -1);
    border: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .scope-label:hover,
  .scope-label:focus-visible {
    color: var(--signal);
    border-color: var(--line-strong);
  }

  .scope-caption {
    position: absolute;
    bottom: calc(var(--space-2) * -2);
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink-muted);
    /* Not `white-space: nowrap` — an absolutely-positioned, centered
       element with nowrap text has no box to wrap against and will
       widen past its own parent (this is exactly how the caption text
       overflowed the 390px viewport once "— CLICK A CONTACT" was
       appended). `width: max-content` + a `max-width` cap lets it hug
       short text but still wrap instead of escaping at narrow widths. */
    width: max-content;
    max-width: min(90vw, 340px);
    text-align: center;
  }

  @media (max-width: 720px) {
    .scope-wrap {
      max-width: 320px;
    }
  }
</style>

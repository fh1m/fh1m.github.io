---
/**
 * PublicationCards — the two real publications from the resume, cited
 * properly (author list, venue, year) rather than paraphrased into an
 * abstract that was never independently verified. Both link straight to
 * the primary source.
 */
interface Pub {
  title: string;
  authors: string;
  venue: string;
  year: string;
  note: string;
  url: string;
}

const PUBS: Pub[] = [
  {
    title: 'E-Commerce Recommendation System Based on Demand Clues',
    authors: 'Reeve, I. N., Alam, T., Rahman Munia, M., Atif Showmik, A., Faisal, M. F.',
    venue: 'Universe International Journal of Interdisciplinary Research, Vol. 4, Issue 11',
    year: '2024',
    note: 'DOI: 08.2020-25662434',
    url: 'https://uijir.com/wp-content/uploads/2024/04/17.14.-E-COMMERCE-RECOMMENDATION-SYSTEM-BASED-ON-DEMAND-CLUES.pdf',
  },
  {
    title: 'Color is Also Class Evidence: Re-evaluating Domain Generalization for Underwater Object Detection',
    authors: 'T. M. Wasif Ishmam, Yaad Kamrul Bari, Muhammad Fahim Faisal, Md Khalilur Rhaman',
    venue: 'OpenReview',
    year: '2026',
    note: 'Vision system evaluation on RoboSub 2025 / RoboSub 2026 AUVs',
    url: 'https://openreview.net/forum?id=qiFAySNAsW',
  },
];
---

<div class="pub-list">
  {PUBS.map((p) => (
    <a class="pub-card" href={p.url} target="_blank" rel="noopener noreferrer">
      <span class="pub-year mono-label">{p.year}</span>
      <div class="pub-body">
        <h3 class="pub-title">{p.title}</h3>
        <p class="pub-authors mono-label">{p.authors}</p>
        <p class="pub-venue">{p.venue} <span class="pub-note">— {p.note}</span></p>
      </div>
      <span class="pub-cta mono-label">PAPER ↗</span>
    </a>
  ))}
</div>

<style>
  .pub-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .pub-card {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
  }

  .pub-year {
    color: var(--signal);
  }

  .pub-body {
    display: grid;
    gap: var(--space-1);
  }

  .pub-title {
    font-family: var(--font-body), sans-serif;
    font-style: italic;
    font-size: var(--text-quote);
    line-height: 1.3;
    color: var(--ink);
  }

  .pub-authors {
    color: var(--ink-muted);
  }

  .pub-venue {
    color: var(--ink-muted);
    font-size: var(--text-label);
  }

  .pub-note {
    color: var(--ink-muted);
  }

  .pub-cta {
    color: var(--signal);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .pub-card {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>

---
/**
 * MachineOverview — instrument card for a machine detail page.
 *
 * Renders the machine's identity rows (category / active years / repo) with
 * a 2px top-edge accent that doubles as a status beacon, plus an optional
 * subsystem status matrix driven by `subsystems` frontmatter.
 *
 * Signal budget: the top edge is the page's third --signal application
 * (header chip + source button are the other two above the fold). The
 * status matrix uses the semantic tokens only (--signal-ok / --signal-amber
 * / --signal-fail / --ink-muted), never --signal itself.
 */
interface Subsystem {
  name: string;
  status: 'ok' | 'warn' | 'fail' | 'off';
}

interface Props {
  name: string;
  category: string;
  status: string;
  yearLabel: string;
  repoLink?: string;
  subsystems?: Subsystem[];
}

const { name, category, status, yearLabel, repoLink, subsystems } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  underwater: 'UNDERWATER',
  air: 'AIR',
  perception: 'PERCEPTION',
  compute: 'COMPUTE',
  systems: 'SYSTEMS',
};

const categoryLabel = CATEGORY_LABELS[category] ?? category.toUpperCase();
const repoDisplay = repoLink?.replace(/^https?:\/\//, '') ?? '';
const hasRepo = repoDisplay !== '';
const subs = subsystems ?? [];
const hasSubsystems = subs.length > 0;

// Top-edge accent = status beacon. Live machines get the signal token;
// dead machines get the fail token; everything else stays muted.
const edgeTone =
  status === 'running' || status === 'ongoing'
    ? 'signal'
    : status === 'failed'
      ? 'fail'
      : 'muted';
---

<section class="machine-overview" data-reveal aria-label={`${name} overview`}>
  <div class:list={['overview-card', `edge-${edgeTone}`]}>
    <div class="overview-header">
      <span class="overview-name mono-label">{name}</span>
      <span class="overview-status mono-label">{status}</span>
    </div>

    <dl class="overview-rows">
      <div class="overview-row">
        <dt class="mono-label">CATEGORY</dt>
        <dd class="mono-label">{categoryLabel}</dd>
      </div>
      <div class="overview-row">
        <dt class="mono-label">ACTIVE</dt>
        <dd class="mono-label">{yearLabel}</dd>
      </div>
      {hasRepo && (
        <div class="overview-row">
          <dt class="mono-label">REPO</dt>
          <dd class="mono-label">
            <a class="overview-repo" href={repoLink} target="_blank" rel="noopener noreferrer">
              {repoDisplay}
            </a>
          </dd>
        </div>
      )}
    </dl>

    {hasSubsystems && (
      <div class="status-matrix">
        <span class="matrix-title mono-label">STATUS MATRIX</span>
        <div class="matrix-grid">
          {subs.map((sub) => (
            <div class="status-cell">
              <span class:list={['status-dot', `status-${sub.status}`]} aria-hidden="true"></span>
              <span class="mono-label">{sub.name}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .machine-overview {
    margin-top: var(--space-12);
  }

  .overview-card {
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-top: 2px solid var(--line-strong);
  }

  .edge-signal {
    border-top-color: var(--signal);
  }

  .edge-fail {
    border-top-color: var(--signal-fail);
  }

  .edge-muted {
    border-top-color: var(--ink-muted);
  }

  .overview-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .overview-name {
    color: var(--ink);
    font-weight: 600;
  }

  .overview-status {
    color: var(--ink-muted);
  }

  .overview-rows {
    padding: 0 var(--space-4);
  }

  .overview-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }

  .overview-row + .overview-row {
    border-top: 1px solid var(--line);
  }

  .overview-row dt {
    color: var(--ink-muted);
  }

  .overview-row dd {
    color: var(--ink);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .overview-repo {
    color: var(--ink);
  }

  .overview-repo:hover {
    color: var(--ink-muted);
  }

  .status-matrix {
    border-top: 1px solid var(--line);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }

  .matrix-title {
    color: var(--ink-muted);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1px;
    background: var(--line);
    margin-top: var(--space-3);
  }

  .status-cell {
    background: var(--surface-1);
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status-cell .mono-label {
    color: var(--ink);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
  }

  .status-ok {
    background: var(--signal-ok);
  }

  .status-warn {
    background: var(--signal-amber);
  }

  .status-fail {
    background: var(--signal-fail);
  }

  .status-off {
    background: var(--ink-muted);
  }
</style>
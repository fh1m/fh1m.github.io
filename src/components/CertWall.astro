---
/**
 * CertWall — the three real RoboSub participation certificates as tilting
 * cards. Actual scans, not placeholders: `[MEDIA: PENDING]` used to be the
 * true state of every visual on this site (see README's own content-review
 * checklist) — these are the first real images it ships.
 */
interface Cert {
  year: string;
  edition: string;
  dates: string;
  src: string;
  alt: string;
}

const CERTS: Cert[] = [
  {
    year: '2024',
    edition: '27th Annual RoboSub',
    dates: 'Aug 5–11 · Irvine, CA',
    src: '/media/certs/robosub-2024.jpg',
    alt: 'RoboSub 2024 Certificate of Participation, presented to Muhammad Fahim Faisal, BRAC University / BRACU Duburi',
  },
  {
    year: '2025',
    edition: '28th Annual RoboSub',
    dates: 'Aug 11–17 · Irvine, CA',
    src: '/media/certs/robosub-2025.jpg',
    alt: 'RoboSub 2025 Certificate of Participation, presented to Muhammad Fahim Faisal, BRAC University / BRACU Duburi',
  },
  {
    year: '2026',
    edition: '29th Annual RoboSub',
    dates: 'Jul 11–16 · Irvine, CA',
    src: '/media/certs/robosub-2026.jpg',
    alt: 'RoboSub 2026 Certificate of Participation, presented to Muhammad Fahim Faisal, BRAC University / BRACU Duburi',
  },
];
---

<div class="cert-wall">
  {CERTS.map((c) => (
    <a class="cert-card" href={c.src} target="_blank" rel="noopener noreferrer" data-tilt>
      <div class="cert-image-frame">
        <img class="cert-image" src={c.src} alt={c.alt} loading="lazy" width="1600" height="1238" />
        <span class="cert-scan-line" aria-hidden="true"></span>
      </div>
      <div class="cert-meta">
        <span class="cert-year mono-label">{c.year}</span>
        <span class="cert-edition">{c.edition}</span>
        <span class="cert-dates mono-label">{c.dates}</span>
      </div>
    </a>
  ))}
</div>

<style>
  .cert-wall {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .cert-card {
    display: grid;
    gap: var(--space-3);
    border: 1px solid var(--line);
    padding: var(--space-3);
    will-change: transform;
  }

  .cert-card:hover {
    border-color: var(--line-strong);
  }

  .cert-image-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1600 / 1238;
    background: var(--surface-1);
  }

  .cert-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.05) brightness(0.92);
    transition: filter var(--dur-base) var(--ease-out);
  }

  .cert-card:hover .cert-image {
    filter: grayscale(0) contrast(1.02) brightness(1);
  }

  /* A single scanning highlight line — instrument-display flavor, not a
     full effect stack. Static (no keyframe) until hover. */
  .cert-scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--signal);
    opacity: 0;
    transform: translateY(0);
    transition: none;
  }

  .cert-card:hover .cert-scan-line {
    opacity: 0.7;
    animation: cert-scan 1.1s var(--ease-in-out) both;
  }

  @keyframes cert-scan {
    from {
      top: 0;
    }
    to {
      top: 100%;
    }
  }

  .cert-meta {
    display: grid;
    gap: var(--space-1);
  }

  .cert-year {
    color: var(--signal);
  }

  .cert-edition {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-weight: 600;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink);
  }

  .cert-dates {
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .cert-wall {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert-card:hover .cert-scan-line {
      animation: none;
    }
  }
</style>

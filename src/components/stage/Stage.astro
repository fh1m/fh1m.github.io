---
/**
 * One screen, the world is the interface. Home shows the identity and the hint line;
 * an element page adds a panel (server-rendered, complete without JS) beside the globe.
 */
import type { ElementInfo } from "../../data/elements";
import { byElement } from "../../data/lessons";
import { elements } from "../../data/elements";
interface Props { el?: ElementInfo; intro?: boolean }
const { el, intro = false } = Astro.props;
const ll = el ? byElement(el.id) : [];
---
<main id="main" class:list={["stage", el && `stage-${el.id}`]}>
  {intro && (
    <div class="intro" id="intro">
      <img class="pbd" src="/world/pale-blue-dot.webp" alt="The Pale Blue Dot: Earth as a single pale pixel in a band of scattered sunlight, photographed by Voyager 1 in 1990" width="2400" height="2375" fetchpriority="high" />
      <span class="here" aria-hidden="true"><i></i></span>
      <blockquote class="sagan">
        <p>Look again at that dot. That's here. That's home.</p>
        <footer>Carl Sagan · Voyager 1, 14 Feb 1990, ~6 billion km · NASA/JPL-Caltech</footer>
      </blockquote>
      <button class="dive mono" type="button" id="dive">come closer</button>
    </div>
  )}

  <section class:list={["who", { compact: !!el }]} aria-label="Who this is">
    <h1>Fahim Faisal<span class="faint"> · fh1m</span></h1>
    <p>Teaching machines to work on their own, in four elements, and keeping every mistake.</p>
    <p class="hint mono faint"><span class="fine">drag the world · stars are commits · pick an element</span></p>
    <ul class="els mono" aria-label="Elements">
      {elements.map((e) => <li><a href={`/${e.id}`} aria-current={el?.id === e.id ? "page" : undefined}>{e.name}</a></li>)}
    </ul>
  </section>

  {el && (
    <aside class="panel" aria-labelledby="panel-h" transition:name="panel">
      <header>
        <svg class="glyph" viewBox="0 0 48 48" aria-hidden="true" set:html={el.glyph} />
        <div>
          <h2 id="panel-h">{el.name}</h2>
          <p class="force mono">vs {el.force}</p>
        </div>
        <a class="close mono" href="/" aria-label="Back to the world">×</a>
      </header>
      <p class="says">“{el.nature}”</p>
      <ul class="tiles">
        {el.projects.map((p) => (
          <li>
            <a href={`/projects/${p.slug}`}>
              {p.hero ? <img src={p.hero} alt="" loading="lazy" /> : <svg class="noimg" viewBox="0 0 48 36" aria-hidden="true" set:html={`<g transform="translate(6 -4) scale(.75)">${el.glyph}</g>`} />}
              <span class="t">{p.title}</span>
              <span class="s mono">{p.years} · {p.status}</span>
            </a>
          </li>
        ))}
      </ul>
      {ll.length > 0 && (
        <div class="ll">
          <p class="label">Lessons learned</p>
          <ol>{ll.map((l) => <li><a href={`/lessons/${l.slug}`}><span class="mono faint">{l.id}</span> {l.title}</a></li>)}</ol>
        </div>
      )}
    </aside>
  )}
</main>

<style>
  .stage { position: relative; z-index: 1; height: 100svh; overflow: hidden; pointer-events: none; }
  .stage > * { pointer-events: auto; }

  /* Intro: the real photo, then the dive */
  .intro { position: fixed; inset: 0; z-index: 30; background: #000; overflow: hidden; transition: opacity 1.4s var(--ease); }
  .intro .pbd { position: absolute; left: 0; top: 0; width: auto; max-width: none; transform-origin: 0 0; will-change: transform; }
  .here { position: absolute; left: 50%; top: 50%; }
  .here i { position: absolute; left: -16px; top: -16px; width: 32px; height: 32px; border: 1px solid var(--red); border-radius: 50%; }
  .sagan { position: absolute; left: var(--gutter); bottom: 3.2rem; margin: 0; max-width: 30rem; transition: opacity .6s; }
  .sagan p { font: 400 var(--t3)/1.4 var(--sans); color: var(--ink-hi); margin: 0 0 .5rem; }
  .sagan footer { font: 400 var(--t-2) var(--mono); color: var(--dim); }
  .dive { position: absolute; right: var(--gutter); bottom: 3.2rem; background: none; border: 1px solid var(--line-2); color: var(--ink-hi); padding: .55rem 1rem; cursor: pointer; font-size: var(--t-1); }
  .dive:hover { border-color: var(--blue); }
  .intro.diving .sagan, .intro.diving .dive, .intro.diving .here { opacity: 0; transition: opacity .4s; }
  .intro.gone { opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) { .here i { animation: ping 2.8s var(--ease) infinite; } @keyframes ping { 0% { transform: scale(.5); opacity: 0; } 30% { opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } } }

  /* Identity, bottom-left */
  .who { position: absolute; left: var(--gutter); bottom: 2.4rem; max-width: 31rem; }
  .who h1 { font: 500 var(--t2) var(--sans); color: var(--ink-hi); margin: 0 0 .3rem; }
  .who p { margin: 0 0 .5rem; color: var(--dim); font-size: var(--t-1); }
  .hint { font-size: var(--t-2); }
  .who.compact h1, .who.compact p { display: none; }
  .who.compact .els { background: rgb(3 6 14 / .8); border: 1px solid var(--line); padding: .5rem .8rem; }
  .els { list-style: none; display: flex; gap: .9rem; margin: .8rem 0 0; padding: 0; font-size: var(--t-1); }
  .els a { color: var(--dim); text-decoration: none; }
  .els a:hover, .els a[aria-current] { color: var(--ink-hi); }
  .els a[aria-current] { border-bottom: 1px solid var(--red); }

  /* Element panel */
  .panel { position: absolute; top: 4.4rem; right: var(--gutter); bottom: 1.6rem; width: min(30rem, 38vw); overflow-y: auto; scrollbar-width: thin; padding: 1.2rem 1.2rem 1.4rem; background: rgb(3 6 14 / .78); backdrop-filter: blur(10px); border: 1px solid var(--line); }
  .panel header { display: grid; grid-template-columns: auto 1fr auto; gap: .9rem; align-items: center; }
  .panel h2 { font: 500 var(--t4) var(--sans); margin: 0; color: var(--ink-hi); }
  .force { margin: 0; font-size: var(--t-2); color: var(--dim); }
  .close { align-self: start; text-decoration: none; color: var(--dim); font-size: var(--t2); line-height: 1; }
  .close:hover { color: var(--ink-hi); }
  .glyph { width: 40px; height: 40px; stroke: var(--blue); fill: none; stroke-width: 1.3; }
  .says { font-style: italic; color: var(--ink); margin: .9rem 0 1rem; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .tiles a { display: grid; gap: .25rem; text-decoration: none; }
  .tiles img, .noimg { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--navy); border: 1px solid var(--line); filter: saturate(.8) brightness(.9); transition: filter .25s, border-color .25s; }
  .noimg { stroke: var(--line-2); fill: none; stroke-width: .6; }
  .tiles a:hover .noimg { stroke: var(--blue); border-color: var(--blue); }
  .tiles a:hover img { filter: none; border-color: var(--blue); }
  .tiles .t { color: var(--ink-hi); font-size: var(--t-1); }
  .tiles .s { color: var(--faint); font-size: var(--t-2); }
  .ll { margin-top: 1.2rem; }
  .ll ol { list-style: none; margin: .3rem 0 0; padding: 0; display: grid; gap: .35rem; font-size: var(--t-1); }
  .ll a { text-decoration: none; color: var(--ink); }
  .ll a:hover { color: var(--ink-hi); }

  @media (max-width: 900px) {
    .stage { height: auto; min-height: 100svh; overflow: visible; }
    .panel { position: relative; inset: auto; width: auto; margin: 46svh var(--gutter) 2rem; }
    .who { position: relative; left: auto; bottom: auto; padding: 5rem var(--gutter) 0; }
  }
</style>

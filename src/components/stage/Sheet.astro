---
/** A sheet of the notebook laid over the world: the shared frame for project, lesson and index pages. */
interface Props { trail?: { href?: string; label: string }[]; title: string; meta?: string; back?: string; wide?: boolean }
const { trail = [], title, meta, back = "/", wide = false } = Astro.props;
---
<main id="main" class="sheetwrap">
  <article class:list={["sheet", { wide }]} transition:name="panel">
    <header>
      {trail.length > 0 && <p class="trail mono">{trail.map((t, i) => <>{i > 0 && " ↘ "}{t.href ? <a href={t.href}>{t.label}</a> : t.label}</>)}</p>}
      <h1>{title}</h1>
      {meta && <p class="meta mono">{meta}</p>}
      <a class="close mono" href={back} aria-label="Back">×</a>
    </header>
    <slot />
  </article>
</main>
<style>
  .sheetwrap { position: relative; z-index: 1; min-height: 100svh; pointer-events: none; }
  .sheet { pointer-events: auto; position: fixed; top: 4.2rem; right: var(--gutter); max-height: calc(100svh - 5.6rem); width: min(54rem, 60vw); overflow-y: auto; scrollbar-width: thin; padding: 1.4rem 1.6rem 2rem; background: rgb(3 6 14 / .82); backdrop-filter: blur(12px); border: 1px solid var(--line); }
  .sheet.wide { width: min(72rem, 74vw); }
  header { position: relative; margin-bottom: 1rem; }
  .trail { margin: 0 0 .4rem; font-size: var(--t-2); color: var(--faint); }
  .trail a { color: var(--dim); text-decoration: none; }
  h1 { font: 500 var(--t5)/1.1 var(--sans); margin: 0 0 .4rem; color: var(--ink-hi); padding-right: 2rem; }
  .meta { margin: 0; font-size: var(--t-2); color: var(--dim); }
  .close { position: absolute; right: 0; top: 0; color: var(--dim); text-decoration: none; font-size: var(--t2); }
  .close:hover { color: var(--ink-hi); }
  @media (max-width: 900px) { .sheet, .sheet.wide { position: relative; inset: auto; width: auto; margin: 38svh .6rem 1rem; } }
</style>

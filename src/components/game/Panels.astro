---
/**
 * Every panel the planet can open, rendered on the server so all of it is in the page
 * (and readable without WebGL). Projects, heritage, the library, the graveyard and its
 * headstones, the CV office, Voyager, and the time machine.
 */
import { getCollection } from "astro:content";
import { ZONE_INFO } from "../../game/zones";
import { projects, commitCount } from "../../data/elements";
import { lessons } from "../../data/lessons";
import { series } from "../../data/series";
import { results, person } from "../../data/facts";
import { chapters } from "../../data/story";
import { dims } from "../../data/media";

const notes = await getCollection("notes");
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const zoneOf = Object.fromEntries(ZONE_INFO.flatMap((z) => z.objects.map((o) => [o, z])));
const projectObjs = ZONE_INFO.flatMap((z) => z.objects);
const lessonsFor = (slug: string) => lessons.filter((l) => l.project === slug);

const heritage = [
  { id: "heritage-jcbose", bn: "জগদীশ চন্দ্র বসু", name: "Jagadish Chandra Bose", line: "Born in Mymensingh, 1858. In 1895 he was making and catching millimetre waves: a radio receiver before radio had a name." },
  { id: "heritage-snbose", bn: "সত্যেন্দ্রনাথ বসু", name: "Satyendra Nath Bose", line: "At Dhaka University in 1924 he worked out the statistics of light. Every boson in the universe carries his name." },
  { id: "heritage-frkhan", bn: "ফজলুর রহমান খান", name: "Fazlur Rahman Khan", line: "Born in Dhaka, 1929. The tube structure: how a skyscraper stands up to the wind, with far less steel. The X-braced tube is his." },
  { id: "heritage-jrc", bn: "জামিলুর রেজা চৌধুরী", name: "Jamilur Reza Choudhury", line: "Born in Sylhet, 1943. He chaired the expert panel for the Jamuna bridge and led the international panel for the Padma bridge, which opened in 2022." },
];

// the time machine: years, the chapter(s) that start then, and what changed in how I worked
const years: { y: number | "now"; ch: string[]; guide: string }[] = [
  { y: 2021, ch: ["source"], guide: "The first code other people depended on. A bug with someone else on the receiving end is a different kind of bug." },
  { y: 2022, ch: ["source"], guide: "He kept a record of how his tools changed, not only his code. The habit of writing things down started here." },
  { y: 2023, ch: ["sky", "water"], guide: "Rockets in February, water in September. The green-arrow detector worked on his desk and failed in water: the first time a test environment lied to him." },
  { y: 2024, ch: ["cat", "current"], guide: "E-Bhapa, built in one night. Its real lesson arrived two years later, on re-reading: the compiler won't argue for you." },
  { y: 2025, ch: ["ground"], guide: "The rover's arm learned to type for the University Rover Challenge, and RoboSub was graded on a curve set by water." },
  { y: 2026, ch: ["mongla", "dristy", "rupsha"], guide: `Mongla: ${commitCount("mongla")} commits and zero dives. The zero stays on the front page because it's the honest number.` },
  { y: "now", ch: ["mohona"], guide: "Next is the first dive. Every number on this planet gets measured again in real water." },
];
// the tea house menu: ideas borrowed, and what each one changed. Short and true, never the point.
const teaMenu = [
  { idea: "Become one with the data", from: "Andrej Karpathy", did: "Duburi's vision pipeline starts by throwing data away: about 5,000 raw pool frames, blur- and exposure-checked down to about 3,500, before any model is chosen." },
  { idea: "Delete code", from: "George Hotz", did: "Mongla deletes what nothing launches. A capability is only real if the path to it is." },
  { idea: "Reduce until it can't be reduced", from: "Rick Rubin", did: "Dristy answers in 22 bytes instead of a video stream." },
  { idea: "Don't fool yourself; you're the easiest person to fool", from: "Richard Feynman", did: "Every number on this site carries the measurement that produced it, and the zero dives stay visible." },
  { idea: "There are no accidents", from: "Master Oogway", did: "Every failure gets a lesson report and the commit that killed it. The belt is the filing cabinet." },
  { idea: "Look for a new angle", from: "Hiro Hamada", did: "The frame-age bug only cracked when he stopped timing the model and started reading the camera's sequence counter." },
  { idea: "If you only do what you can do, you'll never be more than you are now", from: "Master Shifu", did: "Rockets, then rovers, then submarines, then firmware. Each one started out beyond him." },
];
const chapterById = Object.fromEntries(chapters.map((c) => [c.id, c]));
const strip = (h: string) => h.replace(/<[^>]+>/g, "");
---
{projectObjs.map((slug) => {
  const p = bySlug[slug]; const z = zoneOf[slug]; const d = p.hero ? dims(p.hero) : null; const ll = lessonsFor(slug);
  return (
    <aside class="objpanel" data-obj={slug} style={`--c:${z.colour}`} aria-labelledby={`obj-${slug}`}>
      <button class="close" type="button" aria-label="Close">Close</button>
      <p class="kicker"><span class="bn" lang="bn">{z.bn}</span> {z.name}, {p.years}</p>
      <h2 id={`obj-${slug}`}>{p.title}</h2>
      {p.hero && d && <img data-src={p.hero} alt={p.heroAlt ?? ""} width={d.w} height={d.h} loading="lazy" style={`max-width:min(100%, ${d.w}px)`} />}
      {p.line && <p class="pline">{p.line}</p>}
      <p class="sum">{p.summary}</p>
      {p.figures && <dl>{p.figures.slice(0, 4).map(([n, l]) => <><dt>{l}</dt><dd>{n}</dd></>)}</dl>}
      {ll.length > 0 && <div class="sub"><p class="sub-h">What I got wrong here</p><ul>{ll.map((l) => <li><a href={`/lessons/${l.slug}`}>{l.title}</a></li>)}</ul></div>}
      {p.notes.length > 0 && <div class="sub"><p class="sub-h">Deep dives</p><ul>{p.notes.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>}
      <p class="links"><a href={`/projects/${p.slug}`}>The whole story</a>{p.repo && <a href={`https://github.com/${p.repo}`}>Code on GitHub</a>}{p.private && <span>Private for now</span>}</p>
    </aside>
  );
})}

{heritage.map((h) => (
  <aside class="objpanel heritage" data-obj={h.id} style="--c:#e9c46a" aria-labelledby={`obj-${h.id}`}>
    <button class="close" type="button" aria-label="Close">Close</button>
    <p class="kicker">The delta</p>
    <h2 id={`obj-${h.id}`}>{h.name}</h2>
    <p class="bnname" lang="bn">{h.bn}</p>
    <p class="pline">{h.line}</p>
    <p class="sum">Bangladesh is a delta, so this is where they stand. None of this planet happens without people like them having been here first.</p>
    <p class="links"><button type="button" data-focus="home">Back to home</button></p>
  </aside>
))}

<aside class="objpanel wide" data-obj="library" style="--c:#bba6ff" aria-labelledby="obj-library">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">The library</p>
  <h2 id="obj-library">The notebook</h2>
  <p class="pline">The long versions. {notes.length} of them, on six shelves. Most have something you can drag.</p>
  {series.map((s) => {
    const parts = notes.filter((n) => n.data.series === s.id).sort((a, b) => a.data.part - b.data.part);
    return parts.length > 0 && <div class="sub"><p class="sub-h"><span class="bn" lang="bn">{s.bn}</span> {s.title}</p><ul>{parts.map((n) => <li><a href={`/notes/${n.id}`}>{n.data.title}</a></li>)}</ul></div>;
  })}
  <p class="links"><a href="/notes">The whole notebook</a></p>
</aside>

<aside class="objpanel wide" data-obj="graveyard" style="--c:#a7a39a" aria-labelledby="obj-graveyard">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">Between water and fire</p>
  <h2 id="obj-graveyard">Here lie my wrong ideas</h2>
  <p class="pline">{lessons.length} things I believed that turned out to be false. Each one was killed by a commit, and each one is written up the way NASA files a lesson learned.</p>
  <ul class="graves">{lessons.map((l) => <li><a href={`/lessons/${l.slug}`}><span class="rip">{l.id}</span> {l.title}</a></li>)}</ul>
  <p class="links"><a href="/lessons">All of them, in full</a></p>
</aside>

{lessons.map((l) => {
  const commits = l.refs.filter((r) => r.href.includes("/commit/"));
  return (
    <aside class="objpanel" data-obj={`lesson-${l.slug}`} style="--c:#a7a39a" aria-labelledby={`obj-lesson-${l.slug}`}>
      <button class="close" type="button" aria-label="Close">Close</button>
      <p class="kicker">Here lies {l.id}, {l.date}</p>
      <h2 id={`obj-lesson-${l.slug}`}>{l.title}</h2>
      <p class="believed"><span class="wrong">{l.believed}</span></p>
      <p class="sum">{l.truth}</p>
      <p class="pline">{l.lesson}</p>
      {commits.length > 0 && <p class="sum">Killed by {commits.map((c, i) => <>{i > 0 && ", "}<a class="h" href={c.href}>{c.label}</a></>)}.</p>}
      <p class="links"><a href={`/lessons/${l.slug}`}>The full report</a></p>
    </aside>
  );
})}

<aside class="objpanel" data-obj="cv" style="--c:#79b35f" aria-labelledby="obj-cv">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">The office</p>
  <h2 id="obj-cv">{person.fullName}</h2>
  <p class="pline">The short, serious version, for people with a hiring spreadsheet open.</p>
  <ul class="results">{results.map((r) => <li><span class="yr">{r.year}</span> <b>{r.event}</b>: {r.result}</li>)}</ul>
  <p class="links"><a href="/cv/fahim-faisal-cv.pdf" download>Download the PDF</a><a href="/cv">Read it here</a></p>
</aside>

<aside class="objpanel wide about" data-obj="fh1m" style="--c:#ffcf8a" aria-labelledby="obj-fh1m">
  <button class="close" type="button" aria-label="Close">Close</button>
  <div class="about-grid">
    <img data-src="/media/own/fahim.webp" alt="Fahim Faisal on a cliff path by the sea, smiling" width="768" height="1024" loading="lazy" />
    <div>
      <p class="kicker">The star of this system, for lack of a better one</p>
      <h2 id="obj-fh1m">{person.fullName}</h2>
      <p class="pline">I like machines that can't phone home, and people who can explain their numbers. Four rules I keep, each one paid for:</p>
      <ul class="rules">
        <li><b>Believe the measurement.</b> A camera queue fed the sub frames 396 ms old while every benchmark looked healthy. Now I time the photon, not the code.</li>
        <li><b>Delete before adding.</b> "Image enhancement" took gate detections from 30.4 % of frames to 1.2 %. It's gone.</li>
        <li><b>Say the zero out loud.</b> My own AUV stack has 4,742 passing tests and no dives yet, and its front page says so.</li>
        <li><b>Look for a new angle.</b> No velocity sensor on board, so the pool floor became the speedometer: 1.09 cm worst error over a 30 cm slide.</li>
      </ul>
      <p class="sum">Where the rules were learned: rockets at AERD, a rover arm at Mongol-Tori, engineering lead at BRACU Duburi, and a stack of my own. The dates are in the CV; the stories are on the planets.</p>
      <p class="links"><a href="/cv">CV</a><a href="/about">The record</a><a href="/cv/fahim-faisal-cv.pdf" download>PDF</a><a href={person.github}>GitHub</a>{person.linkedin && <a href={person.linkedin}>LinkedIn</a>}<a href={`mailto:${person.email}`}>Email</a></p>
    </div>
  </div>
</aside>

<aside class="objpanel wide" data-obj="home" style="--c:#7fb6ff" aria-labelledby="obj-home">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">Home, about six billion kilometres back</p>
  <h2 id="obj-home">The pale blue dot</h2>
  <img class="pbd" data-src="/world/cover.webp" alt="Voyager 1's Pale Blue Dot: Earth as a single pale pixel inside a band of scattered sunlight" width="720" height="720" loading="lazy" />
  <p class="pline">Somewhere in that pixel is Dhaka, and a desk with a cat on it. Everything in this system was built there.</p>
  <p class="sum">Bangladesh is a delta, and some very large ideas came out of it:</p>
  <ul class="heritage-list">{heritage.map((h) => <li><button type="button" data-focus={h.id}><span lang="bn">{h.bn}</span> {h.name}</button></li>)}</ul>
  <p class="links"><a href="https://science.nasa.gov/mission/voyager/voyager-1s-pale-blue-dot/">The picture, at NASA</a></p>
</aside>

<aside class="objpanel wide tea" data-obj="teahouse" style="--c:#ffb35c" aria-labelledby="obj-tea">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">Past the belt, there's always a pot on</p>
  <h2 id="obj-tea">The tea house</h2>
  <p class="pline">A few ideas I borrowed, and what each one changed in the work. The menu is short on purpose.</p>
  <ul class="menu">
    {teaMenu.map((t) => <li><p class="dish">{t.idea}</p><p class="from">{t.from}</p><p class="did">{t.did}</p></li>)}
  </ul>
  <p class="sum small">Free refills. The owner believes leaves in hot water is the most important technology there is, and he may be right.</p>
</aside>

<aside class="objpanel" data-obj="voyager" style="--c:#c8c8c8" aria-labelledby="obj-voyager">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">In orbit</p>
  <h2 id="obj-voyager">Voyager 1</h2>
  <p class="pline">Still going. It took the picture this all started from, then switched its cameras off for good.</p>
  <p class="sum">Launched in 1977. On 14 February 1990, at Carl Sagan's request, it turned around and photographed Earth from about six billion kilometres: one pale pixel in a band of scattered sunlight. Minutes later its cameras were switched off for good.</p>
  <p class="links"><button type="button" data-focus="home">See the dot</button><a href="https://science.nasa.gov/mission/voyager/voyager-1s-pale-blue-dot/">The picture, at NASA</a></p>
</aside>

<aside class="objpanel wide tm" data-obj="timemachine" style="--c:#8dff6a" aria-labelledby="obj-tm">
  <button class="close" type="button" aria-label="Close">Close</button>
  <p class="kicker">Yesterday is history. This is where it's kept.</p>
  <h2 id="obj-tm">The time machine</h2>
  <p class="pline">Drag through the years and the system rebuilds itself the way it actually happened. No portal fluid required; Bunnu checked.</p>
  <div class="tm-controls">
    <input type="range" id="tm-year" min="0" max={years.length - 1} step="1" value={years.length - 1} aria-label="Year" list="tm-ticks" />
    <datalist id="tm-ticks">{years.map((_, i) => <option value={i} />)}</datalist>
    <p class="tm-years" aria-hidden="true">{years.map((y) => <span>{y.y === "now" ? "Now" : y.y}</span>)}</p>
  </div>
  <p class="tm-age" id="tm-age" aria-live="polite"></p>
  {years.map((y, i) => (
    <div class="tm-year" data-i={i} data-y={y.y} hidden={i !== years.length - 1}>
      {y.ch.map((id) => { const c = chapterById[id]; return c && (
        <div class="tm-ch"><p class="tm-when"><span class="bn" lang="bn">{c.bn}</span> {c.when}</p><h3>{c.title}</h3><p>{strip(c.body[y.y === 2022 ? 1 : 0] ?? c.body[0])}</p><p class="tm-lesson">{c.lesson}</p></div>
      ); })}
      <p class="bunnu-says"><span class="who">Bunnu</span> {y.guide}</p>
    </div>
  ))}
  <p class="links"><a href="/log">The dated record</a></p>
</aside>

<style>
  .objpanel { position: absolute; z-index: 5; right: clamp(1rem, 3vw, 2.4rem); top: 50%; width: min(26rem, 90vw); max-height: 82svh; overflow-y: auto; transform: translate(24px, -50%); opacity: 0; visibility: hidden; padding: 1.2rem 1.3rem 1.2rem; border-radius: var(--r-3); background: rgb(9 14 44 / .86); backdrop-filter: blur(10px); color: #ececec; font-family: var(--sans); transition: opacity .5s ease .35s, transform .5s cubic-bezier(.2,.8,.3,1) .35s, visibility 0s linear .9s; scrollbar-width: thin; }
  .objpanel:global(.on) { opacity: 1; visibility: visible; transform: translate(0, -50%); transition-delay: .35s, .35s, 0s; }
  .objpanel .kicker { margin: 0 0 .2rem; font: 600 var(--t-1) var(--sans); color: var(--c); }
  .objpanel .bn { font-family: var(--bangla); font-weight: 400; }
  .objpanel h2 { font: 600 var(--t3)/1.15 var(--sans); color: #fff; margin: 0 0 .7rem; padding-right: 4rem; }
  .objpanel img { display: block; height: auto; max-height: 15rem; width: auto; object-fit: contain; border-radius: var(--r-2); margin: 0 0 .8rem; }
  .objpanel .sum { font: 400 var(--t-1)/1.55 var(--sans); color: #b9c3f2; margin: 0 0 .8rem; }
  .objpanel dl { display: grid; grid-template-columns: 1fr auto; gap: .25rem .9rem; margin: 0 0 .9rem; padding: .7rem .8rem; border-radius: var(--r-2); background: rgb(255 255 255 / .06); }
  .objpanel dt { font: 600 var(--t-2) var(--sans); color: #8c8c8c; }
  .objpanel dd { margin: 0; font: 400 var(--t-1) var(--mono); color: #fff; text-align: right; font-variant-numeric: tabular-nums; }
  .objpanel .links { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; }
  .objpanel .links a, .objpanel .links span { font: 500 var(--t-1) var(--sans); padding: .45rem .9rem; border-radius: var(--r-2); background: #fff; color: #000; text-decoration: none; }
  .objpanel .links a + a { background: rgb(255 255 255 / .12); color: #fff; }
  .objpanel .links span { background: rgb(255 255 255 / .12); color: #c8c8c8; }
  .close { position: absolute; top: .9rem; right: .9rem; font: 500 var(--t-2) var(--sans); color: #fff; background: rgb(255 255 255 / .12); border: 0; border-radius: var(--r-2); padding: .35rem .75rem; cursor: pointer; }
  @media (max-width: 760px) { .objpanel { top: auto; bottom: 1rem; left: 1rem; right: 1rem; width: auto; max-height: 64svh; transform: translateY(20px); } .objpanel:global(.on) { transform: none; } }
  .objpanel.wide { width: min(32rem, 92vw); }
  .objpanel .sub { margin: 0 0 .8rem; }
  .objpanel .sub-h { margin: 0 0 .3rem; font: 600 var(--t-2) var(--sans); color: #8c8c8c; }
  .objpanel .sub ul, .graves, .results { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .objpanel .sub a, .graves a { font: 600 var(--t-1)/1.4 var(--sans); color: #fff; }
  .graves .rip { font: 400 var(--t-2) var(--mono); color: #8c8c8c; margin-right: .3rem; }
  .results li { font: 500 var(--t-1)/1.45 var(--sans); color: #d0d0d0; }
  .results .yr { font: 400 var(--t-2) var(--mono); color: #8c8c8c; margin-right: .3rem; }
  .results b { color: #fff; }
  .bnname { font: 400 var(--t1) var(--bangla); color: var(--c); margin: -.3rem 0 .6rem; }
  .believed { margin: 0 0 .5rem; }
  .objpanel .wrong { color: #b9c3f2; text-decoration: line-through; text-decoration-color: #ff6b5b; text-decoration-thickness: 2px; }
  .objpanel .h { font-family: var(--mono); color: #fff; }
  .tm-controls { margin: 0 0 .6rem; }
  .tm-controls input { width: 100%; accent-color: var(--c); }
  .tm-years { display: flex; justify-content: space-between; margin: .2rem 0 0; font: 600 var(--t-2) var(--sans); color: #8c8c8c; }
  .tm-age { font: 600 var(--t-1)/1.5 var(--sans); color: var(--c); margin: 0 0 .8rem; min-height: 3em; }
  .tm-ch { margin: 0 0 .8rem; }
  .tm-when { margin: 0; font: 500 var(--t-2) var(--sans); color: #8c8c8c; }
  .tm-ch h3 { margin: .1rem 0 .3rem; font: 600 var(--t1) var(--sans); color: #fff; }
  .tm-ch p { font: 400 var(--t-1)/1.55 var(--sans); color: #c8c8c8; margin: 0 0 .3rem; }
  .tm-lesson { font-style: italic; color: #fff !important; }
  .bunnu-says { margin: .4rem 0 .9rem; padding: .7rem .8rem; border-radius: var(--r-2); background: rgb(255 255 255 / .07); font: 600 var(--t-1)/1.5 var(--sans); color: #fff; }
  .bunnu-says .who { display: block; font: 600 var(--t-2) var(--sans); color: #ff9ec2; margin-bottom: .1rem; }
.objpanel .links button { font: 500 var(--t-1) var(--sans); color: #000; background: #ececec; border: 0; border-radius: var(--r-2); padding: .45rem .8rem; cursor: pointer; }
.about-grid { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1.2rem; align-items: start; }
.about-grid img { width: 100%; height: auto; border-radius: var(--r-2); }
.rules { list-style: none; margin: .4rem 0 .9rem; padding: 0; display: grid; gap: .55rem; font: 400 var(--t-1)/1.5 var(--sans); color: #c9ccd2; }
.rules b { display: block; color: var(--c); font-weight: 600; }
.roles .yr, .results .yr { display: inline-block; min-width: 4.4rem; font-family: var(--mono); color: var(--c); }
.pbd { width: 100%; max-width: 18rem; height: auto; border-radius: var(--r-2); margin: .3rem 0 .8rem; }
.heritage-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: .35rem; }
.heritage-list button { all: unset; cursor: pointer; font: 400 var(--t-1) var(--sans); color: #e8e8e8; }
.heritage-list button:hover { color: var(--c); }
.heritage-list span { font-family: var(--bangla); color: var(--c); margin-right: .4rem; }
.menu { list-style: none; margin: .4rem 0 1rem; padding: 0; display: grid; gap: .8rem; }
.menu li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .1rem 1rem; padding-bottom: .7rem; border-bottom: 1px dotted #3a3a3a; }
.menu .dish { margin: 0; font: 500 var(--t0)/1.35 var(--sans); color: #fff; }
.menu .from { margin: 0; font: italic 400 var(--t-1) var(--sans); color: var(--c); text-align: right; }
.menu .did { grid-column: 1 / -1; margin: 0; font: 400 var(--t-1)/1.5 var(--sans); color: #b8bcc4; }
.small { font-size: var(--t-2) !important; color: #8a8f99 !important; }
@media (max-width: 700px) { .about-grid { grid-template-columns: 1fr; } .about-grid img { max-width: 12rem; } }
</style>

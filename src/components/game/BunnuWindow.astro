---
/**
 * Bunnu's window: how I talk to visitors. A flat portrait of her in her helmet, a speech bubble,
 * and the mission controls (hypotheses to test, then the fix and the evidence).
 */
---
<section class="bunnu" id="bunnu" aria-live="polite" aria-label="Bunnu">
  <svg class="face" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="52" r="46" fill="#18205a" />
    <g class="cat">
      <path d="M22 40 L30 14 L42 32 Z" fill="#2a2730" /><path d="M27 34 L31 21 L37 31 Z" fill="#f2a3b3" />
      <path d="M78 40 L70 14 L58 32 Z" fill="#f7f4ef" /><path d="M73 34 L69 21 L63 31 Z" fill="#f2a3b3" />
      <ellipse cx="50" cy="56" rx="31" ry="27" fill="#f7f4ef" />
      <path d="M20 52 C20 34 34 28 46 30 C40 36 36 44 34 52 Z" fill="#2a2730" />
      <g class="eyes"><ellipse cx="39" cy="54" rx="4" ry="5.5" fill="#2b2a1f" /><ellipse cx="61" cy="54" rx="4" ry="5.5" fill="#2b2a1f" /><circle cx="40.5" cy="52" r="1.3" fill="#fff" /><circle cx="62.5" cy="52" r="1.3" fill="#fff" /></g>
      <path d="M47 63 L53 63 L50 66 Z" fill="#f2a3b3" />
      <path d="M50 66 Q46 70 43 68 M50 66 Q54 70 57 68" stroke="#2b2a1f" stroke-width="1.4" fill="none" stroke-linecap="round" />
      <g stroke="#b8b2a6" stroke-width=".8"><path d="M30 62 L16 60 M30 65 L16 67" /><path d="M70 62 L84 60 M70 65 L84 67" /></g>
    </g>
    <circle cx="50" cy="52" r="45" fill="none" stroke="#cfe6ff" stroke-width="3" opacity=".55" />
    <path d="M24 26 A34 34 0 0 1 48 14" stroke="#ffffff" stroke-width="4" fill="none" opacity=".45" stroke-linecap="round" />
    <path d="M14 82 Q50 100 86 82" stroke="#ff4f8b" stroke-width="5" fill="none" stroke-linecap="round" />
  </svg>
  <div class="bubble">
    <p class="name">Bunnu</p>
    <p class="say" id="bunnu-say"></p>
    <div class="acts" id="bunnu-acts"></div>
  </div>
</section>
<style>
  .bunnu { position: absolute; z-index: 6; left: clamp(.8rem, 3vw, 2rem); bottom: 6.2rem; display: flex; align-items: flex-end; gap: .7rem; width: min(30rem, 92vw); opacity: 0; transform: translateY(16px); pointer-events: none; transition: opacity .5s ease, transform .5s cubic-bezier(.2,.8,.3,1.2); font-family: var(--story); }
  .bunnu:global(.on) { opacity: 1; transform: none; pointer-events: auto; }
  .face { width: 5.4rem; height: 5.4rem; flex: none; filter: drop-shadow(0 6px 14px rgb(0 0 0 / .35)); }
  .bunnu:global(.on) .face { animation: bob 3.2s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-4px) rotate(-2deg); } }
  .eyes { transform-origin: 50px 54px; animation: blink 5s infinite; }
  @keyframes blink { 0%, 94%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  .bubble { position: relative; flex: 1; padding: .8rem 1rem .9rem; border-radius: 1.1rem 1.1rem 1.1rem .3rem; background: #fff; color: #18205a; box-shadow: 0 10px 30px rgb(0 0 0 / .3); max-height: 60svh; overflow-y: auto; }
  .name { margin: 0 0 .15rem; font: 800 var(--t-2) var(--story); color: #ff4f8b; }
  .say { margin: 0; font: 600 var(--t0)/1.5 var(--story); min-height: 1.5em; }
  .acts { display: grid; gap: .4rem; margin-top: .7rem; }
  .acts:empty { display: none; }
  .acts :global(button), .acts :global(a.btn) { text-align: left; font: 700 var(--t-1)/1.4 var(--story); color: #18205a; background: #eef1ff; border: 0; border-radius: .8rem; padding: .55rem .8rem; cursor: pointer; text-decoration: none; transition: background .2s, transform .15s; }
  .acts :global(button:hover) { background: #dfe5ff; transform: translateX(2px); }
  .acts :global(button.primary), .acts :global(a.btn.primary) { background: #18205a; color: #fff; text-align: center; }
  .acts :global(button.struck) { text-decoration: line-through; text-decoration-color: #e5533d; text-decoration-thickness: 2px; color: #7c84b0; cursor: default; }
  .acts :global(.fix) { margin: .2rem 0 0; font: 500 var(--t-1)/1.55 var(--story); color: #18205a; }
  .acts :global(.nums) { margin: 0; font: 400 var(--t-2)/1.5 var(--mono); color: #3d4aa8; }
  .acts :global(blockquote) { margin: .2rem 0 0; padding: 0; font: italic 600 var(--t-1)/1.5 var(--story); color: #3d4aa8; }
  .acts :global(blockquote span) { display: block; font: 700 var(--t-2) var(--story); font-style: normal; color: #7c84b0; }
  .acts :global(.row) { display: flex; flex-wrap: wrap; gap: .4rem; }
  @media (max-width: 760px) { .bunnu { bottom: 6.6rem; } .face { width: 4rem; height: 4rem; } }
</style>

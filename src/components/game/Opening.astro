---
/**
 * The opening: the real photograph. Voyager 1's Pale Blue Dot (NASA/JPL-Caltech, "Pale Blue Dot
 * Revisited", PIA23645, 2020), a slow push toward the pixel that is Earth, then who I am.
 * Facts: NASA, "10 Things You Might Not Know About Voyager's Famous 'Pale Blue Dot' Photo" (2020).
 * Click, Space or Enter goes on; Skip goes straight to the system.
 */
const beats = [
  "14 February 1990. Voyager 1, six billion kilometres out, turns its camera around one last time.",
  "It took years of asking. The cameras needed three hours to warm up, and the beam across the frame is sunlight scattering inside the optics.",
  "That point of light, inside the beam, is Earth.",
  "“That's here. That's home. That's us.”",
  "Somewhere in that pixel is Dhaka. I'm Fahim, and I build robots that have to work on their own. Here is everything I've built, laid out as a small system you can fly through.",
];
---
<section class="opening" id="opening" aria-label="Opening: Voyager 1's Pale Blue Dot">
  <div class="photo-wrap" aria-hidden="true">
    <img class="photo" src="/world/pbd.webp" srcset="/world/pbd-1200.webp 1200w, /world/pbd.webp 2400w" sizes="100vw" alt="" width="2400" height="2375" fetchpriority="high" />
    <span class="dot-ring"></span>
  </div>
  <div class="text">
    {beats.map((b, i) => <p class:list={["beat", { q: i === 3, me: i === 4 }]} data-i={i}>{b}{i === 3 && <span class="who">Carl Sagan, who asked for the picture</span>}</p>)}
  </div>
  <p class="credit">Image: NASA/JPL-Caltech, Pale Blue Dot Revisited (2020)</p>
  <div class="controls">
    <button class="next" id="op-next" type="button">Go on</button>
    <button class="op-skip" id="op-skip" type="button">Skip</button>
  </div>
</section>
<style>
  .opening { position: fixed; inset: 0; z-index: 30; background: #000; overflow: hidden; cursor: pointer; transition: opacity 1.2s ease; font-family: var(--sans); }
  .opening.gone { opacity: 0; pointer-events: none; }
  .photo-wrap { position: absolute; inset: 0; transform-origin: 59.45% 51.88%; transition: transform 9s cubic-bezier(.25,.1,.2,1), filter 2s ease; will-change: transform; }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 59.45% 51.88%; opacity: 0; transition: opacity 2.2s ease; }
  .opening[data-beat] .photo { opacity: 1; }
  .opening[data-beat="2"] .photo-wrap, .opening[data-beat="3"] .photo-wrap { transform: scale(3.2); }
  .opening[data-beat="4"] .photo-wrap { transform: scale(5.5); filter: brightness(.55); }
  .dot-ring { position: absolute; left: 59.45%; top: 51.88%; width: 26px; height: 26px; margin: -13px 0 0 -13px; border: 1px solid rgb(255 255 255 / .7); border-radius: 50%; opacity: 0; transition: opacity 1.5s ease 1s; }
  .opening[data-beat="2"] .dot-ring { opacity: 1; }
  .text { position: absolute; left: clamp(1.4rem, 6vw, 5rem); bottom: clamp(5rem, 14vh, 9rem); width: min(40rem, 86vw); }
  .beat { position: absolute; left: 0; bottom: 0; margin: 0; font: 400 clamp(1.15rem, 2vw, 1.6rem)/1.45 var(--sans); color: #f2f2f2; text-shadow: 0 2px 18px rgb(0 0 0 / .9); opacity: 0; transform: translateY(10px); transition: opacity .25s ease, transform .25s ease; }
  .beat.on { opacity: 1; transform: none; transition: opacity .9s ease .3s, transform .9s ease .3s; }
  .beat.q { font-style: italic; font-size: clamp(1.4rem, 2.6vw, 2.1rem); }
  .beat.me { font-size: clamp(1.1rem, 1.8vw, 1.45rem); }
  .who { display: block; margin-top: .6rem; font: 400 var(--t-1) var(--sans); font-style: normal; color: #b8bcc4; }
  .credit { position: absolute; right: 1.2rem; bottom: 1rem; margin: 0; font: 400 var(--t-2) var(--sans); color: rgb(255 255 255 / .45); }
  .controls { position: absolute; left: clamp(1.4rem, 6vw, 5rem); bottom: 1.6rem; display: flex; gap: .5rem; }
  .controls button { font: 500 var(--t-1) var(--sans); color: #000; background: #ececec; border: 0; border-radius: 6px; padding: .6rem 1rem; cursor: pointer; }
  .controls .op-skip { background: transparent; color: #e8e8e8; border: 1px solid #555; }
  @media (prefers-reduced-motion: reduce) { .photo-wrap, .beat { transition: none; } }
</style>

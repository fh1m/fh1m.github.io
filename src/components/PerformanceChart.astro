---
/**
 * PerformanceChart — SVG sparkline from optional `trend` frontmatter.
 *
 * Line uses --line-strong (not --signal: the page's signal budget is spent
 * above the fold). The gradient fill uses the allowed hardcoded hex #6AB8FF
 * (the --signal token) because SVG gradient stop-color cannot use var()
 * across browsers. The best-value point (peak) carries the page's single
 * --signal-amber marker.
 *
 * Values are ranks: lower is better, so the minimum value plots at the top.
 */
interface TrendPoint {
  year: string;
  label: string;
  value: number;
}

interface Props {
  trend: TrendPoint[];
}

const { trend } = Astro.props;

const W = 640;
const H = 200;
const PAD_X = 80;
const PAD_TOP = 44;
const PAD_BOTTOM = 44;

const values = trend.map((point) => point.value);
const min = Math.min(...values);
const max = Math.max(...values);
const range = max - min || 1;

const x = (i: number) => PAD_X + (i * (W - 2 * PAD_X)) / (trend.length - 1);
const y = (v: number) => PAD_TOP + ((v - min) / range) * (H - PAD_TOP - PAD_BOTTOM);

const points = trend.map((point, i) => ({ ...point, x: x(i), y: y(point.value) }));
const linePoints = points.map((p) => `${p.x},${p.y}`).join(' ');
const areaPath = `M ${points[0].x} ${points[0].y} L ${points.map((p) => `${p.x} ${p.y}`).join(' L ')} L ${points[points.length - 1].x} ${H} L ${points[0].x} ${H} Z`;

const peak = points.reduce((best, p) => (p.value < best.value ? p : best), points[0]);
---

{trend.length > 0 && (
  <section class="performance-chart" data-reveal aria-label="Performance trend">
    <h2 class="guide-heading mono-label">PERFORMANCE TREND</h2>
    <svg
      class="perf-svg"
      viewBox={`0 0 ${W} ${H}`}
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Performance trend over time"
    >
      <defs>
        <linearGradient id="perf-fill" x1="0" y1="0" x2="0" y2="1">
          <!-- Hardcoded #6AB8FF = --signal token. SVG gradient stop-color
               cannot use var() across browsers (Safari) — allowed exception. -->
          <stop offset="0%" stop-color="#6AB8FF" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#6AB8FF" stop-opacity="0" />
        </linearGradient>
      </defs>

      <path class="perf-area" d={areaPath} />
      <polyline class="perf-line" points={linePoints} />

      <!-- Peak marker: the page's single --signal-amber application -->
      <rect class="perf-peak" x={peak.x - 3} y={peak.y - 3} width="6" height="6" rx="0" shape-rendering="crispEdges" />

      {points.map((p) => (
        <text class="perf-label" x={p.x} y={p.y - 14} text-anchor="middle">
          {p.label}
        </text>
      ))}
      {points.map((p) => (
        <text class="perf-year" x={p.x} y={H - 16} text-anchor="middle">
          {p.year}
        </text>
      ))}
    </svg>
  </section>
)}

<style>
  .performance-chart {
    margin-top: var(--space-12);
  }

  .guide-heading {
    color: var(--ink-muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .perf-svg {
    width: 100%;
    height: auto;
    display: block;
    margin-top: var(--space-4);
  }

  .perf-area {
    fill: url(#perf-fill);
  }

  .perf-line {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .perf-peak {
    fill: var(--signal-amber);
  }

  .perf-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink);
  }

  .perf-year {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink-muted);
  }
</style>
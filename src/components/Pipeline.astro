---
// Inline SVG autonomy pipeline — PERCEIVE → ESTIMATE → PLAN → ACT.
// The traveling signal pulse runs on a 6s loop only when motion is
// allowed; under `prefers-reduced-motion: reduce` it stays static.
// Zero border-radius, tokens only, no external assets.
---

<figure class="pipeline" aria-label="Autonomy pipeline: perceive, estimate, plan, act">
  <svg viewBox="0 0 960 200" role="img" aria-labelledby="pipeline-title">
    <title id="pipeline-title">Autonomy pipeline — perceive, estimate, plan, act</title>

    <!-- full-span track; the node squares occlude the middle spans -->
    <path class="pipeline-track" d="M 112 110 H 768" />

    <!-- traveling signal pulse (static at the start of the track by default) -->
    <circle class="pipeline-pulse" cx="112" cy="110" r="4" />

    <g class="pipeline-node">
      <rect x="48" y="78" width="64" height="64" />
      <text x="80" y="170" text-anchor="middle" class="mono-label">PERCEIVE</text>
    </g>
    <g class="pipeline-node">
      <rect x="288" y="78" width="64" height="64" />
      <text x="320" y="170" text-anchor="middle" class="mono-label">ESTIMATE</text>
    </g>
    <g class="pipeline-node">
      <rect x="528" y="78" width="64" height="64" />
      <text x="560" y="170" text-anchor="middle" class="mono-label">PLAN</text>
    </g>
    <g class="pipeline-node">
      <rect x="768" y="78" width="64" height="64" />
      <text x="800" y="170" text-anchor="middle" class="mono-label">ACT</text>
    </g>
  </svg>
  <figcaption class="mono-label">[LOOP: 6S] [REDUCED MOTION: STATIC]</figcaption>
</figure>

<style>
  .pipeline {
    width: 100%;
    display: grid;
    gap: var(--space-3);
  }

  .pipeline svg {
    width: 100%;
    height: auto;
  }

  .pipeline-track {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .pipeline-node rect {
    fill: var(--surface-0);
    stroke: var(--line);
    stroke-width: 1;
  }

  .pipeline-node text {
    fill: var(--ink-muted);
  }

  .pipeline-pulse {
    fill: var(--signal);
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pipeline-pulse {
      animation: pipeline-travel 6s linear infinite;
    }
  }

  @keyframes pipeline-travel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(656px);
    }
  }
</style>
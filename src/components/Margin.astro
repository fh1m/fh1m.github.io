---
/** A notebook margin note: the calm annotation. A hand-drawn arrow in SVG, text in the DOM. */
interface Props { text: string }
const { text } = Astro.props;
---
<p class="margin">
  <svg viewBox="0 0 40 28" aria-hidden="true"><path d="M2 4 C 10 20, 22 24, 36 22 M28 15 L36 22 L27 27" /></svg>
  <span>{text}</span>
</p>
<style>
  .margin { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.6rem; align-items: start; margin: 1.6rem 0 0.4rem; font: italic 400 1.02rem/1.5 var(--serif); color: var(--estimate); max-width: 52ch; }
  svg { width: 2.4rem; height: auto; margin-top: 0.15rem; }
  path { fill: none; stroke: var(--estimate); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>

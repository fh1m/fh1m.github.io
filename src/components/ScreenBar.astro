---
/**
 * The shared reading-page header: identity, visible primary routes, current context
 * and a native disclosure for the lab, worlds and professional documents.
 */
interface Props { crumb?: { href: string; label: string; bn?: string }; progress?: boolean }
const { crumb, progress = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "");
const primary = [
  { href:"/log", label:"Life", active:here === "/log" },
  { href:"/everything", label:"Work", active:/^\/(everything|projects|air|water|earth|fire)(\/|$)/.test(here) },
  { href:"/notes", label:"Notebook", active:/^\/(notes|lessons)(\/|$)/.test(here) },
  { href:"/about", label:"About & CV", active:/^\/(about|cv|resume)(\/|$)/.test(here) },
];
const contents = [
  ["/lab", "Interactive lab"], ["/lessons", "What I got wrong"],
  ["/air", "Air · flight and control"], ["/water", "Water · underwater work"],
  ["/earth", "Earth · rovers and small robots"], ["/fire", "Fire · sensing and tools"],
  ["/now", "Now"], ["/cv", "Professional documents"],
];
---
<nav class="sbar" aria-label="Site">
  <a href="/" class="identity" aria-label="Fahim Faisal, home"><span>fh1m</span><small>Fahim Faisal</small></a>
  <div class="primary">{primary.map((link) => <a href={link.href} class:list={{ active:link.active }} aria-current={here === link.href ? "page" : undefined}>{link.label}</a>)}</div>
  {crumb && <a href={crumb.href} class="crumb">{crumb.bn && <span class="bn" lang="bn">{crumb.bn}</span>} {crumb.label}</a>}
  <details class="contents">
    <summary class="pill ghost">More</summary>
    <ul>{primary.map((link) => <li class="mobile-main"><a href={link.href} aria-current={here === link.href ? "page" : undefined}>{link.label}</a></li>)}{contents.map(([href, label]) => <li><a href={href} aria-current={here === href ? "page" : undefined}>{label}</a></li>)}</ul>
  </details>
  {progress && <span class="progress" aria-hidden="true"><span id="sbar-progress"></span></span>}
</nav>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".sbar .contents");
  document.addEventListener("pointerdown", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menu?.open) return;
    menu.open = false;
    menu.querySelector("summary")?.focus();
  });
</script>
{progress && <script>
  // Native document navigation gives this progress indicator its own page lifetime.
  const on = () => { const bar = document.getElementById("sbar-progress"); if (!bar) return; const h = document.documentElement; bar.style.transform = `scaleX(${h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight)})`; };
  addEventListener("scroll", on, { passive: true }); on();
</script>}
<style>
  .sbar { position:fixed; z-index:20; top:0; left:0; right:0; display:flex; align-items:center; gap:1.15rem; padding:.5rem var(--gutter); background:var(--page); border-bottom:1px solid var(--line); font-family:var(--interface); }
  .identity { display:flex; align-items:center; gap:.65rem; min-height:44px; color:var(--ink-hi); font:500 1.125rem/1 var(--mono); text-decoration:none; white-space:nowrap; }
  .identity small { font:400 var(--t-2)/1.4 var(--interface); color:var(--dim); }
  .identity:hover { color:var(--instrument); }
  .primary { display:flex; align-items:center; gap:1.1rem; }
  .primary a { display:flex; align-items:center; min-height:44px; color:var(--ink); font:500 var(--t-1)/1.4 var(--interface); text-decoration:none; white-space:nowrap; border-bottom:2px solid transparent; }
  .primary a:hover, .primary a.active { color:var(--instrument); border-bottom-color:var(--instrument); }
  .crumb { font:400 var(--t-2)/1.4 var(--interface); color:var(--dim); text-decoration:none; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
  .crumb .bn { color:var(--instrument); margin-right:.3rem; }
  .contents { margin-left:auto; position:relative; flex:none; }
  .contents summary { list-style:none; cursor:pointer; min-height:44px; display:flex; align-items:center; gap:.65rem; }
  .contents summary::after { content:"+"; color:var(--instrument); }
  .contents[open] summary::after { content:"−"; }
  .contents summary::-webkit-details-marker { display:none; }
  .contents ul { position:absolute; right:0; top:calc(100% + .5rem); margin:0; padding:.5rem; list-style:none; width:20rem; max-width:calc(100vw - 2 * var(--gutter)); max-height:calc(100svh - var(--header-height) - 1rem); overflow:auto; background:var(--surface); border:1px solid var(--line); border-top:2px solid var(--instrument); border-radius:var(--r-2); }
  .contents a { display:flex; align-items:center; min-height:44px; padding:.5rem .7rem; border-radius:var(--r-1); font:500 var(--t-1)/1.4 var(--interface); color:var(--ink); text-decoration:none; }
  .contents a:hover, .contents a[aria-current="page"] { background:var(--raised); color:var(--instrument); }
  .contents summary:hover, .contents[open] summary { color:var(--instrument); border-color:var(--instrument); background:var(--surface); }
  .mobile-main { display:none; }
  .progress { position:absolute; left:0; right:0; bottom:-1px; height:2px; background:var(--line); }
  .progress span { display:block; height:100%; background:var(--instrument); transform-origin:left; transform:scaleX(0); }
  @media(max-width:1100px) { .identity small, .crumb { display:none; } }
  @media(max-width:700px) { .primary { display:none; } .identity small { display:block; } .mobile-main { display:list-item; } }
  @media print { .sbar { display: none; } }
</style>

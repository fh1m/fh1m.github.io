---
/**
 * The bar on every page that isn't the planet: back to the planet, where you are, a reading
 * progress line, and the contents of the whole site, so nothing is more than two clicks away.
 */
interface Props { crumb?: { href: string; label: string; bn?: string }; progress?: boolean }
const { crumb, progress = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "");
const contents = [
  ["/everything", "All the work"], ["/missions/air", "Missions"], ["/notes", "Notebook"], ["/lessons", "What I got wrong"],
  ["/shoulders", "Shoulders"], ["/log", "The dated record"], ["/cv", "CV"],
];
---
<nav class="sbar" aria-label="Site">
  <a href="/" class="pill">Back to the planet</a>
  {crumb && <a href={crumb.href} class="crumb">{crumb.bn && <span class="bn" lang="bn">{crumb.bn}</span>} {crumb.label}</a>}
  <details class="contents">
    <summary class="pill ghost">Contents</summary>
    <ul>{contents.map(([href, label]) => <li><a href={href} aria-current={here === href ? "page" : undefined}>{label}</a></li>)}</ul>
  </details>
  {progress && <span class="progress" aria-hidden="true"><span id="sbar-progress"></span></span>}
</nav>
{progress && <script>
  // ClientRouter swaps pages without reloading, so look the bar up on every scroll
  const on = () => { const bar = document.getElementById("sbar-progress"); if (!bar) return; const h = document.documentElement; bar.style.transform = `scaleX(${h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight)})`; };
  addEventListener("scroll", on, { passive: true }); document.addEventListener("astro:page-load", on);
</script>}
<style>
  .sbar { position: fixed; z-index: 20; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 1rem; padding: .7rem var(--gutter); background: #0b1233; border-bottom: 1px solid rgb(255 255 255 / .06); font-family: var(--story); }
  .crumb { font: 600 var(--t-1) var(--story); color: #c9d3ff; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .crumb .bn { color: var(--c, var(--acc, #4f8fe0)); margin-right: .3rem; }
  .contents { margin-left: auto; position: relative; }
  .contents summary { list-style: none; cursor: pointer; }
  .contents summary::-webkit-details-marker { display: none; }
  .contents ul { position: absolute; right: 0; top: calc(100% + .5rem); margin: 0; padding: .5rem; list-style: none; min-width: 14rem; background: #121b4a; border: 1px solid rgb(255 255 255 / .1); border-radius: .9rem; box-shadow: 0 16px 40px rgb(0 0 0 / .4); }
  .contents a { display: block; padding: .5rem .7rem; border-radius: .6rem; font: 700 var(--t-1) var(--story); color: #dfe4ff; text-decoration: none; }
  .contents a:hover, .contents a[aria-current="page"] { background: rgb(255 255 255 / .08); color: #fff; }
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: rgb(255 255 255 / .06); }
  .progress span { display: block; height: 100%; background: var(--c, var(--acc, #4f8fe0)); transform-origin: left; transform: scaleX(0); }
  @media (max-width: 700px) { .crumb { display: none; } }
</style>

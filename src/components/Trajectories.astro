---
/**
 * Trajectories: two conceptual trajectories rendered as a self-contained
 * inline SVG. Curve A (formal education) is jagged and irregular; Curve B
 * (engineering capability) rises smoothly. The gradient area between them
 * represents the divergence. No numeric axes or tick marks.
 *
 * Draw-on enhancement via CSS scroll-driven animations (view timeline),
 * gated behind prefers-reduced-motion and @supports. Default state:
 * static full-draw (readable with JS off, reduced motion, or Firefox).
 */
---

<div class="trajectories">
  <svg
    viewBox="0 0 600 400"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Two trajectories: formal education jagged and uneven, engineering capability rising smoothly, the gap between them is where the story happens"
    class="traj-svg"
  >
    <defs>
      <linearGradient id="traj-area-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#6AB8FF" stop-opacity="0.12" />
        <stop offset="100%" stop-color="#6AB8FF" stop-opacity="0.02" />
      </linearGradient>
    </defs>

    <!-- Area between the two curves (gradient fill) -->
    <path
      class="traj-area"
      d="M 40 320 L 85 282 L 130 298 L 180 258 L 220 264 L 270 238 L 310 248 L 360 226 L 400 230 L 450 214 L 490 218 L 530 206 L 560 200 C 510 75 430 115 330 165 C 230 215 140 305 40 320 Z"
    />

    <!-- Curve A: formal education (jagged, muted stroke) -->
    <path
      class="traj-curve traj-curve-a"
      d="M 40 320 L 85 282 L 130 298 L 180 258 L 220 264 L 270 238 L 310 248 L 360 226 L 400 230 L 450 214 L 490 218 L 530 206 L 560 200"
    />

    <!-- Curve B: engineering capability (smooth, signal stroke) -->
    <path
      class="traj-curve traj-curve-b"
      d="M 40 320 C 140 305 230 215 330 165 C 430 115 510 75 560 55"
    />

    <!-- Word labels only, no numeric ticks -->
    <text class="traj-label" x="300" y="385" text-anchor="middle">TIME →</text>
    <text class="traj-label traj-label-signal" x="478" y="52" text-anchor="start">CAPABILITY ↗</text>
    <text class="traj-label" x="370" y="210" text-anchor="start">FORMAL MILESTONES</text>
  </svg>
</div>

<style>
  .trajectories {
    width: 100%;
  }

  .traj-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Curve strokes and area fill */
  .traj-curve-a {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .traj-curve-b {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .traj-area {
    fill: url(#traj-area-grad);
  }

  /* Label typography (mono uppercase with tracking, matching house style) */
  .traj-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    fill: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .traj-label-signal {
    fill: var(--signal);
  }

  /*
   * Scroll-driven draw-on enhancement.
   * Gated behind both reduced-motion and feature support.
   * Default state (outside this block): both curves fully drawn, area visible.
   * SVG stop-color for gradient is hardcoded to hex #6AB8FF (maps to the
   * signal token) because CSS custom properties are unreliable in SVG
   * gradient stops across browsers. This is the one allowed exception.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .traj-svg {
        view-timeline: --traj;
      }

      .traj-curve {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: traj-draw linear both;
        animation-timeline: --traj;
      }

      .traj-area {
        opacity: 0;
        animation: traj-reveal linear both;
        animation-timeline: --traj;
      }
    }
  }

  @keyframes traj-draw {
    from {
      stroke-dashoffset: 1000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes traj-reveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

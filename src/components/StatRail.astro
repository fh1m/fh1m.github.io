---
/**
 * StatRail — a strip of real numbers, counted up on scroll-into-view.
 *
 * Every value here is sourced, not chosen for effect: RoboSub campaign
 * count and commit count come straight from `src/content/machines/*.md`
 * frontmatter (the same facts the machine pages render); the rest match
 * the resume/README. Counting up is cosmetic — the numbers themselves are
 * unchanged by JS, so a no-JS or reduced-motion visitor sees the exact
 * same final value, just without the animation.
 */
interface Stat {
  value: number;
  suffix?: string;
  label: string;
  sub: string;
}

const STATS: Stat[] = [
  { value: 3, label: 'ROBOSUB CAMPAIGNS', sub: '2024 · 2025 · 2026' },
  { value: 795, label: 'COMMITS SHIPPED', sub: 'duburi_ws, Apr–Sep 2026' },
  { value: 7, label: 'TEAMS & LABS', sub: 'Duburi → AERD → LASSET → UE' },
  { value: 2, label: 'PUBLISHED PAPERS', sub: 'UIJIR 2024 · underwater CV 2026' },
];
---

<div class="stat-rail">
  {STATS.map((s) => (
    <div class="stat-tile">
      <p class="stat-value" data-count={s.value}>{s.value}{s.suffix ?? ''}</p>
      <p class="stat-label mono-label">{s.label}</p>
      <p class="stat-sub mono-label">{s.sub}</p>
    </div>
  ))}
</div>

<script>
  import gsap from 'gsap';

  function initStatRail(root: HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nodes = root.querySelectorAll<HTMLElement>('[data-count]');
    if (reduce || nodes.length === 0) return; // final value is already the rendered text

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          if (el.dataset.counted) return;
          el.dataset.counted = '1';
          const target = Number(el.dataset.count);
          const obj = { n: 0 };
          gsap.to(obj, {
            n: target,
            duration: 1.1,
            ease: 'power2.out',
            onUpdate: () => {
              el.textContent = String(Math.round(obj.n));
            },
          });
          io.unobserve(el);
        });
      },
      { threshold: 0.4 },
    );
    nodes.forEach((n) => {
      n.textContent = '0';
      io.observe(n);
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('.stat-rail').forEach(initStatRail);
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .stat-rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stat-tile {
    padding: var(--space-6) var(--space-4);
    display: grid;
    gap: var(--space-1);
    border-left: 1px solid var(--line);
  }

  .stat-tile:first-child {
    border-left: 0;
  }

  .stat-value {
    /* Numbers stay in mono (mongla_ws's rule) rather than the display
       face — the whole point is that a reading is data, not a headline. */
    font-family: var(--font-mono), ui-monospace, monospace;
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    color: var(--ink);
  }

  .stat-sub {
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .stat-rail {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-tile:nth-child(2) {
      border-left: 1px solid var(--line);
    }

    .stat-tile:nth-child(odd) {
      border-left: 0;
    }
  }
</style>

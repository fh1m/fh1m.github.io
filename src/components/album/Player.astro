---
/** The artefact layer behind the page and the player bar: what is playing, and its commit history. */
---
<div class="player" aria-live="polite">
  <p class="now"><span class="np-t">Point at a track, or use the arrow keys.</span></p>
  <canvas class="wave" aria-hidden="true"></canvas>
  <slot />
</div>
<style>
  .player { position: sticky; bottom: 0; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto; gap: 2rem; align-items: center; padding: 1rem 0 1.2rem; background: linear-gradient(transparent, var(--black) 40%); }
  .now { margin: 0; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wave { width: 100%; height: 36px; display: block; }
  @media (max-width: 860px) { .player { grid-template-columns: 1fr; gap: .5rem; } }
</style>

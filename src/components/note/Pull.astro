---
/** A pulled line: something the work taught, in its own words. */
interface Props { by?: string }
const { by } = Astro.props;
---
<blockquote class="pull"><p><slot /></p>{by && <footer class="src">{by}</footer>}</blockquote>
<style>
  .pull { margin: 2.6rem 0; padding: 0 0 0 1.4rem; border-left: 2px solid var(--sig, var(--measured)); max-width: 46ch; }
  .pull p { font: italic 450 var(--s2)/1.3 var(--serif); color: var(--chalk); margin: 0 0 0.5rem; }
</style>

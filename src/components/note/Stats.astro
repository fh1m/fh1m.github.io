---
/** Measured numbers in a row, each with what it measures. */
interface Props { items: { v: string; l: string; tone?: "measured" | "failure" | "medium" | "estimate" }[]; src?: string }
const { items, src } = Astro.props;
---
<div class="stats wide">
  <dl>
    {items.map((s) => (<div><dt class:list={["num", s.tone ?? "sig"]}>{s.v}</dt><dd>{s.l}</dd></div>))}
  </dl>
  {src && <p class="src">{src}</p>}
</div>
<style>
  .stats { margin: 2.4rem 0; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.2rem 2rem; margin: 0 0 0.6rem; }
  dl div { border-top: 1px solid var(--line); padding-top: 0.8rem; }
  dt { font-size: var(--s2); line-height: 1.1; }
  dt.sig { color: var(--sig, var(--measured)); }
  dd { margin: 0.35rem 0 0; font: 400 0.8rem/1.45 var(--mono); color: var(--dim); }
</style>

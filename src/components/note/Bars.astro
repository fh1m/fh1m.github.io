---
/**
 * A horizontal bar chart drawn at build time from measured numbers. No JS.
 * The accessible name lists every value, so the chart is never the only copy of the data.
 */
type Tone = "measured" | "failure" | "medium" | "estimate" | "dim";
interface Row { label: string; v: number; tone?: Tone; note?: string }
interface Props { title: string; rows: Row[]; unit?: string; max?: number; src?: string; log?: boolean }
const { title, rows, unit = "", max, src, log = false } = Astro.props;
const f = (x: number) => (log ? Math.log10(Math.max(x, 1e-9)) - Math.log10(Math.min(...rows.map((r) => r.v)) / 2) : x);
const top = max ?? Math.max(...rows.map((r) => f(r.v)));
const fmt = (v: number) => (Math.abs(v) >= 1000 ? v.toLocaleString("en-US") : String(v));
const H = 34, LW = 250, BW = 520, W = LW + BW + 150;
const colour: Record<Tone, string> = { measured: "var(--measured)", failure: "var(--failure)", medium: "var(--medium)", estimate: "var(--estimate)", dim: "var(--faint)" };
const label = `${title}. ` + rows.map((r) => `${r.label}: ${fmt(r.v)}${unit}`).join("; ");
---
<figure class="bars wide">
  <svg viewBox={`0 0 ${W} ${rows.length * H + 44}`} role="img" aria-label={label}>
    <text x="0" y="16" class="bt">{title}</text>
    {rows.map((r, i) => {
      const y = 34 + i * H;
      const w = Math.max(2, (f(r.v) / top) * BW);
      return (
        <g>
          <text x={LW - 12} y={y + 15} text-anchor="end" class="bl">{r.label}</text>
          <rect x={LW} y={y + 3} width={w} height={H - 14} rx="2" fill={colour[r.tone ?? "measured"]} opacity="0.88" />
          <text x={LW + w + 8} y={y + 15} class="bv">{fmt(r.v)}{unit}{r.note && <tspan class="bnote"> {r.note}</tspan>}</text>
        </g>
      );
    })}
  </svg>
  {src && <figcaption>{src}</figcaption>}
</figure>
<style>
  .bars svg { width: 100%; height: auto; overflow: visible; background: none; }
  .bt { font: 400 13px var(--mono); fill: var(--dim); }
  .bl { font: 400 13px var(--mono); fill: var(--chalk); }
  .bv { font: 400 13px var(--mono); fill: var(--chalk); font-variant-numeric: tabular-nums; }
  .bnote { fill: var(--faint); }
</style>

---
/**
 * The range map: the site's primary navigation. One node per arena on a
 * vertical line (desktop) or a horizontal strip (phone). Plain links, so it
 * works with no JavaScript; the client script marks the active arena.
 */
import type { Arena } from "../data/arenas";
interface Props { arenas: Arena[] }
const { arenas } = Astro.props;
---
<nav class="rangemap" aria-label="Arenas on the range">
  <ol>
    {arenas.map((a) => (
      <li class={`sig-${a.signal}`}>
        <a href={`#${a.id}`} data-map={a.n} title={`${a.n}: ${a.title}, ${a.force}`}>
          <span class="dot" aria-hidden="true"></span>
          <span class="lab"><span class="pixel">{a.bn}</span> {a.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<style>
  .rangemap { position: fixed; left: calc(var(--gutter) * 0.45); top: 50%; transform: translateY(-50%); z-index: 30; }
  ol { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 0.95rem; }
  ol::before { content: ""; position: absolute; left: 6px; top: 6px; bottom: 6px; width: 1px; background: linear-gradient(var(--line), #2a3138, var(--line)); }
  a { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; position: relative; }
  .dot { width: 13px; height: 13px; border-radius: 50%; border: 1.4px solid #3a424a; background: #000; transition: transform .25s, border-color .25s, background .25s; flex: none; }
  .lab { font: 400 0.75rem var(--mono); color: var(--dim); opacity: 0; transform: translateX(-4px); transition: opacity .2s, transform .2s; white-space: nowrap; background: rgb(0 0 0 / .7); padding: 0.1rem 0.4rem; border-radius: 3px; }
  .lab .pixel { font-family: var(--serif); color: var(--sig); }
  a:hover .lab, a:focus-visible .lab, a.active .lab { opacity: 1; transform: none; }
  a.active .dot { background: var(--sig); border-color: var(--sig); transform: scale(1.25); box-shadow: 0 0 12px var(--sig); }
  a:hover .dot { border-color: var(--sig); }
  .sig-measured { --sig: var(--measured); } .sig-failure { --sig: var(--failure); } .sig-medium { --sig: var(--medium); } .sig-estimate { --sig: var(--estimate); }
  @media (max-width: 900px) {
    .rangemap { left: 0; right: 0; top: auto; bottom: 0; transform: none; background: rgb(0 0 0 / .85); backdrop-filter: blur(6px); padding: 0.55rem var(--gutter); border-top: 1px solid var(--line); }
    ol { grid-auto-flow: column; justify-content: space-between; gap: 0; }
    ol::before { left: 6px; right: 6px; top: 50%; bottom: auto; width: auto; height: 1px; }
    .lab { display: none; }
    a { padding: 6px; }
  }
</style>

---
/**
 * ArchDiagram — bespoke hand-authored SVG node graph per machine.
 *
 * Authored for three machines only (duburi, duburi_ws, toolchain), keyed
 * by slug. Any other slug renders nothing. Conventions follow
 * Trajectories.astro: viewBox, role="img" + aria-label, rx="0",
 * shape-rendering="crispEdges", tokens only, mono labels.
 *
 * Signal budget: duburi_ws highlights the auv_manager_node (1 application,
 * below the fold). duburi and toolchain use no --signal and no --signal-amber
 * (the page's amber is reserved for the PerformanceChart peak).
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{slug === 'duburi_ws' && (
  <section class="arch-diagram" data-reveal aria-label="duburi_ws ROS2 architecture">
    <h2 class="guide-heading mono-label">ARCHITECTURE</h2>
    <svg
      class="arch-svg"
      viewBox="0 0 800 340"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="duburi_ws ROS2 architecture: auv_manager_node owns MAVLink and exposes the /duburi/move action to mission clients; YOLO11 vision, BNO085 yaw, and Nortek Nucleus 1000 DVL feed the stack; Pixhawk 2.4.8 runs ArduSub on Duburi 4.5 and Dubomini 2.0"
    >
      <defs>
        <marker
          id="arch-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 8 4 L 0 8 Z" fill="var(--line)" />
        </marker>
        <marker
          id="arch-arrow-strong"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 8 4 L 0 8 Z" fill="var(--line-strong)" />
        </marker>
      </defs>

      <!-- Row 1: software -->
      <rect class="arch-node" x="40" y="36" width="190" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="135" y="58" text-anchor="middle">YOLO11 + OC-SORT</text>
      <text class="arch-node-sub" x="135" y="76" text-anchor="middle">VISION</text>

      <rect class="arch-node arch-node-signal" x="305" y="36" width="190" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title arch-node-title-signal" x="400" y="58" text-anchor="middle">auv_manager_node</text>
      <text class="arch-node-sub arch-node-sub-signal" x="400" y="76" text-anchor="middle">/duburi/move</text>

      <rect class="arch-node" x="570" y="36" width="190" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="665" y="58" text-anchor="middle">MISSION CLIENTS</text>
      <text class="arch-node-sub" x="665" y="76" text-anchor="middle">30+ VERBS</text>

      <!-- Edges: software row -->
      <line class="arch-edge" x1="230" y1="62" x2="305" y2="62" marker-end="url(#arch-arrow)" />
      <line
        class="arch-edge-strong"
        x1="495"
        y1="62"
        x2="570"
        y2="62"
        marker-start="url(#arch-arrow-strong)"
        marker-end="url(#arch-arrow-strong)"
      />

      <!-- Row 2: hardware -->
      <rect class="arch-node" x="40" y="216" width="190" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="135" y="238" text-anchor="middle">BNO085</text>
      <text class="arch-node-sub" x="135" y="256" text-anchor="middle">YAW SOURCE</text>

      <rect class="arch-node" x="305" y="216" width="190" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="400" y="238" text-anchor="middle">PIXHAWK 2.4.8</text>
      <text class="arch-node-sub" x="400" y="256" text-anchor="middle">ARDUSUB 4.X</text>

      <rect class="arch-node" x="570" y="216" width="190" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="665" y="238" text-anchor="middle">NORTEK NUCLEUS 1000</text>
      <text class="arch-node-sub" x="665" y="256" text-anchor="middle">DVL</text>

      <!-- Edges: hardware → manager -->
      <path class="arch-edge" d="M 135 216 L 135 120 L 305 120 L 305 88" fill="none" marker-end="url(#arch-arrow)" />
      <line class="arch-edge" x1="400" y1="216" x2="400" y2="88" marker-start="url(#arch-arrow)" marker-end="url(#arch-arrow)" />
      <path class="arch-edge" d="M 665 216 L 665 120 L 495 120 L 495 88" fill="none" marker-end="url(#arch-arrow)" />

      <!-- Bottom band -->
      <line class="arch-hairline" x1="40" y1="288" x2="760" y2="288" />
      <text class="arch-caption" x="400" y="312" text-anchor="middle">JETSON ORIN NANO — DUBURI 4.5 + DUBOMINI 2.0</text>
    </svg>
  </section>
)}

{slug === 'duburi' && (
  <section class="arch-diagram" data-reveal aria-label="Duburi AUV line and RoboSub record">
    <h2 class="guide-heading mono-label">ARCHITECTURE</h2>
    <svg
      class="arch-svg"
      viewBox="0 0 800 300"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Duburi AUV line: Duburi 4.0, 4.2, 4.5 and Dubomini 2.0, with RoboSub results 2023 second, 2025 ninth, 2026 eighth with 6230 points"
    >
      <defs>
        <marker
          id="arch-arrow"
          viewBox="0 0 8 8"
          refX="7"
          refY="4"
          markerWidth="8"
          markerHeight="8"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 8 4 L 0 8 Z" fill="var(--line)" />
        </marker>
      </defs>

      <!-- Vehicle line -->
      <rect class="arch-node" x="40" y="40" width="150" height="48" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="115" y="68" text-anchor="middle">DUBURI 4.0</text>

      <rect class="arch-node" x="230" y="40" width="150" height="48" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="305" y="68" text-anchor="middle">DUBURI 4.2</text>

      <rect class="arch-node" x="420" y="40" width="150" height="48" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="495" y="68" text-anchor="middle">DUBURI 4.5</text>

      <rect class="arch-node" x="610" y="40" width="150" height="48" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="685" y="68" text-anchor="middle">DUBOMINI 2.0</text>

      <line class="arch-edge" x1="190" y1="64" x2="230" y2="64" marker-end="url(#arch-arrow)" />
      <line class="arch-edge" x1="380" y1="64" x2="420" y2="64" marker-end="url(#arch-arrow)" />
      <line class="arch-edge" x1="570" y1="64" x2="610" y2="64" marker-end="url(#arch-arrow)" />

      <!-- RoboSub record -->
      <line class="arch-hairline" x1="40" y1="140" x2="760" y2="140" />
      <text class="arch-caption" x="80" y="168" text-anchor="start">ROBOSUB RECORD</text>

      <text class="arch-year" x="80" y="196" text-anchor="start">2023</text>
      <text class="arch-result arch-result-peak" x="720" y="196" text-anchor="end">2ND</text>

      <line class="arch-hairline" x1="80" y1="212" x2="720" y2="212" />

      <text class="arch-year" x="80" y="228" text-anchor="start">2025</text>
      <text class="arch-result" x="720" y="228" text-anchor="end">9TH</text>

      <line class="arch-hairline" x1="80" y1="244" x2="720" y2="244" />

      <text class="arch-year" x="80" y="260" text-anchor="start">2026</text>
      <text class="arch-result" x="720" y="260" text-anchor="end">8TH — 6230 PTS</text>
    </svg>
  </section>
)}

{slug === 'toolchain' && (
  <section class="arch-diagram" data-reveal aria-label="Toolchain environment">
    <h2 class="guide-heading mono-label">ARCHITECTURE</h2>
    <svg
      class="arch-svg"
      viewBox="0 0 800 260"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Toolchain environment: Scripts for Arch, PDE Neovim config, and Start-Page browser dashboard — the environment as first machine"
    >
      <rect class="arch-node" x="40" y="60" width="200" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="140" y="82" text-anchor="middle">SCRIPTS</text>
      <text class="arch-node-sub" x="140" y="100" text-anchor="middle">BASH + PYTHON FOR ARCH</text>

      <rect class="arch-node" x="300" y="60" width="200" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="400" y="82" text-anchor="middle">PDE</text>
      <text class="arch-node-sub" x="400" y="100" text-anchor="middle">NEOVIM CONFIG</text>

      <rect class="arch-node" x="560" y="60" width="200" height="52" rx="0" shape-rendering="crispEdges" />
      <text class="arch-node-title" x="660" y="82" text-anchor="middle">START-PAGE</text>
      <text class="arch-node-sub" x="660" y="100" text-anchor="middle">BROWSER DASHBOARD</text>

      <line class="arch-hairline" x1="40" y1="160" x2="760" y2="160" />
      <text class="arch-caption" x="400" y="196" text-anchor="middle">THE ENVIRONMENT AS FIRST MACHINE</text>
    </svg>
  </section>
)}

<style>
  .arch-diagram {
    margin-top: var(--space-12);
  }

  .guide-heading {
    color: var(--ink-muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .arch-svg {
    width: 100%;
    height: auto;
    display: block;
    margin-top: var(--space-4);
  }

  .arch-node {
    fill: var(--surface-1);
    stroke: var(--line);
    stroke-width: 1;
  }

  .arch-node-signal {
    stroke: var(--signal);
  }

  .arch-edge {
    stroke: var(--line);
    stroke-width: 1;
  }

  .arch-edge-strong {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .arch-hairline {
    stroke: var(--line);
    stroke-width: 1;
  }

  .arch-node-title {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink);
  }

  .arch-node-title-signal {
    fill: var(--signal);
  }

  .arch-node-sub {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink-muted);
  }

  .arch-node-sub-signal {
    fill: var(--signal);
  }

  .arch-caption {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink-muted);
  }

  .arch-year {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink-muted);
  }

  .arch-result {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    fill: var(--ink);
  }

  .arch-result-peak {
    fill: var(--line-strong);
  }
</style>
---
import { ClientRouter } from "astro:transitions";
import "@fontsource/tiro-bangla/400.css";
import "../styles/global.css";
import { person } from "../data/facts";
import { elements } from "../data/elements";

interface Props { title?: string; description?: string; bodyClass?: string; nation?: string; chrome?: boolean }
const { title, description = "Fahim Faisal, an engineer from Dhaka: machines that have to work alone in water, on land, in the air and on small chips, and the commits that fixed them.", bodyClass = "", nation, chrome = true } = Astro.props;
const fullTitle = title ? `${title} | Fahim Faisal` : "Fahim Faisal";
const here = Astro.url.pathname;
const colour = elements.find((e) => e.id === nation)?.colour;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/zed-sans-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter fallback="swap" />
  </head>
  <body class={bodyClass} style={colour ? `--c:${colour}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {chrome && (
      <header class="top">
        <a class="me" href="/">Fahim Faisal</a>
        <nav aria-label="Site">
          <ul>
            {elements.map((e) => <li><a href={`/${e.id}`} style={`--c:${e.colour}`} aria-current={here.startsWith(`/${e.id}`) ? "page" : undefined}><span class="bn" lang="bn">{e.bn}</span> {e.name}</a></li>)}
            <li><a href="/lessons" aria-current={here.startsWith("/lessons") ? "page" : undefined}>Lessons</a></li>
            <li><a href="/notes" aria-current={here.startsWith("/notes") ? "page" : undefined}>Notebook</a></li>
            <li><a href="/shoulders" aria-current={here.startsWith("/shoulders") ? "page" : undefined}>Shoulders</a></li>
            <li><a href="/cv" aria-current={here.startsWith("/cv") ? "page" : undefined}>CV</a></li>
          </ul>
        </nav>
      </header>
    )}
    <slot />
    {chrome && (
      <footer class="foot">
        <a href={`mailto:${person.email}`}>{person.email}</a>
        <a href={person.github}>GitHub</a>
        {person.linkedin && <a href={person.linkedin}>LinkedIn</a>}
        <a href="/log">The dated record</a>
      </footer>
    )}
  </body>
</html>

<style>
  .top { position: relative; z-index: 5; display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding: 1.4rem var(--gutter) 0; }
  .me { font: 500 var(--t1) var(--sans); color: var(--ink-hi); text-decoration: none; white-space: nowrap; }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; margin: 0; padding: 0; }
  nav a { color: var(--dim); text-decoration: none; }
  nav a:hover { color: var(--ink-hi); }
  nav a[aria-current="page"] { color: var(--ink-hi); text-decoration: underline; text-decoration-color: var(--c, var(--ink-hi)); text-underline-offset: .35em; }
  nav .bn { font-family: var(--bangla); color: var(--c, inherit); }
  .foot { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; padding: 4rem var(--gutter) 2.4rem; }
  .foot a { color: var(--dim); }
  @media (max-width: 760px) {
    .top { flex-direction: column; gap: .6rem; }
    nav { max-width: 100%; overflow-x: auto; scrollbar-width: none; }
    nav ul { flex-wrap: nowrap; }
    nav li { flex: none; }
  }
</style>

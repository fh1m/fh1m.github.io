---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const CATEGORY_ORDER = ['underwater', 'air', 'perception', 'compute', 'systems'] as const;
const CATEGORY_LABELS: Record<string, string> = {
  underwater: 'UNDERWATER',
  air: 'AIR',
  perception: 'PERCEPTION',
  compute: 'COMPUTE',
  systems: 'SYSTEMS',
};

const STATUS_TONE: Record<string, string> = {
  running: 'accent',
  ongoing: 'accent',
  prototype: 'gray',
  closed: 'gray',
  retired: 'gray',
  failed: 'fail',
};

const machines = await getCollection('machines');

// Fixed category order, then dateStart ascending, then id for a stable tiebreak.
const ordered = [...machines].sort((a, b) => {
  const ca = CATEGORY_ORDER.indexOf(a.data.category);
  const cb = CATEGORY_ORDER.indexOf(b.data.category);
  if (ca !== cb) return ca - cb;
  if (a.data.dateStart !== b.data.dateStart) return a.data.dateStart.localeCompare(b.data.dateStart);
  return a.id.localeCompare(b.id);
});

const groups = CATEGORY_ORDER.map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  entries: ordered.filter((m) => m.data.category === category),
}));

// Newest entry = max dateStart; duburi_ws is tied for newest (2026-01) and is
// the designated candidate — prefer it among ties, id sort as fallback.
const maxDateStart = ordered.reduce(
  (max, m) => (m.data.dateStart > max ? m.data.dateStart : max),
  '0000-00',
);
const newest = ordered
  .filter((m) => m.data.dateStart === maxDateStart)
  .sort((a, b) => (a.id === 'duburi_ws' ? -1 : b.id === 'duburi_ws' ? 1 : a.id.localeCompare(b.id)))[0];
---

<Base title="MACHINES — FAHIM FAISAL">
  <section class="machines-index" data-reveal>
    <header class="index-header">
      <p class="mono-label">[03] MACHINES</p>
      <h1 class="display">MACHINES</h1>
      <p class="index-count mono-label">[REGISTRY: {machines.length} ENTRIES]</p>
    </header>

    {groups.map((group) => (
      <section class="category" data-reveal>
        <h2 class="category-header mono-label">[ {group.label} ]</h2>
        <div class="category-rows">
          {group.entries.map((entry) => {
            const tone = STATUS_TONE[entry.data.status] ?? 'gray';
            const isNewest = entry.id === newest.id;
            return (
              <a class="machine-row" href={`/machines/${entry.id}`}>
                <span class:list={['chip', `chip-${tone}`]}>{entry.data.status}</span>
                <span class="machine-name">{entry.data.name}</span>
                <span class="machine-year">{entry.data.yearLabel}</span>
                <span class="machine-summary">{entry.data.summary}</span>
                {isNewest && (
                  <span class="machine-tags mono-label">
                    {entry.data.tags.map((tag) => `[${tag}]`).join(' ')}
                  </span>
                )}
                <span class="machine-arrow" aria-hidden="true">→</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </section>

  <style>
    .machines-index {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6) var(--space-24);
    }

    .index-header {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-16);
    }

    .index-header h1 {
      font-weight: 900;
    }

    .index-count {
      color: var(--ink-muted);
    }

    .category {
      margin-top: var(--space-12);
    }

    .category-header {
      color: var(--ink);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--line);
    }

    .machine-row {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr) auto minmax(0, 1.4fr) auto;
      column-gap: var(--space-4);
      row-gap: var(--space-2);
      align-items: baseline;
      padding: var(--space-4) 0;
      border-top: 1px solid var(--line);
    }

    .chip {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      border: 1px solid currentColor;
      padding: var(--space-1) var(--space-2);
      width: fit-content;
      line-height: 1;
    }

    .chip-accent {
      color: var(--signal);
    }

    .chip-gray {
      color: var(--ink-muted);
    }

    .chip-fail {
      color: var(--signal-fail);
    }

    .machine-name {
      font-family: var(--font-display), sans-serif;
      font-weight: 700;
      font-size: var(--text-h3);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display);
      line-height: 1.1;
      transition: color var(--dur-fast) var(--ease-out);
    }

    .machine-year {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--ink-muted);
      white-space: nowrap;
    }

    .machine-summary {
      color: var(--ink-muted);
      line-height: var(--leading-body);
    }

    .machine-tags {
      grid-column: 2 / -1;
      color: var(--ink-muted);
    }

    .machine-arrow {
      font-family: var(--font-mono), ui-monospace, monospace;
      color: var(--ink-muted);
      transition:
        color var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out);
    }

    .machine-row:hover .machine-name {
      color: var(--signal);
    }

    .machine-row:hover .machine-arrow {
      color: var(--signal);
      transform: translateX(2px);
    }

    @media (max-width: 720px) {
      .machine-row {
        grid-template-columns: 1fr;
        row-gap: var(--space-1);
      }

      .machine-tags {
        grid-column: 1 / -1;
      }

      .machine-arrow {
        justify-self: end;
      }
    }
  </style>
</Base>
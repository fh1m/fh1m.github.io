---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('notebook');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Newest first — prev is the newer entry, next is the older one.
const all = (await getCollection('notebook')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const index = all.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;

const STATUS_LABEL = { open: 'OPEN', ongoing: 'ONGOING', closed: 'CLOSED' } as const;
const STATUS_CLASS = { open: 'chip-open', ongoing: 'chip-ongoing', closed: 'chip-closed' } as const;

// WHAT I WAS LEARNING axis — same slug-keyed mapping as the index page.
// Uppercase in source so the label survives text-transform-independent greps.
const THREAD_MAP: Record<string, string> = {
  'turning-a-camera-into-a-sensor': 'PERCEPTION',
  'tracking-without-detection': 'PERCEPTION',
  'low-cost-vio-and-the-dvl-question': 'ESTIMATION',
  'why-radar-doesnt-work-underwater': 'ESTIMATION',
  'the-frame-age-problem': 'INTEGRATION',
  'hardware-excavation': 'INTEGRATION',
  'opening-the-box': 'PERCEPTION',
  'from-worked-once-to-works-every-time': 'ARCHITECTURE',
};
const threadOf = (id: string): string => THREAD_MAP[id] ?? 'INTEGRATION';
---

<Base
  title={`${entry.data.title} — NOTEBOOK`}
  description={`Field log entry — ${entry.data.title}.`}
>
  <article class="entry" data-reveal>
    <div class="entry-inner">
      <header class="entry-head">
        <p class="mono-label">[NOTEBOOK] // FIELD LOG</p>
        <h1 class="entry-title">{entry.data.title}</h1>
        <div class="meta-strip">
          <span class="mono-label">[{entry.data.date}]</span>
          <span class:list={['status-chip', STATUS_CLASS[entry.data.status]]}>
            {STATUS_LABEL[entry.data.status]}
          </span>
          <span class="mono-label">{entry.data.tags.join(' / ')}</span>
          <span class="mono-label thread-label">THREAD: {threadOf(entry.id)}</span>
        </div>
      </header>

      <div class="prose" data-reveal>
        <Content />
      </div>

      <footer class="entry-foot" data-reveal>
        <a class="back-link" href="/notebook">← BACK TO LOG</a>
        <nav class="entry-nav" aria-label="Entry navigation">
          {prev && (
            <a class="nav-link" href={`/notebook/${prev.id}`}>
              <span class="mono-label">← PREV</span>
              <span class="nav-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="nav-link nav-next" href={`/notebook/${next.id}`}>
              <span class="mono-label">NEXT →</span>
              <span class="nav-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      </footer>
    </div>
  </article>

  <style>
    /* F3 FLAG: 4 raw var(--signal) refs (status chip + prose links +
       back-link + entry-nav hover = 4 applications) — verify <=3 visible
       per viewport; back-link and entry-nav sit at opposite ends. */
    .entry-inner {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--space-6);
    }

    .entry-head {
      display: grid;
      gap: var(--space-6);
      padding: var(--space-16) 0 var(--space-8);
    }

    .entry-title {
      font-family: var(--font-display), ui-monospace, monospace;
      font-weight: 700;
      font-size: var(--text-h1);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display-small);
      line-height: var(--leading-display);
    }

    .meta-strip {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: var(--space-3) 0;
    }

    .status-chip {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      padding: var(--space-1) var(--space-2);
      border: 1px solid currentColor;
    }

    .chip-open {
      color: var(--signal);
    }

    .chip-ongoing {
      color: var(--signal-ok);
    }

    .chip-closed {
      color: var(--ink-muted);
    }

    .prose {
      max-width: var(--max-width-editorial);
      display: grid;
      gap: var(--space-6);
      color: var(--ink);
      font-size: var(--text-body);
      line-height: var(--leading-body);
    }

    .prose p {
      color: var(--ink);
    }

    .prose strong {
      color: var(--ink);
      font-weight: 600;
    }

    .prose em {
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-size: 1.08em;
    }

    .prose a {
      color: var(--signal);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .prose h2 {
      font-family: var(--font-display), ui-monospace, monospace;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-display-small);
      line-height: var(--leading-display);
    }

    .prose h3 {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      line-height: var(--leading-h3);
    }

    .prose h2 {
      font-size: var(--text-h2);
    }

    .prose h3 {
      font-size: var(--text-h3);
    }

    .prose ul,
    .prose ol {
      padding-left: var(--space-6);
    }

    .prose ul {
      list-style: square;
    }

    .prose ol {
      list-style: decimal;
    }

    .prose li {
      margin-bottom: var(--space-2);
    }

    .prose blockquote {
      border-left: 1px solid var(--line);
      padding-left: var(--space-6);
      color: var(--ink-muted);
      font-style: italic;
    }

    .prose hr {
      border: 0;
      border-top: 1px solid var(--line);
      margin: var(--space-8) 0;
    }

    .prose pre {
      background: var(--surface-1);
      border: 1px solid var(--line);
      padding: var(--space-6);
      overflow-x: auto;
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-mono);
      line-height: 1.7;
      color: var(--ink);
    }

    .prose pre code {
      background: none;
      border: 0;
      padding: 0;
      font-size: inherit;
      color: inherit;
    }

    .prose :not(pre) > code {
      background: var(--surface-1);
      border: 1px solid var(--line);
      padding: 0.1em 0.35em;
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: 0.9em;
    }

    .entry-foot {
      margin-top: var(--space-24);
      border-top: 1px solid var(--line);
      padding-top: var(--space-8);
      display: grid;
      gap: var(--space-8);
    }

    .back-link {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--signal);
      width: fit-content;
    }

    .back-link:hover {
      color: var(--ink);
    }

    .entry-nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .nav-link {
      display: grid;
      gap: var(--space-2);
      border: 1px solid var(--line);
      padding: var(--space-4) var(--space-6);
    }

    .nav-link:hover {
      border-color: var(--ink-muted);
    }

    .nav-link:hover .nav-title {
      color: var(--signal);
    }

    .nav-next {
      text-align: right;
    }

    .nav-title {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      transition: color var(--dur-fast) var(--ease-out);
    }

    @media (max-width: 640px) {
      .entry-nav {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
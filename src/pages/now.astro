---
import Base from '../layouts/Base.astro';
import { PROFILE } from '../data/profile';

// Titles come from the PROFILE data module (todo 5), drafted from the
// Now-page spec. Notes are page-local copy in the site's register.
const RUN_NOTES: Record<string, string> = {
  'low-cost autonomous systems':
    'Autonomy is still priced like a research grant. The interesting work is making it cheap enough to fail in the field — and then run again.',
  'integrated vision/control boards and embedded architecture':
    'The boundary between sensing and control is where the loop actually lives. Who owns the latency decides whether the machine steers on fresh data or stale.',
  'visual navigation without expensive sensing':
    'Cameras are cheap. The expensive part is making them behave like a sensor instead of a firehose. If vision can carry navigation, the whole stack gets cheaper.',
  'AUV robustness on Duburi — the same mission, every time':
    'The benchmark is not a new trick that works once. It is the same mission working every time — in water that does not care how elegant the code looks.',
  'the Unauthorized Engineering collective':
    'Irreverent, open research, practical autonomy — young engineers building unreasonable things. The motto-spirit: whatever we built is better than it was before, far better.',
  'camera pipelines and frame timing':
    'The detector worked; the vehicle didn\u2019t. The problem was frames that were already too old for the controller — stale data steering the robot.',
};

const runs = PROFILE.obsessions.map((title) => ({ title, note: RUN_NOTES[title] }));

// Brief #39 targets. Only the last row carries a note — it is the anchor.
const NEXT_NOTES: Record<string, string> = {
  'built from Bangladesh': 'This is where the machine is being built.',
};

const nextItems = PROFILE.nextUp.map((title) => ({ title, note: NEXT_NOTES[title] }));
---

<Base
  title="NOW — CURRENT RUNS"
  description="What is running now, and what is next — obsessions, experiments, and targets."
>
  <section class="now-page" data-reveal>
    <header class="now-header">
      <p class="mono-label">[06] NOW</p>
      <h1 class="display">Now</h1>
      <p class="now-lede">
        The current build list — what is running, what is next. Obsessions,
        experiments, and the next targets, in one place.
      </p>
    </header>

    <section class="running" aria-labelledby="running-label" data-reveal>
      <p class="mono-label section-label" id="running-label">[CURRENTLY RUNNING]</p>
      <!-- [VERIFY]: UE motto-spirit line (row 5 below) — "whatever we built is better than it was before, far better" — confirm exact wording with the collective before publishing. -->
      <div class="run-rows">
        {runs.map((run) => (
          <div class="run-row">
            <span class="run-stamp mono-label">[RUN]</span>
            <div class="run-body">
              <h2 class="run-title">{run.title}</h2>
              <p class="run-note">{run.note}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="links" aria-labelledby="links-label" data-reveal>
      <p class="mono-label section-label" id="links-label">[LIVE PROJECTS]</p>
      <div class="link-rows">
        <a class="link-row" href="https://bracuduburi.com/" target="_blank" rel="noopener noreferrer">
          <span class="link-stamp mono-label">[01]</span>
          <div class="link-body">
            <h2 class="link-title">BRACU DUBURI</h2>
            <p class="link-note">The AUV team — the machine that keeps being rebuilt to perform better next time.</p>
          </div>
          <span class="link-arrow mono-label" aria-hidden="true">↗</span>
        </a>
        <a class="link-row" href="https://robosub.org/2026/07/17/robosub-2026-final-standings/" target="_blank" rel="noopener noreferrer">
          <span class="link-stamp mono-label">[02]</span>
          <div class="link-body">
            <h2 class="link-title">ROBOSUB 2026</h2>
            <p class="link-note">Final standings — 8th, 6230 points.</p>
          </div>
          <span class="link-arrow mono-label" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="next" aria-labelledby="next-label" data-reveal>
      <p class="mono-label section-label" id="next-label">[ACT IV: NEXT]</p>
      <div class="next-rows">
        {nextItems.map((item, i) => (
          <div class="next-row">
            <span class="next-index mono-label">[{String(i + 1).padStart(2, '0')}]</span>
            <div class="next-body">
              <h2 class:list={['next-title', { 'is-anchor': item.title === 'built from Bangladesh' }]}>
                {item.title}
              </h2>
              {item.note && <p class="next-note">{item.note}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer class="now-close" data-reveal>
      <p class="closing-serif">I don't know exactly what the final machine looks like yet. I know the questions that are taking me there.</p>
      <p class="closing-loop mono-label">Build. Measure. Break. Understand. Rebuild.</p>
      <p class="mono-label">[STATUS: STILL BUILDING]</p>
    </footer>
  </section>

  <style>
    .now-page {
      max-width: var(--max-width-editorial);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) var(--space-section);
      display: grid;
      gap: var(--space-16);
    }

    .now-header {
      display: grid;
      gap: var(--space-4);
    }

    .now-header h1 {
      font-weight: 900;
    }

    .now-lede {
      color: var(--ink-muted);
      max-width: 44ch;
    }

    .running,
    .next {
      display: grid;
      gap: var(--space-6);
    }

    .section-label {
      color: var(--ink-muted);
    }

    .run-rows,
    .next-rows {
      border-top: 1px solid var(--line);
    }

    .run-row {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: var(--space-6);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line);
    }

    .run-stamp {
      color: var(--ink);
      white-space: nowrap;
    }

    .run-body {
      display: grid;
      gap: var(--space-2);
    }

    .run-title,
    .next-title {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      font-size: var(--text-h3);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      line-height: var(--leading-h3);
    }

    .run-note {
      color: var(--ink-muted);
      max-width: 60ch;
    }

    .next-row {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: var(--space-6);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--line);
    }

    .next-index {
      color: var(--ink-muted);
      white-space: nowrap;
    }

    .next-body {
      display: grid;
      gap: var(--space-2);
    }

    .next-title.is-anchor {
      color: var(--signal);
    }

    .next-note {
      color: var(--ink-muted);
      max-width: 60ch;
    }

    .links {
      display: grid;
      gap: var(--space-6);
    }

    .link-rows {
      border-top: 1px solid var(--line);
    }

    .link-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      gap: var(--space-6);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line);
    }

    .link-stamp {
      color: var(--ink);
      white-space: nowrap;
    }

    .link-body {
      display: grid;
      gap: var(--space-2);
    }

    .link-title {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      font-size: var(--text-h3);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      line-height: var(--leading-h3);
    }

    .link-note {
      color: var(--ink-muted);
      max-width: 60ch;
    }

    .link-arrow {
      color: var(--ink-muted);
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .link-row:hover .link-arrow {
      color: var(--signal);
      transform: translate(2px, -2px);
    }

    .now-close {
      display: grid;
      gap: var(--space-4);
      padding-top: var(--space-8);
      border-top: 1px solid var(--line);
    }

    .closing-serif {
      font-family: var(--font-body), sans-serif;
      font-style: italic;
      font-size: var(--text-quote);
      color: var(--ink);
      max-width: 52ch;
    }

    .closing-loop {
      color: var(--ink-muted);
    }

    @media (max-width: 720px) {
      .run-row,
      .next-row {
        gap: var(--space-4);
      }
    }
  </style>
</Base>
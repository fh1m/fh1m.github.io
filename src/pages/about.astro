---
import Base from '../layouts/Base.astro';
import StackDescent from '../components/StackDescent.astro';
import Trajectories from '../components/Trajectories.astro';

// --- CHAPTER TIMELINE DATA ---
// 8 chapters (WHAT I BUILT) + 8 transition questions + terminal [NEXT].
// Evidence: AERD (real-world-aerd.md), Duburi (real-world-duburi.md),
// persona arc (real-world-persona.md). [VERIFY] markers only on new v2 claims.
const CHAPTERS = [
  {
    id: '01',
    built: 'AERD / ROCKETS',
    question: 'How do machines move?',
    verify: '[VERIFY]',
    sources: [
      {
        label: 'THE DAILY STAR',
        url: 'https://www.thedailystar.net/campus/news/first-hybrid-rocket-engine-bangladesh-tested-successfully-3418016',
      },
    ],
  },
  {
    id: '02',
    built: 'DUBURI / ROBOSUB 2024',
    question: 'How does a machine see?',
    sources: [
      { label: 'BRACU DUBURI', url: 'https://bracuduburi.com/' },
      {
        label: 'ROBOSUB 2026',
        url: 'https://robosub.org/2026/07/17/robosub-2026-final-standings/',
      },
    ],
  },
  { id: '03', built: 'MACHINE VISION', question: 'How do you know the map is true?' },
  { id: '04', built: '2025 SUBTEAM LEAD', question: 'How do subsystems agree?' },
  { id: '05', built: 'ARCHITECTURE', question: 'Where should intelligence live?' },
  { id: '06', built: 'ROBOSUB 2026 / ENGINEERING LEAD', question: 'How do I make the whole machine reliable?' },
  { id: '07', built: 'MONGOL TORI', question: 'What should I build if I control the architecture?', verify: '[VERIFY]' },
  { id: '08', built: 'INDEPENDENT SYSTEMS / UE', question: 'What happens when nobody is watching?', verify: '[VERIFY]' },
];

// WHAT I WAS LEARNING — horizontal thread axis (one per chapter).
const THREADS = [
  'motion',
  'perception',
  'estimation',
  'integration',
  'leadership',
  'architecture',
  'autonomy',
  'independence',
];

// --- THE LOOP ---
const LOOP_STEPS = ['Build', 'Observe', 'Fail', 'Understand', 'Rebuild'];

// --- MANIFESTO (verbatim — brief #46, plan line 63) ---
const MANIFESTO = [
  'I like machines that have to deal with reality.',
  'I like understanding what sits beneath the abstraction.',
  'I like taking expensive or opaque systems apart conceptually and rebuilding them from first principles.',
  'I like robotics because there is nowhere to hide: eventually the machine has to move.',
  'I like software because it lets an idea become behavior.',
  'I like hardware because physics gets the final vote.',
  'I like open source because knowledge should compound.',
  'I like difficult problems because they expose what I don\u2019t understand.',
  'And I am still building.',
];

// --- CONTRADICTIONS (brief #64, plan line 67) ---
const CONTRADICTIONS = [
  {
    left: 'AMBITIOUS',
    leftNote: 'the machine should do more than it was asked',
    right: 'INSECURE',
    rightNote: 'the fear that it is not enough',
  },
  {
    left: 'SOPHISTICATED SYSTEMS',
    leftNote: 'estimation, control, perception working together',
    right: 'HATES UNNECESSARY COMPLEXITY',
    rightNote: 'the simplest thing that survives contact with reality',
  },
  {
    left: 'HARDWARE-LEVEL',
    leftNote: 'registers, interrupts, the physical layer',
    right: 'HIGH-LEVEL',
    rightNote: 'behavior, intent, the whole system',
  },
  {
    left: 'OPEN SOURCE',
    leftNote: 'knowledge should compound',
    right: 'PROPRIETARY-GRADE SERIOUSNESS',
    rightNote: 'the work is held to a production standard',
  },
  {
    left: 'TECHNICALLY SERIOUS',
    leftNote: 'the engineering is not a joke',
    right: 'ABSURD HUMOR',
    rightNote: 'the jokes are',
  },
  {
    left: 'FAILURE',
    leftNote: 'the detector worked, the vehicle didn\u2019t',
    right: 'GROWING AMBITION',
    rightNote: 'each failure raised the ceiling',
  },
];

// --- INFLUENCES (brief #20, restrained) ---
// Each `quote` is verbatim and sourced — not a paraphrase standing in for a
// real quote. Exact wording and citation checked against the primary source
// before this went in; see the comment on each row.
const INFLUENCES = [
  {
    name: 'GEORGE HOTZ',
    borrow: 'the willingness to open the box and rebuild it — first principles over received wisdom',
    // Verbatim, Lex Fridman Podcast #387, 29 Jun 2023, 2h06m05s.
    quote: '“If there’s two great evils in the world, it’s centralization and complexity.”',
    quoteSource: 'Lex Fridman Podcast #387, 2023',
  },
  {
    name: 'ANDREJ KARPATHY',
    borrow: 'the discipline of teaching from the bottom up — mechanisms, not magic',
    // Verbatim, from his own post — the line this repo's whole ethos ("what
    // is happening underneath the abstraction") is downstream of.
    quote: '“Neural net training is a leaky abstraction.”',
    quoteSource: '"A Recipe for Training Neural Networks", 2019',
  },
  {
    name: 'COMMA.AI',
    borrow: 'the calibration mindset — took their public calib_challenge myself; repo below',
    quote: '“make driving chill”',
    quoteSource: 'comma.ai, current tagline',
    repo: { owner: 'fh1m', name: 'calib_challenge_fh1m' },
  },
  {
    name: 'ERIC S. RAYMOND',
    borrow: 'the habit of publishing the work so knowledge compounds',
    // Correcting an earlier draft that credited this to "the open-source
    // community" in the abstract — the line has an actual author.
    quote: '“Given enough eyeballs, all bugs are shallow.”',
    quoteSource: '"The Cathedral and the Bazaar", 1997 (Linus’s Law)',
  },
];
---

<Base
  title="FAHIM FAISAL — ABOUT"
  description="The machine and the person behind it — the descent, the loop, the contradictions, the manifesto."
>
  <!-- ============================================================
       HERO — deep-characterization statement from v1,
       framed by "then the questions became harder" (continuity-story.md 59).
       ============================================================ -->
  <!-- [VERIFY]: brief #65 deep-characterization drafted from the approved signature lines (plan line 62); confirm wording before publishing. -->
  <section class="about-hero" data-reveal>
    <p class="mono-label">ABOUT</p>
    <h1 class="display about-h1">
      Most of my work starts with a question about what is happening underneath the abstraction.
    </h1>
    <p class="hero-sub">The path was non-linear. The questions became harder. The engineering became increasingly serious.</p>
    <p class="hero-body">
      Fahim Faisal builds machines that perceive the world and act inside it.
      He works across robotics, computer vision, embedded systems, control, and AI —
      usually starting from a simple question: what is actually happening underneath?
    </p>
  </section>

  <!-- ============================================================
       THE TIMELINE — Pattern A: vertical center hairline
       (sticky, scroll-progress fill — CSS enhancement, static default).
       8 chapters as alternating-column nodes with semantic <ol>/<li>/<article>.
       Question interstitials own the center column (serif italic).
       ============================================================ -->
  <section class="about-section timeline-section" data-reveal>
    <header class="section-head">
      <h2>THE TIMELINE</h2>
    </header>
    <p class="section-intro">Each chapter built on the previous one. Then the questions became harder.</p>

    <div class="timeline">
      <div class="timeline-line" aria-hidden="true"></div>
      <ol class="timeline-list">
        {CHAPTERS.map((ch, i) => (
          <>
            <li class="timeline-item timeline-chapter" data-type="chapter">
              <article class="chapter">
                <div class="chapter-content">
                  <p class="chapter-id mono-label">[{ch.id}]</p>
                  <h3 class="chapter-heading">{ch.built}</h3>
                  {ch.verify && <span class="verify-tag mono-label">{ch.verify}</span>}
                  {ch.sources && (
                    <div class="chapter-sources">
                      {ch.sources.map((s) => (
                        <a class="chapter-source mono-label" href={s.url} target="_blank" rel="noopener noreferrer">
                          {s.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
                <div class="chapter-thread">
                  <span class="thread-label mono-label">LEARNING: {THREADS[i]}</span>
                </div>
              </article>
            </li>
            <li class="timeline-item timeline-question" data-type="question">
              <p class="question-text">{ch.question}</p>
            </li>
          </>
        ))}
        <li class="timeline-item timeline-terminal" data-type="terminal">
          <span class="terminal-marker mono-label">[NEXT]</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================================================
       THE TWO TRAJECTORIES — essay preamble + component + reflection.
       "I was falling behind in one graph while moving forward in another"
       (continuity-story.md 37).
       ============================================================ -->
  <!-- [VERIFY]: university story drafted from brief #61 framing (plan line 66); confirm details. Now folded into the trajectories essay. -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[03]</span>
      <h2>THE TWO TRAJECTORIES</h2>
    </header>
    <p class="editorial">
      There were periods when the formal path did not look clean. University transitions,
      imperfect grades, the sense of running late while other people's robots were already in the water.
      I was falling behind in one graph while moving forward in another.
    </p>
    <Trajectories />
    <p class="editorial">
      The two paths did not move at the same speed. But the engineering trajectory was becoming
      clearer — more difficult problems, broader scope, heavier responsibility. The machine
      was being built at a different pace than the résumé, and the machine was what mattered.
    </p>
  </section>

  <!-- ============================================================
       THE DESCENT — StackDescent interactive (v1 about component).
       Placed under the timeline as the "understand" artifact.
       ============================================================ -->
  <!-- [VERIFY]: descent item lists drafted from brief #3 layer titles and site themes; confirm items. -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[04]</span>
      <h2>THE DESCENT</h2>
    </header>
    <p class="section-intro">Five layers, from intent down to the world. The descent is the default mode.</p>
    <StackDescent />
  </section>

  <!-- ============================================================
       THE LOOP — compact loop/spiral motif.
       "Each project is one loop at a deeper level" (continuity-story.md 51).
       Static under reduced motion.
       ============================================================ -->
  <!-- [VERIFY]: loop node notes drafted from brief #45 sequence; confirm wording. -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[05]</span>
      <h2>THE LOOP</h2>
    </header>
    <div class="loop-wrap">
      <!-- Compact spiral SVG — one visual cycle representing the loop motif -->
      <svg
        class="loop-spiral"
        viewBox="0 0 48 48"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Loop spiral: each project cycles through build, observe, fail, understand, rebuild at a deeper level"
      >
        <path
          d="M 24 24
             C 24 14 34 14 34 24
             C 34 34 22 36 22 24
             C 22 10 38 10 38 24
             C 38 40 18 42 18 24
             C 18 6 42 4 42 24"
          fill="none"
          stroke="var(--line)"
          stroke-width="1"
          stroke-linecap="square"
        />
        <circle cx="24" cy="24" r="1.5" fill="var(--line)" />
      </svg>
      <ol class="loop-steps">
        {LOOP_STEPS.map((step) => (
          <li class="loop-step">{step}</li>
        ))}
      </ol>
    </div>
    <p class="loop-caption">Each project is one loop at a deeper level.</p>
  </section>

  <!-- ============================================================
       CONTRADICTIONS — 6 pairs (verbatim data, plan line 67).
       ============================================================ -->
  <!-- [VERIFY]: contradiction descriptors drafted from brief #64 pairs (plan line 67); confirm wording. -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[06]</span>
      <h2>CONTRADICTIONS</h2>
    </header>
    <p class="section-intro">Six pairs that are all true at once.</p>
    <div class="contradictions">
      {CONTRADICTIONS.map((pair) => (
        <div class="contradiction-row">
          <div class="pole">
            <span class="pole-label">{pair.left}</span>
            <span class="pole-note">{pair.leftNote}</span>
          </div>
          <div class="pole">
            <span class="pole-label">{pair.right}</span>
            <span class="pole-note">{pair.rightNote}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       MANIFESTO — verbatim, grep-assertable.
       ============================================================ -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[07]</span>
      <h2>MANIFESTO</h2>
    </header>
    <div class="manifesto">
      {MANIFESTO.map((line, i) => (
        <p class="manifesto-line" data-reveal>
          <span class="manifesto-prefix mono-label">[M]</span>
          <span class:list={['manifesto-text', { 'manifesto-final': i === MANIFESTO.length - 1 }]}>
            {line}
          </span>
        </p>
      ))}
    </div>
  </section>

  <!-- ============================================================
       BANGLADESH — brief #62 (plan line 69).
       ============================================================ -->
  <!-- [VERIFY]: Bangladesh passage drafted from brief #62 (plan line 69); confirm wording. -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[08]</span>
      <h2>BANGLADESH</h2>
    </header>
    <p class="editorial">
      Dhaka, Bangladesh. This is where the machine is being built. The tools are the same; the constraints
      are different. The work does not wait for a different address.
    </p>
  </section>

  <!-- ============================================================
       INFLUENCES — brief #20, restrained.
       ============================================================ -->
  <!-- [VERIFY]: influence borrow-lines drafted from brief #20 (plan todo 9); confirm wording. -->
  <section class="about-section" data-reveal>
    <header class="section-head">
      <span class="mono-label num">[09]</span>
      <h2>INFLUENCES</h2>
    </header>
    <p class="section-intro">Not idols — sources. What I borrow is the approach: idea, implementation, working system.</p>
    <div class="influences">
      {INFLUENCES.map((influence) => (
        <div class="influence-row">
          <span class="influence-name">{influence.name}</span>
          <div class="influence-body">
            <p class="influence-quote">
              {influence.quote}
              <span class="influence-quote-source mono-label">— {influence.quoteSource}</span>
            </p>
            <span class="influence-borrow">{influence.borrow}</span>
            {influence.repo && (
              <a
                class="influence-repo-link mono-label"
                href={`https://github.com/${influence.repo.owner}/${influence.repo.name}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {influence.repo.owner}/{influence.repo.name} ↗
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       CLOSE — [STATUS: STILL BUILDING]
       ============================================================ -->
  <footer class="about-close" data-reveal>
    <p class="status-line">[STATUS: STILL BUILDING]</p>
  </footer>

  <style>
    /* ============================================================
       HERO — statement pages open at 96px (learnings: v1 task 17 fix).
       ============================================================ */
    .about-hero {
      display: grid;
      gap: var(--space-6);
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) 0;
    }

    .about-h1 {
      font-size: var(--text-h1);
      font-weight: 700;
      max-width: 24ch;
    }

    .hero-sub {
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-size: var(--text-h3);
      color: var(--ink);
    }

    .hero-body {
      color: var(--ink-muted);
      max-width: var(--max-width-editorial);
    }

    /* ============================================================
       SECTIONS (shared)
       ============================================================ */
    .about-section {
      display: grid;
      gap: var(--space-8);
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) 0;
      /* Below-fold sections: skip off-screen rendering (NOT the hero). */
      content-visibility: auto;
      contain-intrinsic-size: 0 500px;
    }

    .section-head {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      border-top: 1px solid var(--line);
      padding-top: var(--space-6);
    }

    .section-head h2 {
      font-family: var(--font-display), ui-monospace, monospace;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-display-small);
      font-size: var(--text-h2);
    }

    .section-intro {
      color: var(--ink-muted);
      max-width: var(--max-width-editorial);
    }

    .editorial {
      color: var(--ink);
      max-width: var(--max-width-editorial);
    }

    /* ============================================================
       TIMELINE — Pattern A: vertical center hairline with alternating nodes.
       Static default: hairline fully visible (scroll-progress fill is CSS
       enhancement added in todo 11 via @supports).
       ============================================================ */
    .timeline {
      position: relative;
      max-width: 900px;
    }

    .timeline-list {
      list-style: none;
    }

    /* Center hairline — 1px vertical rule, full height */
    .timeline-line {
      position: absolute;
      top: 0;
      left: 50%;
      width: 1px;
      height: 100%;
      background: var(--line);
      transform: translateX(-50%);
      z-index: 0;
    }

    /* Scroll-progress fill — scaleY driven by --line-fill (GSAP fallback in
       motion.ts) or the CSS scroll-driven animation in scroll.css.
       Static default: fully visible (fill only hides while a scrub drives it). */
    .timeline-line::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--line-strong);
      transform: scaleY(var(--line-fill, 1));
      transform-origin: top;
    }

    /* Base item — chapter rows have enough space for alternating layout */
    .timeline-item {
      position: relative;
      z-index: 1;
    }

    .timeline-chapter {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-8);
      padding: var(--space-8) 0;
    }

    /* Alternating column placement.
       List pattern: chapter(1) question(2) chapter(3) question(4) ...
       Chapters sit at 4n+1 (left) and 4n+3 (right). */
    .timeline-chapter:nth-child(4n+1) .chapter-content {
      grid-column: 1;
      text-align: right;
    }
    .timeline-chapter:nth-child(4n+1) .chapter-thread {
      grid-column: 3;
      text-align: left;
    }

    .timeline-chapter:nth-child(4n+3) .chapter-content {
      grid-column: 3;
      text-align: left;
    }
    .timeline-chapter:nth-child(4n+3) .chapter-thread {
      grid-column: 1;
      text-align: right;
    }

    .chapter {
      display: contents;
    }

    .chapter-heading {
      font-family: var(--font-display), ui-monospace, monospace;
      font-weight: 700;
      font-size: clamp(2rem, 2.5vw, 2.375rem);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display-small);
      margin-top: var(--space-2);
    }

    .chapter-id {
      color: var(--ink-muted);
    }

    .verify-tag {
      color: var(--line-strong);
      margin-top: var(--space-2);
      display: block;
    }

    .chapter-sources {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-3);
    }

    .chapter-source {
      color: var(--ink-muted);
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
      line-height: 1;
      width: fit-content;
    }

    .chapter-source:hover {
      color: var(--ink);
      border-color: var(--ink-muted);
    }

    /* Thread label — horizontal axis (mono, muted, not signal) */
    .thread-label {
      display: inline-block;
      margin-top: var(--space-3);
      color: var(--ink-muted);
    }

    /* Question interstitials — center column, serif italic */
    .timeline-question {
      padding: var(--space-12) var(--space-8);
      text-align: center;
    }

    .question-text {
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-size: var(--text-h3);
      color: var(--ink);
    }

    /* Terminal node */
    .timeline-terminal {
      padding: var(--space-8) 0;
      text-align: center;
    }

    .terminal-marker {
      color: var(--signal);
    }

    /* ============================================================
       THE LOOP — compact spiral motif
       ============================================================ */
    .loop-wrap {
      display: flex;
      align-items: center;
      gap: var(--space-6);
    }

    .loop-spiral {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }

    .loop-steps {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      list-style: none;
    }

    .loop-step {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      font-size: var(--text-mono);
    }

    .loop-step + .loop-step::before {
      content: '→ ';
      color: var(--ink-muted);
      font-weight: 400;
    }

    .loop-caption {
      font-family: var(--font-serif), serif;
      font-style: italic;
      color: var(--ink-muted);
      margin-top: var(--space-4);
    }

    /* ============================================================
       CONTRADICTIONS
       ============================================================ */
    .contradictions {
      display: grid;
    }

    .contradiction-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-top: 1px solid var(--line);
    }

    .pole {
      display: grid;
      gap: var(--space-2);
      padding: var(--space-6);
    }

    .pole + .pole {
      border-left: 1px solid var(--line);
    }

    .pole-label {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      font-size: var(--text-h3);
    }

    .pole-note {
      color: var(--ink-muted);
    }

    /* ============================================================
       MANIFESTO
       ============================================================ */
    .manifesto {
      display: grid;
      gap: var(--space-4);
    }

    .manifesto-line {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }

    .manifesto-prefix {
      color: var(--ink-muted);
    }

    .manifesto-text {
      font-size: var(--text-h3);
      line-height: 1.4;
    }

    .manifesto-final {
      font-family: var(--font-serif), serif;
      font-style: italic;
      color: var(--signal);
    }

    /* ============================================================
       INFLUENCES
       ============================================================ */
    .influences {
      display: grid;
    }

    .influence-row {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-6);
      padding: var(--space-6) 0;
      border-top: 1px solid var(--line);
      align-items: baseline;
    }

    .influence-name {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--ink);
    }

    .influence-body {
      display: grid;
      gap: var(--space-2);
    }

    .influence-quote {
      font-family: Georgia, 'Times New Roman', serif;
      font-style: italic;
      font-size: var(--text-h3);
      line-height: 1.4;
      color: var(--ink);
      border-left: 2px solid var(--signal-2);
      padding-left: var(--space-3);
    }

    .influence-quote-source {
      display: block;
      margin-top: var(--space-1);
      font-style: normal;
      color: var(--ink-muted);
    }

    .influence-borrow {
      color: var(--ink-muted);
    }

    .influence-repo-link {
      color: var(--signal);
      width: fit-content;
    }

    /* ============================================================
       CLOSE
       ============================================================ */
    .about-close {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) 0;
      border-top: 1px solid var(--line);
      /* Below-fold footer: skip off-screen rendering. */
      content-visibility: auto;
      contain-intrinsic-size: 0 500px;
    }

    .status-line {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--signal);
    }

    /* ============================================================
       MOBILE — stack timeline alternating layout to left-aligned.
       ============================================================ */
    @media (max-width: 768px) {
      .timeline-chapter {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-2);
        padding: var(--space-8) 0 var(--space-8) var(--space-8);
      }

      .timeline-line {
        left: 0;
        transform: none;
      }

      .timeline-chapter:nth-child(4n+1) .chapter-content,
      .timeline-chapter:nth-child(4n+3) .chapter-content {
        grid-column: 1;
        text-align: left;
      }

      .timeline-chapter:nth-child(4n+1) .chapter-thread,
      .timeline-chapter:nth-child(4n+3) .chapter-thread {
        grid-column: 1;
        text-align: left;
      }

      .timeline-question {
        padding: var(--space-8) var(--space-6);
        padding-left: var(--space-8);
        text-align: left;
      }

      .loop-wrap {
        flex-direction: column;
        align-items: flex-start;
      }

      .loop-steps {

        gap: var(--space-3);
      }

      .contradiction-row {
        grid-template-columns: 1fr;
      }

      .pole + .pole {
        border-left: 0;
        border-top: 1px solid var(--line);
      }

      .influence-row {
        grid-template-columns: 1fr;
        gap: var(--space-2);
      }
    }
  </style>

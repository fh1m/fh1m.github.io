---
import Base from "../layouts/Base.astro";
import { voices, beliefs } from "../data/influences";
const home = [
  { name: "Jagadish Chandra Bose", where: "born in Mymensingh, 1858", did: "Worked with millimetre waves in 1895, a radio receiver before radio had a name." },
  { name: "Satyendra Nath Bose", where: "Dhaka University, 1924", did: "Bose statistics. Every boson carries his name." },
  { name: "Fazlur Rahman Khan", where: "born in Dhaka, 1929", did: "The tube structure: how a skyscraper stands up to the wind." },
  { name: "Jamilur Reza Choudhury", where: "born in Sylhet, 1943", did: "Chaired the expert panels for the Jamuna and Padma bridges, and ran BUET's computer centre." },
];
---
<Base title="Shoulders" description="The beliefs the work taught me, and the people whose ideas changed a decision in it.">
  <main id="main" class="screens">
    <header class="screen">
      <div class="measure">
        <h1 class="s-h1">Shoulders</h1>
        <p class="s-dek">What the work taught me, in rules I still follow, and the people whose ideas changed a decision in it. The quote is theirs; what it changed is mine.</p>
      </div>
    </header>

    <section class="screen" aria-labelledby="h-b">
      <h2 class="s-h2" id="h-b">What the work taught me</h2>
      <ul class="cols beliefs">{beliefs.map((b) => <li><p class="s-big sm">{b.line}</p><p class="s-meta">From {b.from}</p></li>)}</ul>
    </section>

    <section class="screen" aria-labelledby="h-v">
      <h2 class="s-h2" id="h-v">Ideas that changed a decision</h2>
      <ul class="cols">
        {voices.map((v) => (
          <li>
            <p class="q">{v.paraphrase ? "Roughly: " : ""}“{v.line}”</p>
            <p class="s-meta">{v.href ? <a href={v.href}>{v.name}</a> : v.name}, {v.source}</p>
            <p class="ch">{v.changed}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="screen" aria-labelledby="h-h">
      <h2 class="s-h2" id="h-h">Closer to home</h2>
      <ul class="cols">{home.map((h) => <li><p class="q nm">{h.name}</p><p class="s-meta">{h.where}</p><p class="ch">{h.did}</p></li>)}</ul>
    </section>
  </main>
</Base>
<style>
  .cols { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 2.6rem 3.4rem; }
  .cols p { margin: 0 0 .4rem; }
  .sm { font-size: clamp(1.15rem, 1.7vw, 1.45rem) !important; }
  .q { font: 500 var(--t1)/1.45 var(--sans); color: #fff; }
  .nm { font-weight: 600; }
  .ch { font: 400 var(--t0)/1.6 var(--sans); color: #e2e2e2; }
</style>

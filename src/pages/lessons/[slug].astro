---
/** One lesson learned, NASA-style, as a sequence of screens: what happened, the belief, the truth, next time. */
import Base from "../../layouts/Base.astro";
import { lessons, type Lesson } from "../../data/lessons";
import { projects, elementById } from "../../data/elements";
export const getStaticPaths = () => lessons.map((l, i) => ({ params: { slug: l.slug }, props: { l, prev: lessons[i - 1] ?? null, next: lessons[i + 1] ?? null } }));
const { l, prev, next } = Astro.props as { l: Lesson; prev: Lesson | null; next: Lesson | null };
const el = elementById[l.element];
const proj = projects.find((p) => p.slug === l.project);
const when = new Date(l.date + (l.date.length === 7 ? "-01" : "")).toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---
<Base title={l.title} nation={l.element} description={l.lesson} crumb={{ href: "/lessons", label: "What I got wrong", bn: el.bn }} progress>
  <main id="main" class="screens">
    <header class="screen">
      <div class="measure">
        <p class="s-kicker"><span class="bn" lang="bn">{el.bn}</span>{proj ? <a href={`/projects/${proj.slug}`}>{proj.title}</a> : el.name}, {when}</p>
        <h1 class="s-h1">{l.title}</h1>
        <p class="s-dek">{l.lesson}</p>
      </div>
    </header>
    <section class="screen short"><div class="measure"><p class="s-label">What happened</p><p class="s-big">{l.driving}</p></div></section>
    <section class="screen short"><div class="measure"><p class="s-label">What I believed</p><p class="s-big"><span class="s-struck">{l.believed}</span></p></div></section>
    <section class="screen short"><div class="measure"><p class="s-label">What was true</p><p class="s-big">{l.truth}</p></div></section>
    <section class="screen short">
      <div class="measure">
        <p class="s-label">Next time</p>
        <p class="s-big">{l.recommendation}</p>
        <p class="s-meta ev">Evidence: {l.refs.map((r, k) => <>{k > 0 && ", "}<a class:list={{ h: r.href.includes("/commit/") }} href={r.href}>{r.label}</a></>)}</p>
      </div>
    </section>
    <nav class="screen short moves" aria-label="More lessons">
      <div class="measure row">
        {prev && <a class="pill ghost" href={`/lessons/${prev.slug}`}>Previous: {prev.title}</a>}
        {next && <a class="pill" href={`/lessons/${next.slug}`}>Next: {next.title}</a>}
      </div>
    </nav>
  </main>
</Base>
<style>
  .s-kicker a { color: inherit; }
  .ev { margin-top: 2rem; }
  .h { font-family: var(--mono); }
  .row { display: flex; flex-wrap: wrap; gap: .7rem; }
</style>

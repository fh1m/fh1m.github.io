---
import Base from "../../layouts/Base.astro";
import { lessons, type Lesson } from "../../data/lessons";
import { projects, elementById } from "../../data/elements";
export const getStaticPaths = () => lessons.map((l, i) => ({ params: { slug: l.slug }, props: { l, prev: lessons[i - 1] ?? null, next: lessons[i + 1] ?? null } }));
const { l, prev, next } = Astro.props as { l: Lesson; prev: Lesson | null; next: Lesson | null };
const el = elementById[l.element];
const proj = projects.find((p) => p.slug === l.project);
---
<Base title={l.title} nation={l.element} description={l.lesson}>
  <main id="main" class="lesson">
    <p class="from"><a href="/lessons">What I got wrong</a>{proj && <>, from <a href={`/projects/${proj.slug}`}>{proj.title}</a></>}</p>
    <h1>{l.title}</h1>
    <dl>
      <dt>What happened</dt><dd>{l.driving}</dd>
      <dt>What I believed</dt><dd><span class="wrong">{l.believed}</span></dd>
      <dt>What was true</dt><dd class="true">{l.truth}</dd>
      <dt>The lesson</dt><dd class="lesson-line">{l.lesson}</dd>
      <dt>Next time</dt><dd>{l.recommendation}</dd>
      <dt>Evidence</dt><dd>{l.refs.map((r, k) => <>{k > 0 && ", "}<a class:list={{ h: r.href.includes("/commit/") }} href={r.href}>{r.label}</a></>)}</dd>
    </dl>
    {l.voice && <blockquote><p>“{l.voice.line}”</p><footer>{l.voice.who}</footer></blockquote>}
    <nav class="pn" aria-label="More lessons">
      {prev ? <a href={`/lessons/${prev.slug}`}>Previous: {prev.title}</a> : <span />}
      {next && <a href={`/lessons/${next.slug}`}>Next: {next.title}</a>}
    </nav>
  </main>
</Base>
<style>
  .lesson { padding: 3rem clamp(1.4rem, 5vw, 5rem) 0; max-width: 56rem; }
  .from { color: var(--dim); margin: 0 0 1rem; }
  h1 { font: 500 var(--t5)/1.05 var(--sans); margin: 0 0 2.4rem; max-width: 20ch; }
  dl { display: grid; grid-template-columns: 11rem 1fr; gap: 1.2rem 2rem; margin: 0 0 2.4rem; }
  dt { color: var(--c); }
  dd { margin: 0; max-width: 62ch; }
  .true { color: var(--ink-hi); }
  .lesson-line { font-size: var(--t2); line-height: 1.35; color: var(--ink-hi); }
  .h { font-family: var(--mono); }
  blockquote { margin: 0 0 2.4rem; }
  blockquote p { font-size: var(--t1); font-style: italic; margin: 0 0 .3rem; }
  blockquote footer { color: var(--dim); }
  .pn { display: flex; justify-content: space-between; gap: 2rem; padding-top: 1.4rem; }
  .pn a { color: var(--dim); }
  @media (max-width: 700px) { dl { grid-template-columns: 1fr; gap: .2rem; } dd { margin-bottom: 1rem; } }
</style>

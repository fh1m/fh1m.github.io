---
import Base from "../../layouts/Base.astro";
import { lessons } from "../../data/lessons";
import { elements, projects } from "../../data/elements";
const title = (slug: string) => projects.find((p) => p.slug === slug)?.title ?? slug;
---
<Base title="What I got wrong" description="Sixteen things I believed about machines that turned out to be false, what was true instead, and the commit that fixed each one.">
  <main id="main" class="lessons">
    <header>
      <h1>What I got wrong</h1>
      <p>Sixteen things I believed that turned out to be false. Each one is written the way NASA files a lesson learned: what happened, what we believed, what was true, and what to do next time. Each one links to the commit that fixed it.</p>
    </header>
    {elements.map((el) => {
      const ll = lessons.filter((l) => l.element === el.id);
      return ll.length > 0 && (
        <section style={`--c:${el.colour}`} aria-labelledby={`h-${el.id}`}>
          <h2 id={`h-${el.id}`}><span class="bn" lang="bn">{el.bn}</span> {el.name}</h2>
          <ul>
            {ll.map((l) => (
              <li>
                <a href={`/lessons/${l.slug}`}>{l.title}</a>
                <span class="wrong">{l.believed}</span>
                <span class="where">{title(l.project)}, {new Date(l.date + (l.date.length === 7 ? "-01" : "")).toLocaleDateString("en-GB", { month: "long", year: "numeric" })}</span>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </main>
</Base>
<style>
  .lessons { padding: 3rem clamp(1.4rem, 5vw, 5rem) 0; max-width: 52rem; }
  h1 { font: 500 var(--t5)/1.05 var(--sans); margin: 0 0 1rem; }
  header p { color: var(--dim); max-width: 58ch; margin-bottom: 3rem; }
  h2 { font: 500 var(--t2) var(--sans); color: var(--c); margin: 0 0 1rem; }
  .bn { font-family: var(--bangla); font-weight: 400; }
  section { margin-bottom: 3rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }
  li { display: grid; gap: .2rem; }
  li > a { font-size: var(--t1); text-decoration: none; color: var(--ink-hi); }
  li > a:hover { text-decoration: underline; text-decoration-color: var(--c); }
  .where { color: var(--faint); font-size: var(--t-1); }
</style>

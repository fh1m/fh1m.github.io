---
/** Every lesson learned, one screen per element: the beliefs, struck through, each linking to its lesson. */
import Base from "../../layouts/Base.astro";
import { lessons } from "../../data/lessons";
import { elements, projects } from "../../data/elements";
const title = (slug: string) => projects.find((p) => p.slug === slug)?.title ?? slug;
---
<Base title="What I got wrong" description={`${lessons.length} things I believed about machines that turned out to be false, what was true instead, and the commit that fixed each one.`}>
  <main id="main" class="screens">
    <header class="screen">
      <div class="measure">
        <h1 class="s-h1">What I got wrong</h1>
        <p class="s-dek">{lessons.length} things I believed that turned out to be false. Each is filed the way NASA files a lesson learned: what happened, what was believed, what was true, what to do next time, and the commit that fixed it.</p>
      </div>
    </header>
    {elements.map((el) => {
      const ll = lessons.filter((l) => l.element === el.id);
      return ll.length > 0 && (
        <section class="screen" style={`--c:${el.colour}`} aria-labelledby={`h-${el.id}`}>
          <h2 class="s-h2" id={`h-${el.id}`}><span class="bn" lang="bn">{el.bn}</span> {el.name}</h2>
          <ul class="wall">
            {ll.map((l) => (
              <li>
                <a href={`/lessons/${l.slug}`}>
                  <span class="t">{l.title}</span>
                  <span class="s-struck b">{l.believed}</span>
                  <span class="s-meta">{title(l.project)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </main>
</Base>
<style>
  .bn { color: var(--c); margin-right: .4rem; }
  .wall { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: 2.4rem 3rem; }
  .wall a { display: grid; gap: .5rem; text-decoration: none; }
  .t { font:600 var(--t1)/1.3 var(--display); color:var(--ink-hi); }
  .t::after { content:" →"; color:var(--action); }
  .b { font: 400 var(--t0)/1.5 var(--sans); }
  .wall a:is(:hover,:focus-visible) .t { color:var(--action); }
</style>

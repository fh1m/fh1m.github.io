---
import Base from "../layouts/Base.astro";
import { chapters } from "../data/story";
import stats from "../data/github.json";
import mongla from "../data/mongla.json";

const repos = [...stats.repos].filter((r) => r.name !== "fh1m").sort((a, b) => b.pushedAt.localeCompare(a.pushedAt));
const water = mongla.water.events;
const chapterHref: Record<string, string> = { source: "/notes", sky: "/projects/aerd", water: "/projects/duburi", cat: "/projects/e-bhapa", ground: "/projects/mongol-tori", current: "/water", mongla: "/projects/mongla", dristy: "/projects/dristy", rupsha: "/projects/rupsha", den: "/projects/den", mohona: "/" };
const statusLabel: Record<string, string> = { HISTORICAL_WATER: "in water, earlier vehicle", RECORDED_WATER_REPLAY: "real footage, replayed", CURRENT_WATER: "in water, this platform", NOT_YET: "not yet" };
---
<Base title="Log" description="The dated record: every project, every repository, and every time a vehicle in this lineage was actually in water." world={{ layer: "all", side: "left", dist: 6 }}>
  <main id="main" class="log">
    <header>
      <p class="kick"><span class="bn">লগ</span> <span class="mono">the log · rebuilt {stats.generatedAtLabel}</span></p>
      <h1>The dated record.</h1>
      <p class="lede">The notebook, flattened into dates. Then the numbers, generated at build time from the public GitHub API and from Mongla's own snapshot at commit <code>{mongla.provenance.commit.slice(0, 7)}</code>, so nothing here is typed by hand.</p>
    </header>

    <section aria-labelledby="h-time">
      <h2 id="h-time">In order</h2>
      <ol class="timeline">
        {chapters.map((c) => (
          <li class={`d-${c.domain}`}>
            <span class="when mono">{c.when}</span>
            <span class="dot" aria-hidden="true"></span>
            <a href={chapterHref[c.id] ?? "/notes"}><span class="bn">{c.bn}</span> <b>{c.title}</b></a>
            <span class="lesson">{c.lesson}</span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-water" class="d-water">
      <h2 id="h-water">Every time a vehicle in this lineage was in water</h2>
      <p class="dim">From <a href="https://github.com/fh1m/mongla_ws/blob/main/docs/evidence/water.json">water.json</a> in mongla_ws: the project's own ledger of water contact, with evidence for each row.</p>
      <table>
        <thead><tr><th>when</th><th>where</th><th>status</th><th>what happened</th></tr></thead>
        <tbody>{water.map((e) => <tr><td class="num">{e.date}</td><td>{e.place}</td><td><span class:list={["st", e.status === "NOT_YET" ? "no" : "yes"]}>{statusLabel[e.status] ?? e.status}</span></td><td>{e.observed}</td></tr>)}</tbody>
      </table>
    </section>

    <section aria-labelledby="h-gh" class="d-sight">
      <h2 id="h-gh">The last year, from GitHub</h2>
      <dl class="nums">
        <div><dt class="num">{stats.contributionsLastYear.toLocaleString("en-US")}</dt><dd>public contributions, last 12 months</dd></div>
        <div><dt class="num">{stats.commitsLastYear.toLocaleString("en-US")}</dt><dd>of them commits</dd></div>
        <div><dt class="num">{stats.publicRepos}</dt><dd>public repositories</dd></div>
        <div><dt class="num">{mongla.provenance.commits.toLocaleString("en-US")}</dt><dd>commits on Mongla since {mongla.provenance.firstCommit.slice(0, 10)}</dd></div>
      </dl>
      <aside class="bench" aria-label="Bench: the flight recorder">
        <h3><span class="tag">bench</span> The flight recorder</h3>
        <div class="bench-body" data-bench="recorder"><p class="mono">Loading the bench…</p></div>
      </aside>
    </section>

    <section aria-labelledby="h-repos">
      <h2 id="h-repos">Every public repository</h2>
      <ul class="repos">
        {repos.map((r) => (
          <li>
            <a href={r.url}><b>{r.name}</b></a>
            <span class="lang mono"><i style={`background:${r.color ?? "#555"}`}></i>{r.language ?? "—"}{r.archived && " · archived"}</span>
            <p>{r.description}</p>
            <span class="mono dim">last push {r.pushedAt.slice(0, 10)}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<script>
  const bus = new EventTarget();
  const el = document.querySelector<HTMLElement>('[data-bench="recorder"]');
  if (el) new IntersectionObserver(([e], io) => { if (!e.isIntersecting) return; io.disconnect(); import("../benches/recorder").then((m) => { el.replaceChildren(); m.mount(el, bus); el.dataset.ready = "1"; }); }, { rootMargin: "400px" }).observe(el);
</script>

<style>
  .log { position: relative; z-index: 1; width: min(64rem, calc(100% - 2 * var(--gutter))); margin: 4.6rem var(--gutter) 3rem auto; padding: 2rem 2.2rem 2.4rem; background: rgb(3 6 14 / .9); backdrop-filter: blur(12px); border: 1px solid var(--line); }
  .kick { display: flex; gap: .8rem; align-items: baseline; margin: 0 0 .5rem; }
  .kick .bn { color: var(--blue); font-family: var(--bangla); }
  .kick .mono { color: var(--dim); font-size: var(--t-2); }
  h1 { font: 500 var(--t5) var(--sans); color: var(--ink-hi); margin: 0 0 .6rem; }
  .lede { color: var(--ink); max-width: 62ch; }
  h2 { font: 400 var(--t-1) var(--mono); text-transform: uppercase; letter-spacing: .12em; color: var(--dim); margin: 2.4rem 0 .8rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .timeline { list-style: none; margin: .8rem 0 0; padding: 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 9.6rem; top: .4rem; bottom: .4rem; width: 1px; background: var(--line-2); }
  .timeline li { display: grid; grid-template-columns: 8.6rem 2rem 1fr; gap: .2rem 0; align-items: baseline; padding: .45rem 0; }
  .when { color: var(--dim); text-align: right; padding-right: 1rem; font-size: var(--t-2); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--blue); justify-self: center; transform: translateY(-1px); }
  .timeline a { text-decoration: none; color: var(--ink-hi); }
  .timeline a .bn { color: var(--blue); margin-right: .3rem; font-family: var(--bangla); }
  .timeline .lesson { grid-column: 3; font-style: italic; color: var(--ink); font-size: var(--t-1); }
  .dim { color: var(--dim); }
  td:nth-child(4) { font-size: var(--t-1); color: var(--ink); min-width: 20rem; }
  .st { font: 400 var(--t-2) var(--mono); padding: .05rem .4rem; border: 1px solid var(--line-2); white-space: nowrap; }
  .st.yes { color: var(--blue); border-color: var(--blue); }
  .st.no { color: var(--red); border-color: var(--red); }
  .nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1px; margin: .8rem 0 1.6rem; background: var(--line); border: 1px solid var(--line); }
  .nums div { background: rgb(3 6 14 / .95); padding: .7rem .8rem; }
  .nums dt { font: 400 var(--t3) var(--mono); color: var(--ink-hi); line-height: 1.1; }
  .nums dd { margin: .25rem 0 0; color: var(--dim); font-size: var(--t-2); }
  .bench { border: 1px solid var(--line); padding: 1rem 1.1rem 1.2rem; }
  .bench h3 { font: 500 var(--t1) var(--sans); display: flex; gap: .6rem; align-items: center; color: var(--ink-hi); }
  .tag { font: 400 var(--t-2) var(--mono); color: var(--dim); border: 1px solid var(--line-2); padding: .05rem .4rem; }
  .repos { list-style: none; padding: 0; margin: .8rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: .6rem; }
  .repos li { border: 1px solid var(--line); padding: .8rem .9rem; display: grid; gap: .3rem; transition: border-color .2s; }
  .repos li:hover { border-color: var(--blue); }
  .repos a { text-decoration: none; color: var(--ink-hi); }
  .repos p { margin: 0; font-size: var(--t-1); color: var(--ink); }
  .lang { color: var(--dim); display: inline-flex; gap: .4rem; align-items: center; font-size: var(--t-2); }
  .lang i { width: .55rem; height: .55rem; border-radius: 50%; display: inline-block; }
  @media (max-width: 700px) {
    .timeline::before { left: .45rem; }
    .timeline li { grid-template-columns: 1.6rem 1fr; }
    .when { grid-column: 2; text-align: left; padding: 0; order: -1; }
    .dot { grid-row: 1 / span 3; grid-column: 1; }
    .timeline a, .timeline .lesson { grid-column: 2; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

// Phase sequence is the canonical order (brief #48 timeline). The log
// collection has a year tie at 2026 (Systems Engineer + Independent Builder),
// so sorting by year would tie-break wrong. Sort by phase sequence explicitly.
const PHASE_ORDER = [
  'Student',
  'Builder',
  'Vision Engineer',
  'Technical Lead',
  'Systems Engineer',
  'Independent Builder',
] as const;

const entries = (await getCollection('log')).sort(
  (a, b) => PHASE_ORDER.indexOf(a.data.phase) - PHASE_ORDER.indexOf(b.data.phase),
);

const rendered = await Promise.all(entries.map((entry) => render(entry)));
const nodes = entries.map((entry, i) => ({ entry, Content: rendered[i].Content }));
---

<Base
  title="LOG — MISSION TIMELINE"
  description="Six phases of transformation — from student to independent builder."
>
  <section class="log-page" data-reveal>
    <header class="log-header">
      <p class="mono-label">[MISSION LOG]</p>
      <h1 class="display">Log</h1>
      <p class="log-lede">
        Six phases of the same question — what is happening underneath the abstraction.
        The emphasis is transformation, not achievements.
      </p>
    </header>

    <ol class="timeline">
      {/* ── ACT I — MOVE ──────────────────────────────── */}
      <li class="timeline-item act-header" style="--i: 0">
        <span class="act-label mono-label">ACT I — MOVE</span>
        <span class="act-arc">Student → Builder</span>
      </li>

      {nodes.filter(n => n.entry.data.act === 'move').map(({ entry, Content }, i) => (
        <li class="timeline-item phase-node" style={`--i: ${i + 1}`}>
          <div class="phase-body">
            <div class="phase-meta">
              <span class="phase-stamp mono-label">[t+{entry.data.year}]</span>
              <span class="phase-badge">{entry.data.phaseLabel}</span>
            </div>
            <h2 class="phase-title">{entry.data.title}</h2>
            <div class="phase-narrative"><Content /></div>
          </div>
        </li>
      ))}

      {/* ── Interstitial ──────────────────────────────── */}
      <li class="timeline-item act-question" style="--i: 3">
        How does a machine see?
      </li>

      {/* ── ACT II — UNDERSTAND ───────────────────────── */}
      <li class="timeline-item act-header" style="--i: 4">
        <span class="act-label mono-label">ACT II — UNDERSTAND</span>
        <span class="act-arc">Vision Engineer → Technical Lead</span>
      </li>

      {nodes.filter(n => n.entry.data.act === 'understand').map(({ entry, Content }, i) => (
        <li class="timeline-item phase-node" style={`--i: ${i + 5}`}>
          <div class="phase-body">
            <div class="phase-meta">
              <span class="phase-stamp mono-label">[t+{entry.data.year}]</span>
              <span class="phase-badge">{entry.data.phaseLabel}</span>
            </div>
            <h2 class="phase-title">{entry.data.title}</h2>
            <div class="phase-narrative"><Content /></div>
          </div>
        </li>
      ))}

      {/* ── Interstitial ──────────────────────────────── */}
      <li class="timeline-item act-question" style="--i: 7">
        How do I make the whole machine reliable?
      </li>

      {/* ── ACT III — DECIDE ──────────────────────────── */}
      <li class="timeline-item act-header" style="--i: 8">
        <span class="act-label mono-label">ACT III — DECIDE</span>
        <span class="act-arc">Systems Engineer → Independent Builder</span>
      </li>

      {nodes.filter(n => n.entry.data.act === 'decide').map(({ entry, Content }, i) => (
        <li class="timeline-item phase-node" style={`--i: ${i + 9}`}>
          <div class="phase-body">
            <div class="phase-meta">
              <span class="phase-stamp mono-label">[t+{entry.data.year}]</span>
              <span class="phase-badge">{entry.data.phaseLabel}</span>
            </div>
            <h2 class="phase-title">{entry.data.title}</h2>
            <div class="phase-narrative"><Content /></div>
          </div>
        </li>
      ))}

      {/* ── Interstitial (before open Act IV) ─────────── */}
      <li class="timeline-item act-question" style="--i: 10">
        What happens when nobody is watching?
      </li>

      {/* ── Phase 06 — Open Act IV ────────────────────── */}
      {nodes.filter(n => n.entry.data.act === 'next').map(({ entry, Content }) => (
        <li class="timeline-item phase-node phase-open" style="--i: 11">
          <div class="phase-body">
            <div class="phase-meta">
              <span class="phase-stamp mono-label">[t+{entry.data.year}]</span>
              <span class="phase-badge">{entry.data.phaseLabel}</span>
            </div>
            <h2 class="phase-title">{entry.data.title}</h2>
            <div class="phase-narrative"><Content /></div>
          </div>
        </li>
      ))}

      {/* ── Terminal [CONTINUES] node ──────────────────── */}
      <li class="timeline-item phase-node continues" style="--i: 12">
        <div class="phase-body">
          <div class="phase-meta">
            <span class="phase-stamp mono-label">[t+now]</span>
            <span class="phase-badge">OPEN</span>
          </div>
          <h2 class="phase-title"><a href="/now">Continues</a></h2>
          <p class="phase-narrative">The next act is open — the machine is still being built.</p>
          <a class="continues-link" href="/now">[CONTINUES] → /now</a>
        </div>
      </li>
    </ol>
  </section>

  <style>
    /* F3 FLAG: 4 raw var(--signal) refs (phase-title hover + continues-link
       CTA base+hover = 2 applications) — verify <=3 visible. */
    .log-page {
      max-width: var(--max-width-editorial);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) var(--space-section);
      display: grid;
      gap: var(--space-12);
    }

    .log-header {
      display: grid;
      gap: var(--space-4);
    }

    .log-header h1 {
      font-weight: 900;
    }

    .log-lede {
      color: var(--ink-muted);
      max-width: 44ch;
    }

    .timeline {
      position: relative;
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-12);
      /* Below-fold timeline: skip off-screen rendering. */
      content-visibility: auto;
      contain-intrinsic-size: 0 500px;
    }

    /* Static hairline rail connecting the nodes. */
    .timeline::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 1px;
      background: var(--line);
    }

    /* Hairline fill — scroll-progress scrub (CSS scroll-driven in scroll.css,
       GSAP fallback in motion.ts). Static default: fully visible. */
    .timeline::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: 100%;
      background: var(--line-strong);
      transform: scaleY(var(--log-fill, 1));
      transform-origin: top;
    }

    @media (prefers-reduced-motion: no-preference) {
      .timeline-item {
        animation: node-rise var(--dur-slow) var(--ease-out) both;
        animation-delay: calc(var(--i, 0) * 90ms);
      }
    }

    @keyframes node-rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ── Act headers ──────────────────────────────── */
    .act-header {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      padding-left: var(--space-8);
      flex-wrap: wrap;
    }

    .act-label {
      color: var(--ink);
      font-size: var(--text-label);
    }

    .act-arc {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--ink-muted);
    }

    /* ── Question interstitials ───────────────────── */
    .act-question {
      font-family: var(--font-body), sans-serif;
      font-style: italic;
      font-size: var(--text-quote);
      color: var(--ink-muted);
      padding-left: var(--space-8);
      max-width: 48ch;
    }

    /* ── Phase nodes (shared) ─────────────────────── */
    .timeline-item {
      position: relative;
    }

    .phase-node {
      padding-left: var(--space-8);
    }

    /* Node dot centered on the rail. */
    .phase-node::before {
      content: '';
      position: absolute;
      left: -3px;
      top: var(--space-2);
      width: 7px;
      height: 7px;
      background: var(--surface-0);
      border: 1px solid var(--line);
    }

    .phase-node.continues::before {
      border-color: var(--signal-ok);
      background: var(--signal-ok);
    }

    .phase-body {
      display: grid;
      gap: var(--space-3);
    }

    .phase-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .phase-stamp {
      color: var(--ink);
    }

    .phase-badge {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--ink-muted);
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
    }

    .phase-title {
      font-family: var(--font-display), ui-monospace, monospace;
      font-weight: 700;
      font-size: var(--text-h2);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display-small);
      line-height: var(--leading-h2);
    }

    .phase-title a:hover {
      color: var(--signal);
    }

    .phase-narrative {
      color: var(--ink-muted);
      max-width: 60ch;
    }

    .continues-link {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--signal);
      border: 1px solid var(--line);
      padding: var(--space-2) var(--space-3);
      width: fit-content;
    }

    .continues-link:hover {
      color: var(--surface-0);
      background: var(--signal);
      border-color: var(--signal);
    }
  </style>
</Base>

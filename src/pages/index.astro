---
/**
 * Home: the fh1m system. A star (me), four worlds (the four places a machine can fail) with their
 * projects as moons, a belt of wrong ideas, stations for the notes, the CV and time, and the pale
 * blue dot at the edge. Bunnu flies a small ship to whatever you open and tells you what happened.
 * Everything is also reachable from the index on the left, so nobody gets lost.
 */
import Base from "../layouts/Base.astro";
import Opening from "../components/game/Opening.astro";
import Panels from "../components/game/Panels.astro";
import { ZONE_INFO } from "../game/zones";
import { PLANETS, MOONS, STATIONS, ROCKS, HOME, PROBE } from "../space/system";
const keys: Record<string, string> = { air: "1", water: "2", earth: "3", fire: "4" };
const moonsOf = (z: string) => MOONS.filter((m) => m.parent === z);
const labelIds = [{ id: "fh1m", label: "Fahim Faisal", cls: "star" }, ...PLANETS.map((p) => ({ id: p.id, label: p.label, cls: "planet", zone: p.zone })), ...MOONS.map((m) => ({ id: m.id, label: m.label, cls: "moon" })), ...STATIONS.map((s) => ({ id: s.id, label: s.label, cls: "station" })), { id: HOME.id, label: "Home", cls: "station" }, { id: PROBE.id, label: "Voyager 1", cls: "station" }];
---
<Base chrome={false} bodyClass="game" description="Fahim Faisal, robotics engineer from Dhaka: underwater vehicles, rockets, rovers and vision on small chips, laid out as a solar system you can fly through. Every project has the failure that taught something and the commit that fixed it.">
  <main id="main" class="game-shell landing">
    <img class="poster-img" src="/world/poster.webp" alt="The fh1m system from above: a star, four worlds on their orbits, a ringed gas giant, a belt of rocks, and stations. Every body is listed in the index." width="1600" height="1000" />
    <canvas id="world" aria-label="The fh1m system: a star, four worlds with their projects as moons, a belt of lessons, and stations. Every body is also listed in the index."></canvas>
    <div class="labels" id="labels" aria-hidden="true">
      {labelIds.map((l) => <button type="button" hidden tabindex="-1" class:list={["lbl", l.cls]} data-lbl={l.id} {...("zone" in l && l.zone ? { "data-zone":l.zone } : { "data-focus":l.id })}>{l.label}</button>)}
    </div>

    <div class="left">
    <header class="intro" id="intro">
      <div class="nameplate">
        <h1><button type="button" data-focus="fh1m">Fahim <span class="surname">Faisal</span></button></h1>
        <details class="rick">
          <summary aria-label="A grumpy Rick has something to say" title="A mildly judgemental guest. Click for his advice."><img src="/media/space/rick-perched.svg" width="110" height="155" alt="" /></summary>
          <aside class="rick-note"><q>To live is to risk it all.</q><cite>Rick Sanchez · <a href="https://mygeekwisdom.com/2023/11/18/to-live-is-to-risk-it-all-otherwise-youre-just-an-inert-chunk-of-randomly-assembled-molecules-drifting-wherever-the-universe-blows-you/">Rickmancing the Stone, S3 E2</a></cite><p>For me: a web internship in 2021, rockets, underwater robots, a rover arm—and a fresh start at UIU in 2026. Keep the old work. Learn from it. Keep going.</p></aside>
        </details>
      </div>
      <p class="hello" lang="bn">আসেন, একটু ঘুরে দেখেন।</p>
      <p>I'm Fahim, from Dhaka. I write code, build robots, and occasionally discover that the robot understood the code better than I did.</p>
      <p>It started with a web internship in 2021. Then rockets, underwater vehicles, a rover arm and small vision chips. The work changed; the habit of taking things apart stayed.</p>
      <nav class="cta" aria-label="Choose a route"><a class="pill ghost" href="/log"><span class="route-number" aria-hidden="true">01 /</span> Read my story</a><button class="pill" id="explore" type="button"><span aria-hidden="true">↗</span> Explore the observatory</button><a class="pill ghost" href="/about"><span class="route-number" aria-hidden="true">02 /</span> See my work</a></nav>
      <a class="opening-link" href="/?intro">A view from Voyager</a>
    </header>


    <nav class="index" id="index" aria-label="Everything in the system">
      <details>
        <summary>Find a place</summary>
        <label class="find"><span class="sr-only">Find</span><input id="find" type="search" placeholder="Find a project, a lesson…" autocomplete="off" /></label>
        <p class="map-note">Schematic models. Open a project for the actual hardware, code and evidence.</p>
        <ol class="tree">
          <li><button type="button" data-focus="fh1m">The star: about me</button></li>
          {PLANETS.map((p) => (
            <li class="world" style={`--c:${ZONE_INFO.find((z) => z.id === p.zone)!.colour}`}>
              <button type="button" data-zone={p.zone} class="wl">{p.label}</button>
              <ol>{moonsOf(p.id).map((m) => <li><button type="button" data-focus={m.id}>{m.label}</button></li>)}</ol>
            </li>
          ))}
          <li class="world" style="--c:#a7a39a"><button type="button" data-focus="graveyard" class="wl">The belt: what I got wrong</button>
            <ol>{ROCKS.map((r) => <li><button type="button" data-focus={r.id}>{r.label}</button></li>)}</ol>
          </li>
          {STATIONS.map((s) => <li><button type="button" data-focus={s.id}>{s.label}</button></li>)}
          <li><button type="button" data-focus="home">Home: the pale blue dot</button></li>
          <li><button type="button" data-focus="voyager">Voyager 1</button></li>
        </ol>
      </details>
    </nav>
    </div>

    <nav class="zones" id="zones" aria-label="Worlds">
      {ZONE_INFO.map((z) => <button type="button" data-zone={z.id} style={`--c:${z.colour}`} aria-keyshortcuts={keys[z.id]}><span class="n">{PLANETS.find((p) => p.id === z.id)!.label}</span><span class="bn" lang="bn">{z.bn}</span></button>)}
      <button type="button" data-zone="" class="all" aria-keyshortcuts="0">The whole system</button>
    </nav>

    {ZONE_INFO.map((z) => (
      <aside class="plate" data-plate={z.id} style={`--c:${z.colour}`} aria-labelledby={`plate-${z.id}`}>
        <p class="kicker"><span class="bn" lang="bn">{z.bn}</span> {PLANETS.find((p) => p.id === z.id)!.label}</p>
        <h2 id={`plate-${z.id}`}>{z.form}</h2>
        <p class="pline">{z.line}</p>
        <dl>{z.specs.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
        <p class="real">{z.real} <a href={z.source.href}>{z.source.label}</a></p>
        <div class="mission" data-mission-box={z.id}><p class="mission-row"><button type="button" class="start" data-mission={z.id}>Try the mission</button></p></div>
        <p class="things-h">Moons of this world</p>
        <ul class="things">{moonsOf(z.id).map((m) => <li><button type="button" data-focus={m.id}>{m.label}</button></li>)}</ul>
      </aside>
    ))}

<Panels />
    <p class="guide" id="guide" aria-live="polite"><span class="who">Bunnu</span> <span id="guide-say"></span><small id="guide-source"></small></p>
    <p class="tip" id="tip" aria-hidden="true"></p>

    <div class="hud">
      <a class="snd" href="/about">Work</a>
      <button class="snd" id="bunnu-toggle" type="button" aria-pressed="false"><svg class="cat-face" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 10V3l6 4h4l6-4v7c4 11-20 11-16 0Z"/><path d="M8 12h1m6 0h1m-5 3 1 1 1-1M2 14l5 1m10 0 5-1"/></svg><span class="bunnu-label">Bunnu · cat: off</span></button>
      <button id="bunnu-story" class="snd" type="button" aria-label="Another story from Bunnu" hidden>Story</button>
      <button class="snd" id="snd" type="button" aria-pressed="true" title="Toggle sound"><span aria-hidden="true" class="sound-symbol">♪</span><span class="sr-only">Sound</span></button>
    </div>

    <Opening />
    <noscript><p class="nojs">The planet needs JavaScript. <a href="/everything">Here is everything without it.</a></p></noscript>
  </main>
</Base>
<script>
  import { createSound } from "../game/audio";
  import { MISSIONS } from "../game/missions";
  import { ANECDOTES } from "../data/anecdotes";
  import "../scripts/live-stats";
  import { startPoster, wantsPoster } from "../game/poster";
  const sfx = createSound(); sfx.scene("space");
  // the 3D planet, or (reduced motion, low-end, no WebGL2, ?poster) a still of it with the same UI on top
  const poster = wantsPoster();
  if (poster) document.getElementById("main")!.classList.add("poster");
  // the engine (three.js) loads after the page has painted, so the opening photo comes first
  const afterLoad = () => new Promise<void>((r) => (document.readyState === "complete" ? r() : addEventListener("load", () => r(), { once: true })));
  const worldP = poster ? Promise.resolve(startPoster()) : afterLoad().then(() => import("../space/engine")).then((m) => m.start(document.getElementById("world") as HTMLCanvasElement));
  const opening = document.getElementById("opening")!;
  const beats = [...opening.querySelectorAll<HTMLElement>(".beat")];
  const title = document.getElementById("intro")!, zonesEl = document.getElementById("zones")!;
  let i = -1, timer = 0, done = false;

  const show = (n: number) => {
    i = n; opening.dataset.beat = String(n);
    if (n === 3) sfx.shutter(); else if (n > 0) sfx.pluck(520 + n * 40);
    beats.forEach((b, k) => b.classList.toggle("on", k === n));
    clearTimeout(timer); timer = window.setTimeout(next, n === 4 ? 6500 : 5200);
  };
  const finish = async () => {
    if (done) return; done = true; clearTimeout(timer);
    opening.classList.add("gone"); setTimeout(() => opening.remove(), 1300);
    title.classList.add("on");
    const shell = document.getElementById("main")!;
    const explore = document.getElementById("explore") as HTMLButtonElement;
    const indexDetails = document.querySelector<HTMLDetailsElement>("#index details")!;
    const closeIndex = () => { indexDetails.open = false; };
    const enterObservatory = async () => {
      if (shell.classList.contains("exploring")) return;
      explore.disabled = true;
      explore.setAttribute("aria-busy", "true");
      await worldP;
      shell.classList.remove("landing"); shell.classList.add("exploring");
      zonesEl.classList.add("on"); document.getElementById("index")!.classList.add("on");
      explore.removeAttribute("aria-busy");
      document.querySelector<HTMLElement>("#index summary")?.focus();
      greet();
    };
    explore.addEventListener("click", enterObservatory);
    const world = await worldP; world.fallIn();
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("button[data-zone]")];
    const go = (z: string) => { closeIndex(); world.go((z || null) as never); };
    buttons.forEach((b) => b.addEventListener("click", () => go(b.dataset.zone ?? "")));
    const plates = [...document.querySelectorAll<HTMLElement>(".plate")];
    const panels = [...document.querySelectorAll<HTMLElement>(".objpanel")];
    const tip = document.getElementById("tip")!;
    const names: Record<string, string> = Object.fromEntries(panels.map((p) => [p.dataset.obj!, p.querySelector("h2")!.textContent!]));
    let current: string | null = null;
    const closePanel = () => {
      if (!panels.some(p => p.classList.contains("on"))) return;
      panels.forEach(p => p.classList.remove("on")); world.setYear(null); world.go((current || null) as never);
      const nextFocus = shell.classList.contains("exploring")
        ? zonesEl.querySelector<HTMLButtonElement>(`button[data-zone="${current ?? ""}"]`) : explore;
      nextFocus?.focus({ preventScroll: true });
    };
    world.onObject(id => {
      closeIndex(); plates.forEach(p => p.classList.remove("on"));
      const selected = panels.find(p => p.dataset.obj === id);
      if (selected?.dataset.domain) current = selected.dataset.domain;
      if (selected) history.replaceState(null, "", `#${id}`);
      buttons.forEach(b => b.setAttribute("aria-pressed", String((b.dataset.zone || null) === current)));
      panels.forEach(p => {
        p.classList.toggle("on", p === selected);
        if (p === selected) p.querySelectorAll<HTMLImageElement>("img[data-src]").forEach(im => { im.src = im.dataset.src!; im.removeAttribute("data-src"); });
      });
      selected?.querySelector<HTMLElement>(".close")?.focus({ preventScroll: true });
    });
    world.onHover((id, x, y) => { tip.textContent = id ? names[id] ?? "" : ""; tip.classList.toggle("on", !!id); tip.style.transform = `translate(${x + 16}px, ${y + 14}px)`; });
    document.querySelectorAll<HTMLButtonElement>("[data-focus]").forEach((b) => b.addEventListener("click", async () => { await enterObservatory(); world.focus(b.dataset.focus!); }));
    panels.forEach((p) => p.querySelector(".close")!.addEventListener("click", closePanel));
    addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (indexDetails.open) { closeIndex(); indexDetails.querySelector("summary")?.focus(); }
      else closePanel();
    });
    // Bunnu narrates (a caption, not a chat); missions run inside the zone's own plate
    const guide = document.getElementById("guide")!, gsay = document.getElementById("guide-say")!;
    let hideGuide = 0;
    const clearGuide = () => { clearTimeout(hideGuide); guide.classList.remove("on"); };
    const companion = document.getElementById("bunnu-toggle")!;
    let companionOn = localStorage.getItem("bunnu-enabled") === "1";
    const visited = new Set<string>(JSON.parse(localStorage.getItem("bunnu-visited") || "[]"));
    const storyButton = document.getElementById("bunnu-story") as HTMLButtonElement;
    const syncCompanion = () => { companion.setAttribute("aria-pressed", String(companionOn)); companion.querySelector(".bunnu-label")!.textContent = `Bunnu · cat: ${companionOn ? "on" : "off"}`; storyButton.hidden = !companionOn; };
    syncCompanion();
    companion.addEventListener("click", () => {
      companionOn = !companionOn; localStorage.setItem("bunnu-enabled", companionOn ? "1" : "0"); syncCompanion();
      if (companionOn) speak(visited.size ? `Welcome back. We've visited ${visited.size} places together. Want another story? Click my ship.` : "I'm Bunnu, the cat. He built the robots; I supervised from the desk. Pick a world. I'll keep the notes.");
      else clearGuide();
    });
    world.onObject((id) => { clearGuide(); visited.add(id); localStorage.setItem("bunnu-visited", JSON.stringify([...visited])); });
    const speak = (text: string, source = "") => {
      if (!companionOn || !shell.classList.contains("exploring")) return;
      document.getElementById("guide-source")!.textContent = source ? `From: ${source}` : "";
      gsay.textContent = text; guide.classList.remove("on"); void guide.offsetWidth; guide.classList.add("on");
      clearTimeout(hideGuide); hideGuide = window.setTimeout(() => guide.classList.remove("on"), Math.max(6000, text.split(" ").length * 420));
    };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> & { className?: string } = {}, kids: (Node | string)[] = []) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
    const finished = new Set<string>(JSON.parse(localStorage.getItem("missions-done") ?? "[]"));
    const markDone = () => buttons.forEach((b) => { if (finished.has(b.dataset.zone ?? "")) b.dataset.done = "1"; });
    markDone();
    const ORDER: Record<string, number[]> = { air: [0, 2, 1], water: [1, 2, 0], earth: [2, 0, 1], fire: [0, 2, 1] };
    const boxes = new Map([...document.querySelectorAll<HTMLElement>("[data-mission-box]")].map((b) => [b.dataset.missionBox!, b]));
    const initial = new Map([...boxes].map(([k, b]) => [k, b.innerHTML]));
    const endMission = () => { world.setMode("idle"); plates.forEach((p) => p.classList.remove("in-mission")); boxes.forEach((b, k) => { b.innerHTML = initial.get(k)!; b.querySelector<HTMLButtonElement>("[data-mission]")!.onclick = () => run(k); }); };
    function run(zone: string) {
      greeted = true;
      const m = MISSIONS.find((x) => x.zone === zone)!, box = boxes.get(zone)!, plate = box.closest(".plate")!;
      panels.forEach((p) => p.classList.remove("on")); plate.classList.add("in-mission");
      world.setMode("idle"); speak(m.setup);
      box.replaceChildren(el("h3", { textContent: m.title }), el("p", { className: "m-text", textContent: m.setup }), el("p", { className: "mission-row" }, [el("button", { type: "button", className: "start", textContent: "Run it", onclick: fail })]));
      function fail() {
        world.setMode("fail"); speak(m.fail);
        const list = el("ol", { className: "hyps" }, ORDER[zone].map((k) => { const h = m.hypotheses[k]; const b = el("button", { type: "button", textContent: h.text }); b.onclick = () => pick(h, b); return el("li", {}, [b]); }));
        box.replaceChildren(el("h3", { textContent: m.title }), el("p", { className: "m-text obs", textContent: m.fail }), el("p", { className: "m-q", textContent: "What would you check first?" }), list);
      }
      function pick(h: (typeof m.hypotheses)[number], b: HTMLButtonElement) {
        if (b.getAttribute("aria-disabled") === "true") return;
        b.setAttribute("aria-disabled", "true");
        if (!h.right) { b.classList.add("struck"); b.after(el("p", { className: "reply", textContent: h.reply })); world.setMode("wrong"); speak(h.reply); setTimeout(() => world.setMode("fail"), 2600); return; }
        world.setMode("fixed"); speak(m.bunnu);
        finished.add(zone); localStorage.setItem("missions-done", JSON.stringify([...finished])); markDone();
        const kids: Node[] = [el("h3", { textContent: m.title }), el("p", { className: "m-text obs", textContent: h.reply }), el("p", { className: "m-text", textContent: m.fix })];
        if (m.numbers) kids.push(el("p", { className: "nums", textContent: m.numbers }));
        kids.push(el("p", { className: "mission-row" }, [el("a", { className: "start", href: m.report, textContent: "Read the after-action report" }), el("a", { className: "ghost", href: m.ref.href, textContent: m.ref.label }), el("button", { type: "button", className: "ghost", textContent: "Done", onclick: endMission })]));
        box.replaceChildren(...kids);
      }
    }
    document.querySelectorAll<HTMLButtonElement>("[data-mission]").forEach((b) => (b.onclick = () => run(b.dataset.mission!)));
    // a retired general's tea-shop theory of the four elements, said once per world
    const ZLINES: Record<string, string> = {
      air: "An old man who ran a tea shop called air the element of freedom. Rockets are freedom with a checklist.",
      water: "Water is the element of change, he said. Down there it changes your colours, your field of view and whether your radio works.",
      earth: "Earth is the element of substance. Also of wheel slip.",
      fire: "Fire is the element of power. On a chip that small, power is the budget.",
    };
    const toldZone = new Set<string>();
    world.onZone((z) => { clearGuide(); endMission(); if (z) { greeted = true; if (!toldZone.has(z)) { toldZone.add(z); speak(ZLINES[z]); } } });
    let greeted = false;
    const greet = () => { if (!greeted && companionOn) { greeted = true; speak("I'm Bunnu, the cat. Pick a world, or click my ship for a story from the logs. You can switch me off above; no hard feelings. Probably."); } };
    if (shell.classList.contains("exploring")) greet();

    // labels that sit on the bodies themselves
    const lbls = new Map([...document.querySelectorAll<HTMLElement>("[data-lbl]")].map((b) => [b.dataset.lbl!, b]));
    world.onFrame?.((pos) => {
      for (const [id, b] of lbls) {
        const q = pos.get(id), y = q ? q.y + Math.min(q.r,160) : 0;
        const hidden = !q || !q.visible || q.x < 0 || q.x > innerWidth || y < 0 || y > innerHeight - 24;
        if (b.hidden !== hidden) b.hidden = hidden;
        if (hidden || !q) continue;
        b.style.opacity = "1"; b.style.pointerEvents = "auto";
        b.style.transform = `translate(${q.x.toFixed(1)}px, ${y.toFixed(1)}px) translateX(-50%)`;
      }
    });
    // The same story control works with keyboard, pointer and the static poster.
    let ai = Number(localStorage.getItem("bunnu-story") || "0") % ANECDOTES.length;
    const nextStory = () => { if (!companionOn) { companion.click(); return; } greeted = true; const story = ANECDOTES[ai]; speak(story.line, story.src); ai = (ai + 1) % ANECDOTES.length; localStorage.setItem("bunnu-story", String(ai)); world.sound.pluck(660); };
    storyButton.addEventListener("click", nextStory);
    world.onBunnu?.(nextStory);
    // find anything in the index
    const find = document.getElementById("find") as HTMLInputElement;
    find.addEventListener("input", () => {
      const q = find.value.trim().toLowerCase();
      document.querySelectorAll<HTMLLIElement>(".tree li").forEach((li) => { const hit = !q || li.textContent!.toLowerCase().includes(q); li.hidden = !hit; });
    });
    find.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const query = find.value.trim().toLowerCase();
      const match = [...indexDetails.querySelectorAll<HTMLButtonElement>(".tree button")].find((button) => !button.closest("li[hidden]") && button.textContent!.toLowerCase().includes(query));
      if (match) { e.preventDefault(); match.click(); }
    });

    // the time machine
    const tmRange = document.getElementById("tm-year") as HTMLInputElement | null, tmAge = document.getElementById("tm-age")!;
    const tmYears = [...document.querySelectorAll<HTMLElement>(".tm-year")];
    const setTM = () => {
      if (!tmRange) return;
      const i = +tmRange.value, el = tmYears[i], y = el.dataset.y === "now" ? null : +el.dataset.y!;
      tmYears.forEach((t, k) => (t.hidden = k !== i)); world.setYear(y);
      const said = el.querySelector<HTMLElement>(".bunnu-says"); if (said && tmRange.dataset.touched) speak(said.textContent!.replace(/^Bunnu\s*/, ""));
      const back = y === null ? 0 : 2026 - y;
      tmAge.textContent = back === 0 ? "Now: everything built so far is in the system." : `${y}: anything built after this hasn't happened yet.`;
    };
    tmRange?.addEventListener("input", () => { tmRange.dataset.touched = "1"; setTM(); }); setTM();
    world.onObject((id) => { if (id !== "timemachine" && tmRange && tmRange.value !== tmRange.max) { tmRange.value = tmRange.max; setTM(); } });
    world.onZone((z) => { current = z; history.replaceState(null, "", z ? `#${z}` : location.pathname + location.search); panels.forEach((p) => p.classList.remove("on")); buttons.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.zone || null) === z))); plates.forEach((p) => p.classList.toggle("on", p.dataset.plate === z)); });
    addEventListener("keydown", (e) => { if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return; const k = "01234".indexOf(e.key); if (k >= 0 && shell.classList.contains("exploring")) go(["", "air", "water", "earth", "fire"][k]); });
    const snd = document.getElementById("snd")!;
    snd.setAttribute("aria-pressed", String(world.sound.on()));
    snd.addEventListener("click", () => snd.setAttribute("aria-pressed", String(world.sound.toggle())));
    const openFragment = async () => {
      const id = location.hash.slice(1);
      if (!id) { if (shell.classList.contains("exploring")) go(""); return; }
      if (Object.hasOwn(names, id)) { await enterObservatory(); world.focus(id); }
      else if (buttons.some(button => button.dataset.zone === id)) { await enterObservatory(); go(id); }
    };
    addEventListener("hashchange", openFragment);
    await openFragment();
  };
  const next = () => (i < beats.length - 1 ? show(i + 1) : finish());
  document.getElementById("op-next")?.addEventListener("click", next);
  document.getElementById("op-skip")?.addEventListener("click", finish);
  opening.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest("button")) next(); });
  addEventListener("keydown", (e) => { if (done) return; if (e.key === "Enter" || e.key === " ") { e.preventDefault(); next(); } if (e.key === "Escape") finish(); });
  if (new URLSearchParams(location.search).has("intro")) { opening.hidden = false; show(0); } else finish();
</script>
<style>
  :global(body.game) { overflow: hidden; background: #000; }
  .game-shell { position: fixed; inset: 0; }

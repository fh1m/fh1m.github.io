---
import Base from "../layouts/Base.astro";
import RiverMap from "../components/RiverMap.astro";
import { chapters } from "../data/story";
import { person } from "../data/facts";
import stats from "../data/github.json";
import { getCollection } from "astro:content";
const noteCount = (await getCollection("notes")).length;
const bnDigit = (n: number) => String(n).split("").map((d) => "০১২৩৪৫৬৭৮৯"[Number(d)]).join("");
---
<Base bodyClass="home">
  <RiverMap chapters={chapters} />

  <main id="main">
    <header class="hero" aria-labelledby="hero-h">
      <canvas id="world" aria-hidden="true"></canvas>
      <div class="hero-copy">
        <p class="kick"><span class="pixel">fh1m</span> <span class="bn">ঢাকা</span> <span class="mono">Dhaka</span></p>
        <h1 id="hero-h"><span class="name">Fahim Faisal</span> builds machines that have to work <em>on their own</em>.</h1>
        <p class="lede">Rockets, rovers and underwater vehicles, and the firmware, vision and estimation underneath them. This page runs the way the work did: <strong>downstream</strong>, from a laptop in 2021 to an autonomy stack waiting for its first dive.</p>
        <p class="quick">
          <a class="btn-pill pink" href="#source">start at the source ↓</a>
          <a class="btn-pill" href="/notes">notes · {noteCount}</a>
          <a class="btn-pill" href="/cv">cv</a>
        </p>
        <p class="src">Public GitHub, rebuilt {stats.generatedAtLabel}: {stats.publicRepos} repositories, {stats.contributionsLastYear.toLocaleString("en-US")} contributions in the last year.</p>
      </div>
      <figure class="hero-photo">
        <img src="/media/poolside.webp" alt="Fahim at a laptop running a terminal on a poolside table; an underwater vehicle floats in the green pool behind" width="900" height="1600" fetchpriority="high" />
        <figcaption>A pool test. Me, a terminal, and the vehicle in the water.</figcaption>
      </figure>
      <nav class="ports" aria-label="Ports on the river (click one in the 3D map, or here)">
        <p class="mono">the river, as a map: drag to look, click a port</p>
        <ol>
          {chapters.map((c) => <li class={`d-${c.domain}`}><a href={`#${c.id}`} data-port={c.n}><span class="bn">{c.bn}</span> {c.title}</a></li>)}
        </ol>
      </nav>
    </header>

    <section class="creed" aria-label="What each kind of machine taught">
      <p><span class="k air">Rockets</span> taught me guidance and control. <span class="k ground">Rovers</span> taught me manipulation and vision. <span class="k water">Underwater vehicles</span> taught me to trust nothing I hadn't measured.</p>
      <span class="sprite creed-sprite" aria-hidden="true"></span>
    </section>

    <div class="river-wrap">
      <svg class="river" aria-hidden="true"><defs><linearGradient id="rg" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#ff2e7e" /><stop offset=".18" stop-color="#ff6b2c" /><stop offset=".35" stop-color="#00e1ff" /><stop offset=".5" stop-color="#ffd23f" /><stop offset=".7" stop-color="#00e1ff" /><stop offset=".82" stop-color="#c6ff3d" /><stop offset="1" stop-color="#a98bff" /></linearGradient></defs><path class="bed" /><path class="flow" /></svg>

      {chapters.map((c, i) => (
        <section id={c.id} class:list={["chapter", `d-${c.domain}`, i % 2 ? "flip" : ""]} data-chapter={c.n} aria-labelledby={`${c.id}-h`}>
          <div class="marker" data-river-anchor>
            <span class="bn-big bn" aria-hidden="true">{c.bn}</span>
            <p class="meta mono"><span class="bn">{bnDigit(c.n)}</span> · {c.bnGloss} · <time>{c.when}</time></p>
          </div>
          <div class="text">
            <h2 id={`${c.id}-h`}>{c.title}</h2>
            <p class="kicker">{c.kicker}</p>
            {c.body.map((p) => <p set:html={p} />)}
            {c.split && (
              <dl class="split">
                <div><dt>I did</dt><dd set:html={c.split.me} /></div>
                {c.split.team && <div><dt>the team did</dt><dd set:html={c.split.team} /></div>}
                {c.split.others && <div><dt>others did</dt><dd set:html={c.split.others} /></div>}
              </dl>
            )}
          </div>
          {c.media.length > 0 && (
            <div class:list={["media", `n${c.media.length}`]}>
              {c.media.map((m) => (
                <figure class:list={["print", { wide: m.wide }]}>
                  <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  <figcaption><span set:html={m.caption} /> <span class="tier">{m.tier}</span></figcaption>
                </figure>
              ))}
            </div>
          )}
          {c.benches && c.benches.length > 0 && (
            <div class:list={["benches", `n${c.benches.length}`]}>
              {c.benches.map((b) => (
                <aside class="bench" aria-label={`Bench: ${b.title}`}>
                  <h3><span class="tag">bench</span> {b.title}</h3>
                  <div class="bench-body" data-bench={b.key}><p class="mono">Loading the bench…</p></div>
                </aside>
              ))}
            </div>
          )}
          <footer class="ch-foot">
            <p class="lesson">{c.lesson}</p>
            {c.notes.length > 0 && <ul class="pills" aria-label={`Read more: ${c.title}`}>{c.notes.map((n) => <li><a href={n.href}>{n.label} →</a></li>)}</ul>}
          </footer>
        </section>
      ))}
    </div>

    <section class="coda" aria-labelledby="coda-h">
      <h2 id="coda-h">The river keeps going.</h2>
      <p>New reaches get added when the machines do. The notes hold the long versions: how each thing works, what was measured, and what I had to take back.</p>
      <p class="quick"><a class="btn-pill pink" href="/notes">read the notes</a> <a class="btn-pill" href="/log">the log</a> <a class="btn-pill" href={`mailto:${person.email}`}>write to me</a></p>
    </section>
  </main>

  <dialog id="port-panel" aria-labelledby="port-h">
    <form method="dialog"><button class="x" aria-label="Close">×</button></form>
    <p class="mono pp-meta"></p>
    <h2 id="port-h"></h2>
    <p class="pp-kicker"></p>
    <p class="pp-lesson"></p>
    <p><a class="btn-pill pink pp-go" href="#">go to this reach ↓</a></p>
  </dialog>
</Base>

<script>
  import "../scripts/river-client.ts";
</script>

<style>
  /* Hero */
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr); grid-template-rows: 1fr auto; gap: 2rem var(--gutter); align-items: center; padding: 7rem var(--gutter) 2rem; overflow: hidden; isolation: isolate; }
  #world { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; display: block; opacity: 0; transition: opacity 1.2s var(--ease); cursor: grab; }
  :global(body.world-ready) #world { opacity: 1; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -2; background: radial-gradient(60% 50% at 70% 40%, #2a0617 0%, transparent 70%), radial-gradient(50% 40% at 20% 85%, #00242b 0%, transparent 70%), #000; }
  .hero-copy { position: relative; z-index: 2; pointer-events: none; }
  .hero-copy::before { content: ""; position: absolute; inset: -12% -18% -12% -30%; z-index: -1; background: radial-gradient(closest-side, rgb(0 0 0 / .78), rgb(0 0 0 / .45) 60%, transparent); pointer-events: none; }
  .hero-copy a, .hero-copy p { pointer-events: auto; }
  .kick { display: flex; gap: 0.8rem; align-items: baseline; margin-bottom: 1.4rem; }
  .kick .pixel { color: var(--pink); font-size: 1.1rem; }
  .kick .bn { color: var(--water); font-size: 1.2rem; }
  .kick .mono { color: var(--dim); }
  h1 { font-size: clamp(2.6rem, 6.4vw, 6.2rem); font-weight: 700; line-height: 0.95; letter-spacing: -0.04em; max-width: 13ch; }
  h1 .name { display: block; background: linear-gradient(92deg, var(--pink), var(--air) 45%, var(--ground)); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: 0.06em; }
  h1 em { font-family: "Instrument Serif", var(--serif); font-weight: 400; font-style: italic; letter-spacing: -0.01em; color: var(--water); }
  .lede { font-size: var(--s1); line-height: 1.55; color: #e8e5dd; max-width: 46ch; }
  .lede strong { color: var(--pink); }
  .quick { display: flex; gap: 0.7rem; flex-wrap: wrap; margin: 1.8rem 0 1.2rem; }
  .btn-pill { display: inline-block; font: 600 0.88rem var(--display); text-decoration: none; padding: 0.65rem 1.1rem; border-radius: 999px; border: 2px solid #3a3f52; color: var(--chalk); background: #000; transition: transform .2s var(--ease), border-color .2s, background .2s, color .2s; }
  .btn-pill:hover { transform: translateY(-2px); border-color: var(--pink); color: var(--chalk); }
  .btn-pill.pink { background: var(--pink); border-color: var(--pink); color: #000; }
  .btn-pill.pink:hover { background: #ff5c9a; color: #000; }
  .hero-photo { position: relative; z-index: 2; margin: 0; justify-self: end; width: min(100%, 25rem); rotate: 2deg; }
  .hero-photo img { aspect-ratio: 9 / 13; object-fit: cover; object-position: 50% 62%; border-radius: 10px; box-shadow: 14px 14px 0 var(--pink); }
  .hero-photo figcaption { margin-top: 1.4rem; }
  .ports { grid-column: 1 / -1; position: relative; z-index: 2; }
  .ports p { color: var(--faint); margin: 0 0 0.5rem; }
  .ports ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ports a { display: inline-flex; gap: 0.45rem; align-items: baseline; font: 500 0.78rem var(--display); text-decoration: none; padding: 0.3rem 0.7rem; border-radius: 999px; border: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent); background: rgb(0 0 0 / .6); }
  .ports a .bn { color: var(--accent); }
  .ports a:hover, .ports a.lit { background: var(--accent); color: #000; border-color: var(--accent); }
  .ports a:hover .bn, .ports a.lit .bn { color: #000; }

  /* Creed */
  .creed { position: relative; padding: 9rem var(--gutter) 6rem; max-width: 76rem; margin: 0 auto; }
  .creed p { font: 600 clamp(1.8rem, 4vw, 3.4rem)/1.12 var(--display); letter-spacing: -0.03em; max-width: 26ch; }
  .creed .k { font-weight: 750; }
  .creed-sprite { position: absolute; right: var(--gutter); bottom: 4rem; width: 92px; height: 120px; }

  /* The river */
  .river-wrap { position: relative; }
  .river { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; overflow: visible; }
  .river path { fill: none; stroke-linecap: round; }
  .river .bed { stroke: #10131c; stroke-width: 26; }
  .river .flow { stroke: url(#rg); stroke-width: 4; filter: drop-shadow(0 0 6px rgb(255 46 126 / .5)); }

  /* Chapters */
  .chapter { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: "marker marker" "text media" "bench bench" "foot foot"; gap: 2.4rem var(--gutter); padding: 7rem var(--gutter) 5rem calc(var(--gutter) + 3rem); max-width: 96rem; margin: 0 auto; }
  .chapter.flip { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: "marker marker" "media text" "bench bench" "foot foot"; }
  .marker { grid-area: marker; display: flex; align-items: flex-end; gap: 1.4rem; flex-wrap: wrap; }
  .chapter.flip .marker { justify-content: flex-end; text-align: right; }
  .bn-big { font-size: clamp(4.5rem, 12vw, 10rem); line-height: 0.9; color: transparent; -webkit-text-stroke: 2px var(--accent); transition: color .6s var(--ease); }
  .chapter.in .bn-big { color: var(--accent); text-shadow: 0 0 40px color-mix(in srgb, var(--accent) 35%, transparent); }
  .meta { color: var(--dim); margin: 0 0 1rem; }
  .meta .bn { color: var(--accent); }
  .text { grid-area: text; background: rgb(0 0 0 / .78); border-radius: 12px; }
  .text h2 { font-size: clamp(2.2rem, 4.6vw, 4.2rem); }
  .kicker { font: italic 400 clamp(1.3rem, 2vw, 1.75rem)/1.3 "Instrument Serif", var(--serif); color: var(--accent); max-width: 34ch; }
  .text > p:not(.kicker) { font: 400 1.12rem/1.72 var(--serif); color: #e7e4dc; }
  .text :global(a) { --accent: inherit; }
  .split { margin: 1.8rem 0 0; display: grid; gap: 0.2rem; border: 2px solid var(--accent); border-radius: 12px; padding: 0.9rem 1.1rem; }
  .split div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem; padding: 0.45rem 0; border-top: 1px dashed #262a38; }
  .split div:first-child { border-top: 0; }
  .split dt { font: 700 0.75rem var(--mono); color: var(--accent); text-transform: uppercase; letter-spacing: .06em; }
  .split dd { margin: 0; font-size: 0.95rem; color: #dcd9d0; }
  .media { grid-area: media; display: grid; gap: 1.2rem; align-content: start; }
  .media.n2, .media.n3 { grid-template-columns: 1fr 1fr; }
  .media.n3 .print:first-child { grid-column: 1 / -1; }
  .print { margin: 0; transition: transform .5s var(--ease), opacity .6s; }
  .print.wide { grid-column: 1 / -1; }
  .print img { border-radius: 8px; border: 2px solid #1d2130; aspect-ratio: auto; max-height: 34rem; object-fit: cover; }
  .print:nth-child(odd) { rotate: -1.2deg; } .print:nth-child(even) { rotate: 1.4deg; }
  .print:hover { rotate: 0deg; transform: scale(1.02); }
  .print:hover img { border-color: var(--accent); }
  .tier { display: inline-block; font: 700 0.62rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: #000; background: var(--accent); padding: 0.05rem 0.4rem; border-radius: 3px; margin-left: 0.3rem; vertical-align: 1px; }
  .benches { grid-area: bench; display: grid; gap: 2rem; }
  .benches.n2 { grid-template-columns: 1fr 1fr; }
  .bench { background: #05060a; border: 3px solid var(--accent); border-radius: 14px; padding: 1.2rem 1.3rem 1.4rem; box-shadow: 10px 10px 0 color-mix(in srgb, var(--accent) 45%, #000); max-width: 60rem; }
  .benches.n1 .bench { justify-self: start; width: min(100%, 46rem); }
  .chapter.flip .benches.n1 .bench { justify-self: end; }
  .bench h3 { font-size: 1.15rem; margin-bottom: 0.9rem; display: flex; gap: 0.6rem; align-items: center; }
  .tag { font: 700 0.65rem var(--mono); text-transform: uppercase; letter-spacing: .1em; background: var(--accent); color: #000; padding: 0.15rem 0.45rem; border-radius: 4px; }
  .ch-foot { grid-area: foot; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; border-top: 1px solid #1c1f2a; padding-top: 1.6rem; }
  .lesson { font: italic 400 1.5rem/1.25 "Instrument Serif", var(--serif); margin: 0; color: var(--chalk); }
  .lesson::before { content: "→ "; color: var(--accent); font-style: normal; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pills a { display: inline-block; font: 600 0.82rem var(--display); text-decoration: none; padding: 0.45rem 0.85rem; border-radius: 999px; background: var(--accent); color: #000; transition: transform .2s var(--ease); }
  .pills a:hover { transform: translateY(-2px) rotate(-1deg); color: #000; }

  .coda { padding: 9rem var(--gutter) 8rem; text-align: center; }
  .coda h2 { font-size: clamp(2.6rem, 7vw, 6rem); background: linear-gradient(92deg, var(--water), var(--sight), var(--ground), var(--pink)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .coda p { margin-inline: auto; font-size: var(--s1); }
  .coda .quick { justify-content: center; }

  /* Port panel */
  dialog#port-panel { border: 3px solid var(--accent, var(--pink)); border-radius: 16px; background: #05060a; color: var(--chalk); max-width: 34rem; padding: 1.6rem 1.8rem; box-shadow: 12px 12px 0 var(--accent, var(--pink)); }
  dialog#port-panel::backdrop { background: rgb(0 0 0 / .6); backdrop-filter: blur(3px); }
  dialog .x { position: absolute; top: 0.6rem; right: 0.7rem; border-radius: 50%; width: 2.2rem; height: 2.2rem; padding: 0; font-size: 1.2rem; }
  .pp-meta { color: var(--accent); }
  .pp-kicker { font: italic 400 1.35rem/1.3 "Instrument Serif", var(--serif); color: var(--accent); }

  /* Reveal */
  @media (prefers-reduced-motion: no-preference) {
    .chapter .print, .chapter .text, .chapter .bench { opacity: 0; transform: translateY(28px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    .chapter.in .print, .chapter.in .text, .chapter.in .bench { opacity: 1; transform: none; }
    .chapter.in .print:nth-child(2) { transition-delay: .12s; } .chapter.in .print:nth-child(3) { transition-delay: .24s; }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 6rem; }
    .hero-photo { justify-self: start; width: min(80%, 20rem); }
    .chapter, .chapter.flip { grid-template-columns: 1fr; grid-template-areas: "marker" "text" "media" "bench" "foot"; padding: 5rem var(--gutter) 4rem; }
    .chapter.flip .marker { justify-content: flex-start; text-align: left; }
    .benches.n2 { grid-template-columns: 1fr; }
    .split div { grid-template-columns: 1fr; gap: 0.2rem; }
    .creed-sprite { display: none; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import Scope from '../components/Scope.astro';
import ContourField from '../components/ContourField.astro';
import StatRail from '../components/StatRail.astro';
import CertWall from '../components/CertWall.astro';
import PressWall from '../components/PressWall.astro';
import PublicationCards from '../components/PublicationCards.astro';
import RepoCard from '../components/RepoCard.astro';
import CodePane from '../components/CodePane.astro';
import Pipeline from '../components/Pipeline.astro';
import { PROFILE } from '../data/profile';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const pad = (n: number) => String(n).padStart(2, '0');
const now = new Date();
const initialTime = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
const buildYear = now.getFullYear();

// LOC derives from PROFILE.location ("Dhaka, Bangladesh" → "DHAKA BD").
const locParts = PROFILE.location.split(',').map((s) => s.trim().toUpperCase());
const locCity = locParts[0] ?? 'DHAKA';
const locCountry = locParts[1]?.startsWith('BANGLADESH') ? 'BD' : (locParts[1] ?? 'BD');

// Story axes — act labels, roman numerals, and per-machine thread hints.
const ACT_LABEL: Record<string, string> = {
  move: 'MOVE',
  understand: 'UNDERSTAND',
  decide: 'DECIDE',
  next: 'NEXT',
};
const ACT_ROMAN: Record<string, string> = {
  move: 'I',
  understand: 'II',
  decide: 'III',
  next: 'IV',
};
const THREAD_MAP: Record<string, string> = {
  duburi: 'motion → perception',
  duburi_ws: 'intelligence → deployment',
  'duburi-codebase_rnd': 'perception → research',
};

// ACT teaser rows — one per act, links into /about (the story).
const ACTS = [
  { roman: 'I', label: 'MOVE', line: 'Machines that move through water and air.' },
  { roman: 'II', label: 'UNDERSTAND', line: 'Machines that see, estimate, and map.' },
  { roman: 'III', label: 'DECIDE', line: 'Machines that decide where intelligence lives.' },
];

// Featured machines band — pinned slugs, order preserved.
const FEATURED_SLUGS = ['duburi', 'duburi_ws', 'duburi-codebase_rnd'] as const;
const allMachines = await getCollection('machines');
const featured = FEATURED_SLUGS.map((slug) =>
  allMachines.find((m) => m.id === slug && !m.data.draft),
).filter((m): m is CollectionEntry<'machines'> => Boolean(m));

// ---- Scope contacts — derived from the real machines collection, not
// hand-typed. Range = normalized age (oldest dateStart → range 1, newest →
// range ~0.15), bearing is a fixed fan spread so five labels don't overlap.
// This is the same data the /machines pages render; the scope just reads
// it back as a radar instead of a table.
const SCOPE_SLUGS = ['duburi', 'calib_challenge', 'arduino-vision', 'duburi_ws', 'air-gnc'] as const;
const scopeSource = SCOPE_SLUGS.map((slug) => allMachines.find((m) => m.id === slug))
  .filter((m): m is CollectionEntry<'machines'> => Boolean(m));
const starts = scopeSource.map((m) => m.data.dateStart);
const oldest = starts.reduce((a, b) => (a < b ? a : b));
const newest = starts.reduce((a, b) => (a > b ? a : b));
const toMonths = (d: string) => {
  const [y, m] = d.split('-').map(Number);
  return y * 12 + m;
};
const span = Math.max(1, toMonths(newest) - toMonths(oldest));
const BEARINGS = [340, 60, 130, 200, 270];
const scopeContacts = scopeSource.map((m, i) => ({
  label: m.data.name.length > 18 ? m.data.name.slice(0, 16).toUpperCase() + '…' : m.data.name.toUpperCase(),
  bearingDeg: BEARINGS[i % BEARINGS.length],
  range: 0.15 + 0.75 * ((toMonths(newest) - toMonths(m.data.dateStart)) / span),
  href: `/machines/${m.id}`,
}));

// ---- Flagship code excerpt — verbatim from mongla_ws (fh1m/mongla_ws,
// main, src/mongla_control/mongla_control/geometric_allocation.py:66-90).
// Not written to look like sample code: this is the actual thrust-allocation
// matrix builder for the AUV hull, cross product and all.
const ALLOCATOR_EXCERPT = `def _cross(a: Sequence[float], b: Sequence[float]) -> Tuple[float, float, float]:
    return (a[1] * b[2] - a[2] * b[1],
            a[2] * b[0] - a[0] * b[2],
            a[0] * b[1] - a[1] * b[0])


def build_b(thrusters=THRUSTERS) -> Tuple[Tuple[float, ...], ...]:
    """The 6xN allocation matrix: force rows then moment rows.

    Column j is what thruster j produces at unit output -- its axis as a force,
    and \`r x axis\` as a moment. That is the whole model, and it is why the
    moment arms are real distances instead of signs.
    """
    rows = [[0.0] * len(thrusters) for _ in range(6)]
    for j, (_name, pos, axis) in enumerate(thrusters):
        n = (axis[0] ** 2 + axis[1] ** 2 + axis[2] ** 2) ** 0.5
        unit = tuple(c / n for c in axis)
        moment = _cross(pos, unit)
        for i in range(3):
            rows[i][j] = unit[i]
            rows[i + 3][j] = moment[i]
    return tuple(tuple(r) for r in rows)
`;
---

<Base title="FAHIM FAISAL — AUTONOMOUS SYSTEMS" description={PROFILE.roleLine}>
  <Boot />

  <!-- ============================================================
       HERO — headline + CTAs on the left, the sonar Scope on the right.
       Real, sourced contacts, not decoration (see SCOPE_SLUGS above).
       ============================================================ -->
  <section class="hero" data-reveal>
    <ContourField />
    <div class="hero-copy">
      <p class="mono-label">
        [SYS: ONLINE] [LOC: {locCity} {locCountry}] [BLDG: {buildYear}]
      </p>
      <h1 class="hero-name">FAHIM FAISAL</h1>
      <p class="hero-title">
        I build machines that have to work when nobody is watching — underwater, mostly,
        where there's no one to ask for a second chance.
      </p>
      <p class="hero-sub">
        Perception, control, and the flight-controller boundary for BRACU Duburi's RoboSub
        entry — three campaigns, one obsession: does the machine actually do the thing.
      </p>
      <div class="hero-ctas">
        <a class="cta" href="/machines">[03] MACHINES →</a>
        <a class="cta" href="/about">[01] ABOUT →</a>
      </div>
    </div>
    <div class="hero-scope">
      <Scope contacts={scopeContacts} />
    </div>
  </section>

  <StatRail />

  <section class="question-node" data-reveal>
    <a class="question-link" href="/about">
      <span class="question-text">How do machines move?</span>
      <span class="question-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="status-strip" aria-label="System telemetry">
    <span class="mono-label">[SYS:ONLINE]</span>
    <span class="mono-label">[SCROLL:00%]</span>
    <span class="mono-label">[T: <span id="home-clock">{initialTime}</span>]</span>
    <span class="mono-label">[FRAMES:—]</span>
  </section>

  <!-- ============================================================
       THE FIELD — the one real photograph on the site: the AUV in the
       water at a BRACU Duburi pool session, mid-session on a dual-screen
       rig. Duotone-treated to sit in the palette, not stock imagery.
       ============================================================ -->
  <section class="field-section" data-reveal>
    <p class="mono-label section-label">[IN THE FIELD]</p>
    <div class="field-grid">
      <figure class="field-photo-frame">
        <img
          class="field-photo"
          src="/media/poolside.jpg"
          alt="Fahim Faisal at a BRACU Duburi pool test session, working at a dual-screen laptop rig beside the AUV floating at the water's edge"
          width="1125"
          height="2000"
          loading="eager"
        />
        <span class="field-scan" aria-hidden="true"></span>
      </figure>
      <div class="field-copy">
        <p class="field-quote">
          The vehicle has to work in water, on battery, with nobody driving it by hand.
          Everything upstream of that moment is rehearsal.
        </p>
        <p class="field-caption mono-label">POOL SESSION — BRACU DUBURI — AUV IN WATER, DUAL-SCREEN TELEMETRY RIG</p>
        <a class="cta" href="/machines/duburi">[MACHINE] DUBURI →</a>
      </div>
    </div>
  </section>

  <section class="pipeline-section" data-reveal>
    <p class="mono-label section-label">[PIPELINE]</p>
    <Pipeline />
  </section>

  <section class="act-teaser" data-reveal>
    <p class="mono-label section-label">[THE STORY]</p>
    <div class="act-rows">
      {ACTS.map((a) => (
        <a class="act-row" href="/about">
          <span class="act-row-label mono-label">ACT {a.roman} — {a.label}</span>
          <span class="act-row-line">{a.line}</span>
          <span class="act-row-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="featured" data-reveal>
    <p class="mono-label section-label">[FEATURED MACHINES]</p>
    <div class="machine-rows">
      {featured.map((m) => {
        const act = m.data.act ?? 'next';
        const thread = THREAD_MAP[m.id];
        return (
          <a class="machine-row" href={`/machines/${m.id}`}>
            <span class="act-chip mono-label">ACT {ACT_ROMAN[act]} {ACT_LABEL[act]}</span>
            <span class="machine-chip mono-label">{m.data.status}</span>
            <span class="machine-name">{m.data.name}</span>
            <span class="machine-summary">{m.data.summary}</span>
            <span class="machine-arrow" aria-hidden="true">→</span>
            {thread && (
              <span class="machine-thread mono-label">{thread}</span>
            )}
          </a>
        );
      })}
    </div>

    <!-- Flagship real code, from the actual repo. -->
    <div class="flagship">
      <CodePane
        filename="mongla_control/geometric_allocation.py"
        lang="python"
        code={ALLOCATOR_EXCERPT}
        caption="fh1m/mongla_ws — real thrust-allocation matrix builder for the AUV hull, read verbatim off main"
      />
      <RepoCard owner="fh1m" repo="mongla_ws" label="Mongla — the AUV autonomy stack, independent of duburi_ws" />
    </div>
  </section>

  <!-- ============================================================
       CREDENTIALS — the real RoboSub certificates.
       ============================================================ -->
  <section class="cert-section" data-reveal>
    <p class="mono-label section-label">[CREDENTIALS]</p>
    <p class="section-intro">Three RoboSub campaigns, three certificates, one team.</p>
    <CertWall />
  </section>

  <!-- ============================================================
       PRESS — real headlines, real ledes, real quotes.
       ============================================================ -->
  <section class="press-section" data-reveal>
    <p class="mono-label section-label">[AS COVERED BY]</p>
    <PressWall />
  </section>

  <!-- ============================================================
       PUBLICATIONS
       ============================================================ -->
  <section class="pub-section" data-reveal>
    <p class="mono-label section-label">[PUBLICATIONS]</p>
    <PublicationCards />
  </section>

  <section class="now-teaser" data-reveal>
    <p class="mono-label section-label">[ACT IV: NEXT]</p>
    <p class="now-line">The next act is open — the machine is still being built.</p>
    <a class="cta" href="/now">[NEXT:] the next act is open →</a>
  </section>

  <script is:inline>
    (function () {
      var el = document.getElementById('home-clock');
      if (!el || el.dataset.clockBound) return;
      el.dataset.clockBound = '1';
      function pad(n) { return String(n).padStart(2, '0'); }
      function tick() {
        var d = new Date();
        el.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <style>
    .hero {
      position: relative;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) var(--space-16);
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(280px, 1fr);
      gap: var(--space-12);
      align-items: center;
      overflow: hidden;
    }

    .hero-copy {
      position: relative;
      z-index: 1;
      display: grid;
      gap: var(--space-6);
    }

    /* The giant name wordmark — the mongla_ws hero treats its own name
       ("Mongla") at this scale; this is the same instrument reused for a
       person instead of a project, so the headline reads as HIS line, not
       a borrowed one. */
    .hero-name {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 800;
      font-size: clamp(2.75rem, 9vw, 7rem);
      line-height: 0.92;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .hero-title {
      font-family: Georgia, 'Times New Roman', var(--font-serif), serif;
      font-style: italic;
      font-size: var(--text-h3);
      line-height: 1.4;
      color: var(--ink);
      max-width: 44ch;
      border-left: 2px solid var(--signal-2);
      padding-left: var(--space-4);
    }

    .hero-sub {
      color: var(--ink-muted);
      max-width: 52ch;
    }

    .hero-scope {
      position: relative;
      z-index: 1;
    }

    .hero-ctas {
      display: flex;
      gap: var(--space-6);
      flex-wrap: wrap;
    }

    .cta {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--signal);
      border: 1px solid var(--line);
      padding: var(--space-2) var(--space-3);
      width: fit-content;
    }

    .cta:hover {
      color: var(--surface-0);
      background: var(--signal);
      border-color: var(--signal);
    }

    /* ── Question node — story entry pull line ───── */
    .question-node {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-8) var(--space-6);
      border-top: 1px solid var(--line);
    }

    .question-link {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      max-width: var(--max-width-editorial);
    }

    .question-text {
      font-family: Georgia, 'Times New Roman', var(--font-serif), serif;
      font-style: italic;
      font-size: var(--text-h2);
      color: var(--ink);
      max-width: 48ch;
    }

    .question-arrow {
      font-family: var(--font-mono), ui-monospace, monospace;
      color: var(--ink-muted);
      transition:
        color var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out);
    }

    .question-link:hover .question-text {
      color: var(--signal);
    }

    .question-link:hover .question-arrow {
      color: var(--signal);
      transform: translateX(2px);
    }

    .status-strip {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-3) var(--space-6);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      display: flex;
      gap: var(--space-6);
      flex-wrap: wrap;
    }

    /* ── The Field — real photo ──────────────────── */
    .field-section {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .field-grid {
      display: grid;
      /* The photo column is sized to the photo, not the other way round:
         poolside.jpg is a tall phone portrait (1125x2000). Forcing it into
         a wide `1.1fr` box with `object-fit: cover` cropped most of the
         frame away — the fix is an image column whose width tracks its
         own aspect ratio instead of stretching to fill a track shaped for
         landscape photography. */
      grid-template-columns: minmax(260px, 400px) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: center;
      border-top: 1px solid var(--line);
      padding-top: var(--space-8);
    }

    .field-photo-frame {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      /* Match the source aspect ratio exactly so `cover` below has nothing
         to crop — the frame's shape IS the photo's shape, scaled. */
      aspect-ratio: 1125 / 2000;
      max-height: 640px;
      width: 100%;
      margin: 0 auto;
    }

    .field-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Duotone-adjacent treatment: desaturate, then let the near-black
         background and blue signal read through as the "tint" via the
         page around it rather than a heavy CSS duotone filter — keeps the
         real photo honest (recognizable) instead of stylized into
         illegibility. */
      filter: grayscale(0.4) contrast(1.08) saturate(0.9) brightness(0.96);
    }

    .field-scan {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 0%, rgba(94, 119, 255, 0.06) 50%, transparent 100%);
      background-size: 100% 220%;
      animation: field-scan-move 6s linear infinite;
      pointer-events: none;
    }

    @keyframes field-scan-move {
      from {
        background-position: 0 0;
      }
      to {
        background-position: 0 220%;
      }
    }

    .field-copy {
      display: grid;
      gap: var(--space-4);
    }

    .field-quote {
      font-family: Georgia, 'Times New Roman', serif;
      font-style: italic;
      font-size: var(--text-h3);
      line-height: 1.4;
      color: var(--ink);
      max-width: 36ch;
    }

    .field-caption {
      color: var(--ink-muted);
    }

    .pipeline-section {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .section-label {
      color: var(--ink-muted);
    }

    .section-intro {
      color: var(--ink-muted);
      max-width: var(--max-width-editorial);
    }

    /* ── Act teaser strip ────────────────────────── */
    .act-teaser {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .act-rows {
      border-top: 1px solid var(--line);
    }

    .act-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      gap: var(--space-6);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line);
    }

    .act-row-label {
      color: var(--ink);
      white-space: nowrap;
    }

    .act-row-line {
      color: var(--ink-muted);
    }

    .act-row-arrow {
      color: var(--ink-muted);
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .act-row:hover .act-row-arrow {
      transform: translateX(2px);
    }

    /* ── Featured machines ───────────────────────── */
    .featured {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      /* ⛔ EXPLICIT, NOT omitted. A bare `display: grid` with no
         grid-template-columns still lets a descendant's un-wrappable
         min-content (here: .flagship > .code-pane > pre, white-space: pre)
         push the implicit column wider than the viewport — nested grids
         leak min-content upward through every level that doesn't cap it,
         and `.flagship`'s own `minmax(0, ...)` tracks only protect ITS
         children, not .featured's sizing of .flagship itself. Measured:
         without this, a 390px viewport produced a 6992px page. */
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .machine-rows {
      border-top: 1px solid var(--line);
    }

    .machine-row {
      display: grid;
      grid-template-columns: auto auto 1fr 2fr auto;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line);
    }

    .act-chip {
      color: var(--signal);
      white-space: nowrap;
    }

    .machine-chip {
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
      color: var(--ink-muted);
      white-space: nowrap;
    }

    .machine-name {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      font-size: var(--text-h3);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
    }

    .machine-summary {
      color: var(--ink-muted);
      /* This is a grid item that spans `grid-column: 1 / -1` on narrow
         viewports (see the media query below). `min-width: 0` alone did
         NOT fix this measured 425px-in-a-342px-track overflow -- a span
         that crosses a flexible (`1fr`) track keeps some max-content
         contribution to that track under the grid sizing algorithm even
         with min-width: 0 on the item. `width: 100%` forces the item to
         its resolved grid-area width outright, and `overflow-wrap` is the
         belt-and-braces: whatever width it ends up with, prose breaks
         inside it rather than pushing the box wider. */
      min-width: 0;
      width: 100%;
      overflow-wrap: anywhere;
    }

    .machine-arrow {
      color: var(--ink-muted);
    }

    .machine-thread {
      grid-column: 3 / -1;
      color: var(--ink-muted);
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
      width: fit-content;
      line-height: 1;
      min-width: 0;
    }

    .machine-row:hover .machine-arrow {
      color: var(--signal);
    }

    .flagship {
      margin-top: var(--space-8);
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
    }

    /* ── Credentials / Press / Publications section shells ────── */
    .cert-section,
    .press-section,
    .pub-section {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    /* ── NOW / Act IV teaser ─────────────────────── */
    .now-teaser {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6) var(--space-24);
      display: grid;
      gap: var(--space-4);
    }

    .now-line {
      color: var(--ink-muted);
      max-width: 40ch;
    }

    @media (max-width: 1000px) {
      .hero {
        grid-template-columns: 1fr;
      }

      .hero-scope {
        order: -1;
        max-width: 320px;
        margin: 0 auto;
      }

      .field-grid {
        grid-template-columns: 1fr;
      }

      .flagship {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      /* A single flexible column, not a spanning item across mixed
         auto/1fr tracks: with `auto auto 1fr auto` + a `grid-column: 1/-1`
         item, the spanning item's max-content size can still inflate the
         `auto` tracks even with min-width:0/width:100% on the item itself
         (measured: 425px content in a 342px track, at 390px viewport).
         One `minmax(0, 1fr)` column sidesteps the interaction outright —
         every child is full-width and wraps on its own line. */
      .machine-row {
        grid-template-columns: minmax(0, 1fr);
      }

      .machine-summary,
      .machine-thread {
        grid-column: 1 / -1;
      }

      .act-row {
        grid-template-columns: auto 1fr auto;
      }
    }
  </style>

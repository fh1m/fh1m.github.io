---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import { PROFILE } from '../data/profile';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const pad = (n: number) => String(n).padStart(2, '0');
const now = new Date();
const initialTime = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
const buildYear = now.getFullYear();

// LOC derives from PROFILE.location ("Dhaka, Bangladesh" → "DHAKA BD").
const locParts = PROFILE.location.split(',').map((s) => s.trim().toUpperCase());
const locCity = locParts[0] ?? 'DHAKA';
const locCountry = locParts[1]?.startsWith('BANGLADESH') ? 'BD' : (locParts[1] ?? 'BD');

// Story axes — act labels, roman numerals, and per-machine thread hints.
const ACT_LABEL: Record<string, string> = {
  move: 'MOVE',
  understand: 'UNDERSTAND',
  decide: 'DECIDE',
  next: 'NEXT',
};
const ACT_ROMAN: Record<string, string> = {
  move: 'I',
  understand: 'II',
  decide: 'III',
  next: 'IV',
};
const THREAD_MAP: Record<string, string> = {
  duburi: 'motion → perception',
  duburi_ws: 'intelligence → deployment',
  'duburi-codebase_rnd': 'perception → research',
};

// ACT teaser rows — one per act, links into /about (the story).
const ACTS = [
  { roman: 'I', label: 'MOVE', line: 'Machines that move through water and air.' },
  { roman: 'II', label: 'UNDERSTAND', line: 'Machines that see, estimate, and map.' },
  { roman: 'III', label: 'DECIDE', line: 'Machines that decide where intelligence lives.' },
];

// Featured machines band — pinned slugs, order preserved.
const FEATURED_SLUGS = ['duburi', 'duburi_ws', 'duburi-codebase_rnd'] as const;
const allMachines = await getCollection('machines');
const featured = FEATURED_SLUGS.map((slug) =>
  allMachines.find((m) => m.id === slug && !m.data.draft),
).filter((m): m is CollectionEntry<'machines'> => Boolean(m));
---

<Base title="FAHIM FAISAL — AUTONOMOUS SYSTEMS" description={PROFILE.roleLine}>
  <!-- [VERIFY]: LOC derives from PROFILE.location ("Dhaka, Bangladesh" → "DHAKA BD"); confirm the abbreviation mapping before publishing. -->
  <section class="hero" data-reveal>
    <p class="mono-label">
      [SYS: ONLINE] [LOC: {locCity} {locCountry}] [BLDG: {buildYear}]
    </p>
    <h1 class="display hero-title">
      Machines that have to work when nobody is watching.
    </h1>
    <p class="hero-sub">
      I build machines that perceive the world and act inside it. Most of my work
      starts with a question about what is happening underneath the abstraction.
    </p>
    <div class="hero-ctas">
      <a class="cta" href="/machines">[03] MACHINES →</a>
      <a class="cta" href="/about">[01] ABOUT →</a>
    </div>
  </section>

  <section class="question-node" data-reveal>
    <a class="question-link" href="/about">
      <span class="question-text">How do machines move?</span>
      <span class="question-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="status-strip" aria-label="System telemetry">
    <span class="mono-label">[SYS:ONLINE]</span>
    <span class="mono-label">[SCROLL:00%]</span>
    <span class="mono-label">[T: <span id="home-clock">{initialTime}</span>]</span>
    <span class="mono-label">[FRAMES:—]</span>
  </section>

  <section class="pipeline-section" data-reveal>
    <p class="mono-label section-label">[PIPELINE]</p>
    <Pipeline />
  </section>

  <section class="act-teaser" data-reveal>
    <p class="mono-label section-label">[THE STORY]</p>
    <div class="act-rows">
      {ACTS.map((a) => (
        <a class="act-row" href="/about">
          <span class="act-row-label mono-label">ACT {a.roman} — {a.label}</span>
          <span class="act-row-line">{a.line}</span>
          <span class="act-row-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="featured" data-reveal>
    <p class="mono-label section-label">[FEATURED MACHINES]</p>
    <div class="machine-rows">
      {featured.map((m) => {
        const act = m.data.act ?? 'next';
        const thread = THREAD_MAP[m.id];
        return (
          <a class="machine-row" href={`/machines/${m.id}`}>
            <span class="act-chip mono-label">ACT {ACT_ROMAN[act]} {ACT_LABEL[act]}</span>
            <span class="machine-chip mono-label">{m.data.status}</span>
            <span class="machine-name">{m.data.name}</span>
            <span class="machine-summary">{m.data.summary}</span>
            <span class="machine-arrow" aria-hidden="true">→</span>
            {thread && (
              <span class="machine-thread mono-label">{thread}</span>
            )}
          </a>
        );
      })}
    </div>
  </section>

  <section class="press-strip" data-reveal>
    <p class="mono-label section-label">[AS COVERED BY]</p>
    <div class="press-links">
      <a class="press-link mono-label" href="https://www.thedailystar.net/campus/news/first-hybrid-rocket-engine-bangladesh-tested-successfully-3418016" target="_blank" rel="noopener noreferrer">THE DAILY STAR</a>
      <a class="press-link mono-label" href="https://robonation.org" target="_blank" rel="noopener noreferrer">ROBONATION</a>
      <a class="press-link mono-label" href="https://bracuduburi.com/" target="_blank" rel="noopener noreferrer">BRACU DUBURI</a>
    </div>
  </section>

  <section class="now-teaser" data-reveal>
    <p class="mono-label section-label">[ACT IV: NEXT]</p>
    <p class="now-line">The next act is open — the machine is still being built.</p>
    <a class="cta" href="/now">[NEXT:] the next act is open →</a>
  </section>

  <script is:inline>
    (function () {
      var el = document.getElementById('home-clock');
      if (!el || el.dataset.clockBound) return;
      el.dataset.clockBound = '1';
      function pad(n) { return String(n).padStart(2, '0'); }
      function tick() {
        var d = new Date();
        el.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <style>
    /* F3 FLAG: 7 raw var(--signal) refs (hero CTA base+hover = 1 pattern,
       act chips = 1 pattern, machine-arrow hover = 1 pattern,
       question hover = 1 conditional pattern) — ≤3 simultaneous per viewport. */
    .hero {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6) var(--space-16);
      display: grid;
      gap: var(--space-8);
    }

    .hero-title {
      font-weight: 700;
    }

    .hero-sub {
      color: var(--ink-muted);
      max-width: 52ch;
    }

    .hero-ctas {
      display: flex;
      gap: var(--space-6);
      flex-wrap: wrap;
    }

    .cta {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--signal);
      border: 1px solid var(--line);
      padding: var(--space-2) var(--space-3);
      width: fit-content;
    }

    .cta:hover {
      color: var(--surface-0);
      background: var(--signal);
      border-color: var(--signal);
    }

    /* ── Question node — story entry pull line ───── */
    .question-node {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-8) var(--space-6);
      border-top: 1px solid var(--line);
    }

    .question-link {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      max-width: var(--max-width-editorial);
    }

    .question-text {
      font-family: var(--font-serif), serif;
      font-style: italic;
      font-size: var(--text-h2);
      color: var(--ink);
      max-width: 48ch;
    }

    .question-arrow {
      font-family: var(--font-mono), ui-monospace, monospace;
      color: var(--ink-muted);
      transition:
        color var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out);
    }

    .question-link:hover .question-text {
      color: var(--signal);
    }

    .question-link:hover .question-arrow {
      color: var(--signal);
      transform: translateX(2px);
    }

    .status-strip {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-3) var(--space-6);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      display: flex;
      gap: var(--space-6);
      flex-wrap: wrap;
    }

    .pipeline-section {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .section-label {
      color: var(--ink-muted);
    }

    /* ── Act teaser strip ────────────────────────── */
    .act-teaser {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .act-rows {
      border-top: 1px solid var(--line);
    }

    .act-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      gap: var(--space-6);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line);
    }

    .act-row-label {
      color: var(--ink);
      white-space: nowrap;
    }

    .act-row-line {
      color: var(--ink-muted);
    }

    .act-row-arrow {
      color: var(--ink-muted);
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .act-row:hover .act-row-arrow {
      transform: translateX(2px);
    }

    /* ── Featured machines ───────────────────────── */
    .featured {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .machine-rows {
      border-top: 1px solid var(--line);
    }

    .machine-row {
      display: grid;
      grid-template-columns: auto auto 1fr 2fr auto;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4) 0;
      border-bottom: 1px solid var(--line);
    }

    .act-chip {
      color: var(--signal);
      white-space: nowrap;
    }

    .machine-chip {
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
      color: var(--ink-muted);
      white-space: nowrap;
    }

    .machine-name {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-weight: 600;
      font-size: var(--text-h3);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
    }

    .machine-summary {
      color: var(--ink-muted);
    }

    .machine-arrow {
      color: var(--ink-muted);
    }

    .machine-thread {
      grid-column: 3 / -1;
      color: var(--ink-muted);
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
      width: fit-content;
      line-height: 1;
    }

    .machine-row:hover .machine-arrow {
      color: var(--signal);
    }

    /* ── Press strip ─────────────────────────────── */
    .press-strip {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .press-links {
      display: flex;
      gap: var(--space-6);
      flex-wrap: wrap;
      border-top: 1px solid var(--line);
      padding-top: var(--space-4);
    }

    .press-link {
      color: var(--ink-muted);
      border: 1px solid var(--line);
      padding: var(--space-1) var(--space-2);
      line-height: 1;
    }

    .press-link:hover {
      color: var(--ink);
      border-color: var(--ink-muted);
    }

    /* ── NOW / Act IV teaser ─────────────────────── */
    .now-teaser {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: var(--space-16) var(--space-6) var(--space-24);
      display: grid;
      gap: var(--space-4);
    }

    .now-line {
      color: var(--ink-muted);
      max-width: 40ch;
    }

    @media (max-width: 720px) {
      .machine-row {
        grid-template-columns: auto auto 1fr auto;
      }

      .machine-summary,
      .machine-thread {
        grid-column: 1 / -1;
      }

      .act-row {
        grid-template-columns: auto 1fr auto;
      }
    }
  </style>
</Base>

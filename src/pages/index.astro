---
import Base from "../layouts/Base.astro";
import { chapters } from "../data/story";
import { voices, beliefs, taste } from "../data/influences";
import { person } from "../data/facts";
import stats from "../data/github.json";
import mongla from "../data/mongla.json";
import { getCollection } from "astro:content";
const noteCount = (await getCollection("notes")).length;
const pad = (n: number) => String(n).padStart(2, "0");
// 26 two-week bins of the last year's public contributions: the bar chart in part 10 of View 01.
const days = stats.days as [string, number][];
const weeks = Array.from({ length: 26 }, (_, i) => days.slice(i * 14, i * 14 + 14).reduce((s, d) => s + d[1], 0)).join(",");
const status: Record<string, string> = { source: "DONE", sky: "FLOWN", water: "RE-GRADED", cat: "RE-GRADED", ground: "COMPETED", current: "COMPETED", mongla: "BENCH", dristy: "BENCH · PAUSED", rupsha: "SIM · BUILDING", den: "IN USE", mohona: "OPEN" };
---
<Base bodyClass="home">
  <main id="main">
    <!-- Title sheet -->
    <header class="title-sheet" aria-labelledby="hero-h">
      <div class="ts-copy">
        <p class="label">Drawing set FH1M · rev {stats.generatedAtLabel}</p>
        <h1 id="hero-h">Fahim Faisal</h1>
        <p class="role">Autonomy and robotics engineer, Dhaka.</p>
        <p class="lede">I build machines that have to work on their own: rockets, rovers and underwater vehicles, and the firmware, vision and estimation underneath them. This is the record of that work, sheet by sheet: what was built, what was measured, and what I had to take back.</p>
        <dl class="tb">
          <div><dt>Disciplines</dt><dd>Perception · estimation · control · embedded</dd></div>
          <div><dt>Since</dt><dd>2021, engineering teams since 2023</dd></div>
          <div><dt>Now</dt><dd><a href="#mongla">Mongla</a> (AUV autonomy), <a href="#rupsha">Rupsha</a> (rover), <a href="#dristy">Dristy</a> (K210 vision)</dd></div>
          <div><dt>Record</dt><dd>{stats.publicRepos} public repositories · {stats.contributionsLastYear.toLocaleString("en-US")} contributions in the last year · {noteCount} notes</dd></div>
        </dl>
        <p class="actions">
          <a class="btn-line solid" href="#sheets">Read the sheets</a>
          <a class="btn-line" href="/notes">Notes</a>
          <a class="btn-line" href="/cv">CV</a>
        </p>
      </div>
      <figure class="ts-photo">
        <img src="/media/poolside.webp" alt="Fahim at a laptop running a terminal on a poolside table; an underwater vehicle floats in the pool behind" width="900" height="1600" fetchpriority="high" />
        <figcaption><span class="label">Fig. 0</span> Pool test: a terminal, and the vehicle in the water.</figcaption>
      </figure>
    </header>

    <!-- View 01: the systems, isometric -->
    <section class="view" aria-labelledby="view-h">
      <div class="fixture">
        <p class="fixture-head"><span class="id">View 01</span><span id="view-h">Systems, isometric · drag to rotate · select a part</span></p>
        <div class="view-body">
          <div class="viewport">
            <canvas id="assembly" aria-hidden="true" data-weeks={weeks}></canvas>
            <div class="balloons"></div>
          </div>
          <ol class="parts" aria-label="Parts list: open a sheet summary">
            {chapters.map((c) => <li><button type="button" data-part={c.n}><span class="pn">{pad(c.n)}</span><span class="pt">{c.title}</span><span class="pw mono">{c.when}</span></button></li>)}
          </ol>
        </div>
      </div>
    </section>

    <!-- Sheet index: a contact sheet, not a table of text -->
    <section id="sheets" class="index" aria-labelledby="idx-h">
      <h2 id="idx-h"><span class="label">Index · {chapters.length} sheets</span> The work, in order</h2>
      <ol class="contact">
        {chapters.map((c) => (
          <li>
            <a href={`#${c.id}`} data-sheet={c.n}>
              <span class="thumb">
                {c.media[0] ? <img src={c.media[0].src} alt="" loading="lazy" decoding="async" /> : <svg viewBox="0 0 260 120" preserveAspectRatio="none" aria-hidden="true">{weeks.split(",").map((w, i, a) => { const v = Number(w), mx = Math.max(...a.map(Number)); const h = 6 + (v / mx) * 100; return <rect x={i * 10 + 1} y={118 - h} width="7" height={h} fill="#3b6fe0" />; })}</svg>}
                <span class="tn">{pad(c.n)}</span>
              </span>
              <span class="tt">{c.title}</span>
              <span class="tw mono">{c.when} · {status[c.id]}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="keys mono" aria-hidden="true"><kbd>j</kbd> <kbd>k</kbd> flip sheets · <kbd>g</kbd> back to the top</p>
    </section>

    <!-- The sheets -->
    {chapters.map((c) => (
      <section id={c.id} class="sheet" data-chapter={c.n} aria-labelledby={`${c.id}-h`}>
        <div class="frame">
          <div class="grid-marks" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span></div>
          <div class="sheet-text">
            <p class="label">Sheet {pad(c.n)} / {pad(chapters.length - 1)} · {c.when}</p>
            <h2 id={`${c.id}-h`}>{c.title}</h2>
            <p class="kicker">{c.kicker}</p>
            {c.body.map((p) => <p class="body" set:html={p} />)}
            {c.split && (
              <table class="resp">
                <caption class="label">Responsibility</caption>
                <tbody>
                  <tr><th scope="row">I did</th><td set:html={c.split.me} /></tr>
                  {c.split.team && <tr><th scope="row">The team did</th><td set:html={c.split.team} /></tr>}
                  {c.split.others && <tr><th scope="row">Others did</th><td set:html={c.split.others} /></tr>}
                </tbody>
              </table>
            )}
            {c.heritage && (
              <aside class="heritage" aria-label={`Heritage: ${c.heritage.who}`}>
                <p class="h-bn bn">{c.heritage.bn}</p>
                <p class="h-line">{c.heritage.line} <a href={c.heritage.href} class="src">{c.heritage.who} ↗</a></p>
              </aside>
            )}
          </div>
          {c.media.length > 0 && (
            <div class:list={["figs", `n${c.media.length}`]}>
              {c.media.map((m, i) => (
                <figure class:list={[{ wide: m.wide }]}>
                  <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                  <figcaption><span class="label">Fig. {c.n}.{i + 1} · {m.tier}</span> <span set:html={m.caption} /></figcaption>
                </figure>
              ))}
            </div>
          )}
          {c.benches && c.benches.length > 0 && (
            <div class:list={["tests", `n${c.benches.length}`]}>
              {c.benches.map((b, i) => (
                <aside class="fixture" aria-label={`Test fixture: ${b.title}`}>
                  <p class="fixture-head"><span class="id">Test {c.n}.{i + 1}</span><span>{b.title}</span></p>
                  <div class="fixture-body bench-body" data-bench={b.key}><p class="mono">Loading the fixture…</p></div>
                </aside>
              ))}
            </div>
          )}
          <dl class="titleblock">
            <div class="tb-sheet"><dt>Sheet</dt><dd class="num">{pad(c.n)}</dd></div>
            <div class="tb-title"><dt>Title</dt><dd>{c.title}</dd></div>
            <div><dt>Date</dt><dd class="num">{c.when}</dd></div>
            <div><dt>Status</dt><dd>{status[c.id]}</dd></div>
            <div class="tb-note"><dt>Note</dt><dd>{c.lesson} <span class="bn" title={c.bnGloss}>{c.bn}</span></dd></div>
            {c.notes.length > 0 && <div class="tb-refs"><dt>Refs</dt><dd>{c.notes.map((n) => <a href={n.href}>{n.label}</a>)}</dd></div>}
          </dl>
        </div>
      </section>
    ))}

    <!-- Shoulders, beliefs, taste -->
    <section id="shoulders" class="sheet shoulders" aria-labelledby="sh-h">
      <div class="frame">
        <div class="sheet-text wide">
          <p class="label">Sheet {pad(chapters.length)} · references</p>
          <h2 id="sh-h">Shoulders, and what they changed</h2>
          <p class="kicker">A list of influences is a bookshelf. Each line here moved a decision in the work.</p>
        </div>
        <table class="voices">
          <thead><tr><th>Who</th><th>The idea</th><th>What it changed</th></tr></thead>
          <tbody>{voices.map((v) => (
            <tr>
              <th scope="row">{v.name}</th>
              <td><q>{v.line}</q><span class="src"> {v.href ? <a href={v.href}>{v.source}</a> : v.source}{v.paraphrase && " · paraphrase"}</span></td>
              <td>{v.changed}</td>
            </tr>
          ))}</tbody>
        </table>
        <div class="beliefs">
          <h3><span class="label">Beliefs</span> Rules I engineer by</h3>
          <ol>{beliefs.map((b, i) => <li><span class="bid num">B-{pad(i + 1)}</span><span class="bl">{b.line}</span><span class="src">{b.from}</span></li>)}</ol>
        </div>
        <div class="taste">
          <h3><span class="label">Off duty</span> What I watch, and what it smuggled in</h3>
          <ul>{taste.map((t) => <li><span class="show">{t.show}</span><q>{t.line}</q><span class="src">{t.who}</span><span class="why">{t.why}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="close" aria-labelledby="close-h">
      <h2 id="close-h">The set stays open.</h2>
      <p>New sheets get added when the machines do. The long versions (how each thing works, what was measured, what was taken back) are in the notes. Mongla's own record is at <a href={mongla.provenance.repo}>mongla_ws</a>, {mongla.provenance.commits.toLocaleString("en-US")} commits and counting.</p>
      <p class="actions"><a class="btn-line solid" href="/notes">Read the notes</a> <a class="btn-line" href="/log">The log</a> <a class="btn-line" href={`mailto:${person.email}`}>Write to me</a></p>
    </section>
  </main>

  <nav class="strip" aria-label="Sheets">
    <ol>{chapters.map((c) => <li><a href={`#${c.id}`} data-strip={c.n} title={c.title}>{pad(c.n)}</a></li>)}<li><a href="#shoulders" data-strip={chapters.length} title="Shoulders">{pad(chapters.length)}</a></li></ol>
  </nav>

  <dialog id="part-panel" aria-labelledby="pp-h">
    <form method="dialog"><button class="x" aria-label="Close">×</button></form>
    <p class="label pp-meta"></p>
    <h2 id="pp-h"></h2>
    <p class="pp-kicker"></p>
    <p class="pp-note mono"></p>
    <p><a class="btn-line solid pp-go" href="#">Open the sheet</a></p>
  </dialog>
</Base>

<script>
  import "../scripts/home-client.ts";
</script>

<style>
  /* Title sheet */
  .title-sheet { position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(15rem, .7fr); gap: 3rem var(--gutter); align-items: center; padding: 7rem var(--gutter) 4rem; background:
    linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 48px 48px,
    linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 48px 48px,
    radial-gradient(70% 60% at 75% 40%, #0a1736 0%, #000 70%); }
  .title-sheet::after { content: ""; position: absolute; inset: 0; background: radial-gradient(60% 70% at 30% 50%, rgb(0 0 0 / .85), transparent 75%); pointer-events: none; }
  .ts-copy, .ts-photo { position: relative; z-index: 1; }
  h1 { font-size: clamp(3rem, 7.2vw, 6.4rem); font-weight: 600; letter-spacing: -0.04em; line-height: 0.95; margin: .5rem 0 .4rem; }
  .role { font: 500 clamp(1.1rem, 1.6vw, 1.35rem) var(--sans); color: var(--accent); margin-bottom: 1.4rem; }
  .lede { font: 400 1.2rem/1.6 var(--serif); color: #dfe3ec; max-width: 52ch; }
  .tb { display: grid; margin: 1.8rem 0 0; border-top: 1px solid var(--line-2); max-width: 44rem; }
  .tb div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--line); }
  .tb dt { font: 500 .7rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--faint); padding-top: .2rem; }
  .tb dd { margin: 0; font-size: .95rem; color: var(--chalk); }
  .actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .ts-photo { margin: 0; justify-self: end; width: min(100%, 24rem); }
  .ts-photo img { aspect-ratio: 9 / 13; object-fit: cover; object-position: 50% 62%; border: 1px solid var(--line-2); border-radius: 0; }
  .ts-photo::before, .ts-photo::after { content: ""; position: absolute; width: 22px; height: 22px; border: 2px solid var(--accent); }
  .ts-photo::before { top: -8px; left: -8px; border-right: 0; border-bottom: 0; }
  .ts-photo::after { bottom: 2.2rem; right: -8px; border-left: 0; border-top: 0; }

  /* View 01 */
  .view { padding: 2rem var(--gutter) 4rem; max-width: 92rem; margin: 0 auto; }
  .view-body { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; }
  .viewport { position: relative; aspect-ratio: 16 / 9; background:
    linear-gradient(#0b1530 1px, transparent 1px) 0 0 / 32px 32px,
    linear-gradient(90deg, #0b1530 1px, transparent 1px) 0 0 / 32px 32px, #02050d; border-right: 1px solid var(--line-2); }
  #assembly { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; }
  .balloons { position: absolute; inset: 0; pointer-events: none; }
  .parts { list-style: none; margin: 0; padding: .4rem 0; overflow: auto; max-height: 100%; }
  .parts button { width: 100%; display: grid; grid-template-columns: 2rem 1fr; gap: .1rem .6rem; text-align: left; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; padding: .55rem .9rem; background: transparent; }
  .parts button:hover, .parts button.lit { background: #0b1530; color: var(--chalk); }
  .parts button.lit .pn { background: var(--accent); color: #fff; }
  .pn { grid-row: span 2; font: 500 .72rem var(--mono); color: var(--accent); border: 1px solid var(--accent); width: 1.7rem; height: 1.7rem; display: grid; place-items: center; border-radius: 50%; }
  .pt { font: 500 .85rem var(--sans); color: var(--chalk); }
  .pw { color: var(--faint); font-size: .7rem; }

  /* Index */
  .index { padding: 3rem var(--gutter) 2rem; max-width: 92rem; margin: 0 auto; }
  .index h2 { display: flex; gap: 1rem; align-items: baseline; font-size: var(--s4); }
  .index td a { text-decoration: none; font-family: var(--sans); font-size: .95rem; }
  .st { font: 500 .66rem var(--mono); letter-spacing: .08em; color: var(--dim); border: 1px solid var(--line-2); padding: .1rem .4rem; }

  /* Sheets */
  .sheet { padding: 3rem var(--gutter); max-width: 92rem; margin: 0 auto; scroll-margin-top: 4rem; }
  .frame { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: "text figs" "tests tests" "tb tb"; gap: 2.4rem 3rem; border: 1px solid var(--line-2); padding: 2.6rem 2.6rem 0; background: linear-gradient(180deg, #030713, #000 60%); }
  .grid-marks { position: absolute; inset: 0; pointer-events: none; }
  .grid-marks span { position: absolute; left: -1.6rem; font: 500 .62rem var(--mono); color: var(--faint); }
  .grid-marks span:nth-child(1) { top: 12%; } .grid-marks span:nth-child(2) { top: 37%; } .grid-marks span:nth-child(3) { top: 62%; } .grid-marks span:nth-child(4) { top: 87%; }
  .sheet-text { grid-area: text; }
  .sheet-text.wide { grid-column: 1 / -1; }
  .sheet h2 { font-size: clamp(1.9rem, 3.4vw, 3rem); margin-top: .4rem; }
  .kicker { font: italic 400 clamp(1.15rem, 1.6vw, 1.4rem)/1.35 var(--serif); color: var(--dim); border-left: 2px solid var(--accent); padding-left: .9rem; max-width: 44ch; }
  .body { font: 400 1.08rem/1.72 var(--serif); color: #dde1ea; }
  .resp { margin-top: 1.6rem; font-family: var(--sans); }
  .resp caption { text-align: left; padding-bottom: .5rem; }
  .resp th { width: 8.5rem; font-family: var(--mono); color: var(--accent); }
  .resp td { font-size: .92rem; color: #d3d8e3; }
  .figs { grid-area: figs; display: grid; gap: 1.4rem; align-content: start; }
  .figs.n2, .figs.n3 { grid-template-columns: 1fr 1fr; }
  .figs.n3 figure:first-child, .figs figure.wide { grid-column: 1 / -1; }
  .figs figure { margin: 0; }
  .figs img { border: 1px solid var(--line-2); max-height: 30rem; object-fit: cover; }
  .figs figcaption .label { display: block; color: var(--accent); margin-bottom: .2rem; }
  .tests { grid-area: tests; display: grid; gap: 1.6rem; }
  .tests.n1 .fixture { max-width: 50rem; }
  .tests.n2 { grid-template-columns: 1fr 1fr; }
  .titleblock { grid-area: tb; display: grid; grid-template-columns: 5rem 2fr 1fr 1fr; margin: 0 -2.6rem; border-top: 1px solid var(--line-2); }
  .titleblock div { padding: .6rem 1rem; border-right: 1px solid var(--line); }
  .titleblock div:last-child { border-right: 0; }
  .titleblock .tb-note, .titleblock .tb-refs { grid-column: 1 / -1; border-top: 1px solid var(--line); border-right: 0; display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding-left: 1rem; }
  .titleblock dt { font: 500 .62rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--faint); }
  .titleblock dd { margin: .15rem 0 0; font-size: .9rem; color: var(--chalk); }
  .titleblock .tb-sheet dd { font-size: 1.6rem; color: var(--accent); line-height: 1; }
  .titleblock .tb-note dd { font: italic 400 1rem var(--serif); color: var(--dim); }
  .titleblock .bn { color: var(--faint); margin-left: .5rem; font-style: normal; }
  .titleblock .tb-refs dd { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; font-family: var(--mono); font-size: .78rem; }

  /* Shoulders */
  .shoulders .frame { grid-template-areas: none; grid-template-columns: 1fr 1fr; padding-bottom: 2.6rem; }
  .voices { grid-column: 1 / -1; font-family: var(--sans); font-size: .9rem; }
  .voices th[scope="row"] { color: var(--chalk); font: 500 .9rem var(--sans); text-transform: none; letter-spacing: 0; width: 11rem; }
  .voices q { font: italic 400 1rem var(--serif); color: #e2e6ef; }
  .voices td:last-child { color: var(--dim); }
  .beliefs ol, .taste ul { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .1rem; }
  .beliefs li { display: grid; grid-template-columns: 3.4rem 1fr; gap: .1rem .8rem; padding: .6rem 0; border-bottom: 1px solid var(--line); }
  .bid { color: var(--accent); font-size: .78rem; grid-row: span 2; }
  .bl { font: 400 1rem/1.5 var(--serif); }
  .taste li { display: grid; gap: .15rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
  .show { font: 500 .7rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .taste q { font: italic 400 1rem var(--serif); }
  .why { color: var(--dim); font-size: .9rem; }
  .shoulders h3 { display: flex; gap: .8rem; align-items: baseline; font-size: 1.15rem; }

  .close { padding: 6rem var(--gutter) 7rem; max-width: 56rem; margin: 0 auto; }
  .close h2 { font-size: clamp(2rem, 4vw, 3.2rem); }
  .close p { font: 400 1.1rem/1.65 var(--serif); }

  dialog#part-panel { border: 1px solid var(--line-2); border-top: 3px solid var(--accent); border-radius: 0; background: var(--sheet); color: var(--chalk); max-width: 32rem; padding: 1.6rem 1.8rem; }
  dialog#part-panel::backdrop { background: rgb(0 0 0 / .65); }
  dialog .x { position: absolute; top: .6rem; right: .7rem; width: 2rem; height: 2rem; padding: 0; font-size: 1.1rem; }
  .pp-kicker { font: italic 400 1.15rem/1.35 var(--serif); color: var(--dim); }
  .pp-note { color: var(--dim); }


  /* Contact sheet */
  .contact { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 1.6rem 1.2rem; }
  .contact a { display: grid; gap: .35rem; text-decoration: none; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--line-2); background: #02050d; }
  .thumb img, .thumb svg { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(.55) brightness(.8) contrast(1.05); transition: filter .25s, transform .4s var(--ease); }
  .tn { position: absolute; left: 0; top: 0; font: 500 .72rem var(--mono); background: #000; color: var(--chalk); padding: .2rem .45rem; border-right: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); }
  .contact a:hover .thumb, .contact a:focus-visible .thumb { border-color: var(--accent); }
  .contact a:hover img, .contact a:hover svg, .contact a:focus-visible img { filter: none; transform: scale(1.03); }
  .contact a:hover .tn { background: var(--accent); color: #fff; }
  .tt { font: 500 .95rem var(--sans); color: var(--chalk); }
  .tw { color: var(--faint); font-size: .68rem; letter-spacing: .04em; }
  .keys { color: var(--faint); margin-top: 1.4rem; }
  kbd { font: 500 .72rem var(--mono); border: 1px solid var(--line-2); border-bottom-width: 2px; padding: .05rem .35rem; color: var(--chalk); }

  /* Heritage: one line of Bangladesh's engineering past, set beside the work */
  .heritage { margin-top: 1.8rem; display: grid; grid-template-columns: auto 1fr; gap: .4rem 1.1rem; align-items: baseline; border-top: 1px solid var(--line-2); padding-top: 1rem; }
  .h-bn { margin: 0; color: var(--accent); font-size: 1.15rem; white-space: nowrap; }
  .h-line { margin: 0; font: italic 400 .98rem/1.6 var(--serif); color: var(--dim); }
  .h-line .src { font-style: normal; margin-left: .3rem; }

  /* Sticky sheet strip */
  .strip { position: fixed; right: calc(var(--gutter) * .35); top: 50%; transform: translateY(-50%); z-index: 30; opacity: 0; pointer-events: none; transition: opacity .3s; }
  :global(body.scrolled) .strip { opacity: 1; pointer-events: auto; }
  .strip ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .strip a { display: block; font: 500 .62rem var(--mono); color: var(--faint); text-decoration: none; padding: .2rem .35rem; border-right: 2px solid var(--line-2); text-align: right; }
  .strip a:hover { color: var(--chalk); border-right-color: var(--blue); }

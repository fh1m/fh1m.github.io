---
/**
 * Home: Voyager's last photograph, a fall into the dot, and a tiny planet holding the machines I
 * built for air, water, land and silicon. Bunnu is the guide; the world loads while the opening plays.
 */
import Base from "../layouts/Base.astro";
import Opening from "../components/game/Opening.astro";
import Panels from "../components/game/Panels.astro";
import { ZONE_INFO } from "../game/zones";
import { projects } from "../data/elements";
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const keys: Record<string, string> = { air: "1", water: "2", earth: "3", fire: "4" };
---
<Base chrome={false} bodyClass="game" description="Fahim Faisal's robotics work as a small planet: rockets, underwater vehicles, rovers and edge AI, each with the failure that taught something and the commit that fixed it.">
  <main id="main" class="game-shell">
    <img class="poster-img" src="/world/poster.webp" alt="The planet from orbit: a sandy airfield cap under clouds at the top, green land with a brown patch of earth, a blue sea along one side, and small landmarks around the rim. Every place on it can be opened from the buttons below." width="1600" height="1000" />
    <canvas id="world" aria-label="A tiny planet with four zones: air, water, earth and fire. Choose a zone to send Bunnu there, or click anything on the planet."></canvas>

    <div class="title" id="title" aria-live="polite">
      <p class="els"><span style="--c:#eaa63b">Air.</span> <span style="--c:#4f8fe0">Water.</span> <span style="--c:#79b35f">Earth.</span> <span style="--c:#e5533d">Silicon.</span></p>
      <p class="line">Four places a machine can fail. These are the machines I built for each, what broke, and what fixed it.</p>
      <p class="meet">Bunnu is your guide. She watched all of it get built, and she'll tell you why it was built that way.</p>
    </div>

    <nav class="zones" id="zones" aria-label="Zones">
      {ZONE_INFO.map((z) => <button type="button" data-zone={z.id} style={`--c:${z.colour}`} aria-keyshortcuts={keys[z.id]}><span class="n">{z.name}</span><span class="bn" lang="bn">{z.bn}</span></button>)}
      <button type="button" data-zone="" class="all" aria-keyshortcuts="0">The whole planet</button>
    </nav>

    {ZONE_INFO.map((z) => (
      <aside class="plate" data-plate={z.id} style={`--c:${z.colour}`} aria-labelledby={`plate-${z.id}`}>
        <p class="kicker"><span class="bn" lang="bn">{z.bn}</span> {z.name}</p>
        <h2 id={`plate-${z.id}`}>{z.form}</h2>
        <p class="pline">{z.line}</p>
        <dl>{z.specs.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
        <p class="real">{z.real} <a href={z.source.href}>{z.source.label}</a></p>
        <div class="mission" data-mission-box={z.id}><p class="mission-row"><button type="button" class="start" data-mission={z.id}>Try the mission</button>{z.id === "air" && <span class="here">Start here, it's where the work started</span>}</p></div>
        <p class="things-h">Things here</p>
        <ul class="things">{z.objects.map((o) => <li><button type="button" data-focus={o}>{bySlug[o].title}</button></li>)}</ul>
      </aside>
    ))}

    <Panels />
    <p class="guide" id="guide" aria-live="polite"><span class="who">Bunnu</span> <span id="guide-say"></span></p>
    <p class="tip" id="tip" aria-hidden="true"></p>

    <div class="hud">
      <details class="places">
        <summary>Places</summary>
        <ul>
          <li><button type="button" data-focus="timemachine">The time machine</button></li>
          <li><button type="button" data-focus="library">The library</button></li>
          <li><button type="button" data-focus="graveyard">My wrong ideas</button></li>
          <li><button type="button" data-focus="cv">The CV office</button></li>
          <li><button type="button" data-focus="heritage-jcbose">The delta</button></li>
          <li><button type="button" data-focus="voyager">Voyager</button></li>
        </ul>
      </details>
      <button class="snd" id="snd" type="button" aria-pressed="true">Sound</button>
      <a class="skip-game" href="/everything">Skip the game, show me everything</a>
    </div>

    <Opening />
    <noscript><p class="nojs">The planet needs JavaScript. <a href="/everything">Here is everything without it.</a></p></noscript>
  </main>
</Base>
<script>
  import { createSound } from "../game/audio";
  import { MISSIONS } from "../game/missions";
  import { startPoster, wantsPoster } from "../game/poster";
  const sfx = createSound(); sfx.scene("space");
  // the 3D planet, or (reduced motion, low-end, no WebGL2, ?poster) a still of it with the same UI on top
  const poster = wantsPoster();
  if (poster) document.getElementById("main")!.classList.add("poster");
  const worldP = poster ? Promise.resolve(startPoster()) : import("../game/main").then((m) => m.start(document.getElementById("world") as HTMLCanvasElement));
  const opening = document.getElementById("opening")!;
  const beats = [...opening.querySelectorAll<HTMLElement>(".beat")];
  const title = document.getElementById("title")!, zonesEl = document.getElementById("zones")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let i = -1, timer = 0, done = false;

  const show = (n: number) => {
    i = n; opening.dataset.beat = String(n);
    if (n === 3) sfx.shutter(); else if (n > 0) sfx.pluck(520 + n * 40);
    beats.forEach((b, k) => b.classList.toggle("on", k === n));
    clearTimeout(timer); timer = window.setTimeout(next, n === 4 ? 6500 : 5200);
  };
  const finish = async () => {
    if (done) return; done = true; clearTimeout(timer);
    opening.classList.add("gone"); setTimeout(() => opening.remove(), 1300);
    const world = await worldP; world.fallIn();
    title.classList.add("on");
    setTimeout(() => { title.classList.remove("on"); zonesEl.classList.add("on"); }, reduce ? 300 : 7000);
    const buttons = [...zonesEl.querySelectorAll<HTMLButtonElement>("button")];
    const go = (z: string) => world.go((z || null) as never);
    buttons.forEach((b) => b.addEventListener("click", () => go(b.dataset.zone ?? "")));
    const plates = [...document.querySelectorAll<HTMLElement>(".plate")];
    const panels = [...document.querySelectorAll<HTMLElement>(".objpanel")];
    const tip = document.getElementById("tip")!;
    const names: Record<string, string> = Object.fromEntries(panels.map((p) => [p.dataset.obj!, p.querySelector("h2")!.textContent!]));
    let current: string | null = null;
    const closePanel = () => { if (!panels.some((p) => p.classList.contains("on"))) return; panels.forEach((p) => p.classList.remove("on")); world.setYear(null); world.go((current || null) as never); };
    world.onObject((id) => { plates.forEach((p) => p.classList.remove("on")); title.classList.remove("on"); panels.forEach((p) => p.classList.toggle("on", p.dataset.obj === id)); panels.find((p) => p.dataset.obj === id)?.querySelector<HTMLElement>(".close")?.focus({ preventScroll: true }); });
    world.onHover((id, x, y) => { tip.textContent = id ? names[id] ?? "" : ""; tip.classList.toggle("on", !!id); tip.style.transform = `translate(${x + 16}px, ${y + 14}px)`; });
    document.querySelectorAll<HTMLButtonElement>("[data-focus]").forEach((b) => b.addEventListener("click", () => world.focus(b.dataset.focus!)));
    panels.forEach((p) => p.querySelector(".close")!.addEventListener("click", closePanel));
    addEventListener("keydown", (e) => { if (e.key === "Escape") closePanel(); });
    // Bunnu narrates (a caption, not a chat); missions run inside the zone's own plate
    const guide = document.getElementById("guide")!, gsay = document.getElementById("guide-say")!;
    let hideGuide = 0;
    const speak = (text: string) => {
      gsay.textContent = text; guide.classList.remove("on"); void guide.offsetWidth; guide.classList.add("on");
      clearTimeout(hideGuide); hideGuide = window.setTimeout(() => guide.classList.remove("on"), Math.max(6000, text.split(" ").length * 420));
    };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> & { className?: string } = {}, kids: (Node | string)[] = []) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
    const finished = new Set<string>(JSON.parse(localStorage.getItem("missions-done") ?? "[]"));
    const markDone = () => buttons.forEach((b) => { if (finished.has(b.dataset.zone ?? "")) b.dataset.done = "1"; });
    markDone();
    const ORDER: Record<string, number[]> = { air: [0, 2, 1], water: [1, 2, 0], earth: [2, 0, 1], fire: [0, 2, 1] };
    const boxes = new Map([...document.querySelectorAll<HTMLElement>("[data-mission-box]")].map((b) => [b.dataset.missionBox!, b]));
    const initial = new Map([...boxes].map(([k, b]) => [k, b.innerHTML]));
    const endMission = () => { world.setMode("idle"); plates.forEach((p) => p.classList.remove("in-mission")); boxes.forEach((b, k) => { b.innerHTML = initial.get(k)!; b.querySelector<HTMLButtonElement>("[data-mission]")!.onclick = () => run(k); }); };
    function run(zone: string) {
      greeted = true; clearTimeout(greet);
      const m = MISSIONS.find((x) => x.zone === zone)!, box = boxes.get(zone)!, plate = box.closest(".plate")!;
      panels.forEach((p) => p.classList.remove("on")); plate.classList.add("in-mission");
      world.setMode("idle"); speak(m.setup);
      box.replaceChildren(el("h3", { textContent: m.title }), el("p", { className: "m-text", textContent: m.setup }), el("p", { className: "mission-row" }, [el("button", { type: "button", className: "start", textContent: "Run it", onclick: fail })]));
      function fail() {
        world.setMode("fail"); speak(m.fail);
        const list = el("ol", { className: "hyps" }, ORDER[zone].map((k) => { const h = m.hypotheses[k]; const b = el("button", { type: "button", textContent: h.text }); b.onclick = () => pick(h, b); return el("li", {}, [b]); }));
        box.replaceChildren(el("h3", { textContent: m.title }), el("p", { className: "m-text obs", textContent: m.fail }), el("p", { className: "m-q", textContent: "What would you check first?" }), list);
      }
      function pick(h: (typeof m.hypotheses)[number], b: HTMLButtonElement) {
        if (b.getAttribute("aria-disabled") === "true") return;
        b.setAttribute("aria-disabled", "true");
        if (!h.right) { b.classList.add("struck"); b.after(el("p", { className: "reply", textContent: h.reply })); world.setMode("wrong"); speak(h.reply); setTimeout(() => world.setMode("fail"), 2600); return; }
        world.setMode("fixed"); speak(m.bunnu);
        finished.add(zone); localStorage.setItem("missions-done", JSON.stringify([...finished])); markDone();
        const kids: Node[] = [el("h3", { textContent: m.title }), el("p", { className: "m-text obs", textContent: h.reply }), el("p", { className: "m-text", textContent: m.fix })];
        if (m.numbers) kids.push(el("p", { className: "nums", textContent: m.numbers }));
        kids.push(el("p", { className: "mission-row" }, [el("a", { className: "start", href: m.report, textContent: "Read the after-action report" }), el("a", { className: "ghost", href: m.ref.href, textContent: m.ref.label }), el("button", { type: "button", className: "ghost", textContent: "Done", onclick: endMission })]));
        box.replaceChildren(...kids);
      }
    }
    document.querySelectorAll<HTMLButtonElement>("[data-mission]").forEach((b) => (b.onclick = () => run(b.dataset.mission!)));
    world.onZone((z) => { endMission(); if (z) greeted = true; });
    let greeted = false;
    const greet = window.setTimeout(() => { if (!greeted) speak("Pick a place below, or click anything on the planet. Air is where the work started, in 2024."); }, reduce ? 400 : 7600);

    // the time machine
    const tmRange = document.getElementById("tm-year") as HTMLInputElement | null, tmAge = document.getElementById("tm-age")!;
    const tmYears = [...document.querySelectorAll<HTMLElement>(".tm-year")];
    const setTM = () => {
      if (!tmRange) return;
      const i = +tmRange.value, el = tmYears[i], y = el.dataset.y === "now" ? null : +el.dataset.y!;
      tmYears.forEach((t, k) => (t.hidden = k !== i)); world.setYear(y);
      const back = y === null ? 0 : 2026 - y;
      tmAge.textContent = back === 0 ? "Now: everything built so far is on the planet." : `${y}: anything built after this is gone from the planet.`;
    };
    tmRange?.addEventListener("input", setTM); setTM();
    world.onObject((id) => { if (id !== "timemachine" && tmRange && tmRange.value !== tmRange.max) { tmRange.value = tmRange.max; setTM(); } });
    world.onZone((z) => { current = z; panels.forEach((p) => p.classList.remove("on")); buttons.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.zone || null) === z))); title.classList.remove("on"); plates.forEach((p) => p.classList.toggle("on", p.dataset.plate === z)); });
    addEventListener("keydown", (e) => { const k = "01234".indexOf(e.key); if (k >= 0) go(["", "air", "water", "earth", "fire"][k]); });
    const snd = document.getElementById("snd")!;
    snd.setAttribute("aria-pressed", String(world.sound.on()));
    snd.addEventListener("click", () => snd.setAttribute("aria-pressed", String(world.sound.toggle())));
  };
  const next = () => (i < beats.length - 1 ? show(i + 1) : finish());
  document.getElementById("op-next")?.addEventListener("click", next);
  document.getElementById("op-skip")?.addEventListener("click", finish);
  opening.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest("button")) next(); });
  addEventListener("keydown", (e) => { if (done) return; if (e.key === "Enter" || e.key === " ") { e.preventDefault(); next(); } if (e.key === "Escape") finish(); });
  if (sessionStorage.getItem("seen-opening")) finish(); else { sessionStorage.setItem("seen-opening", "1"); show(0); }
</script>
<style>
  :global(body.game) { overflow: hidden; background: #000; }
  .game-shell { position: fixed; inset: 0; }
  #world { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .game-shell::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / .55) 100%); }
  .title { position: absolute; z-index: 3; left: clamp(1.4rem, 5vw, 4rem); bottom: 7.5rem; width: min(30rem, 86vw); opacity: 0; transform: translateY(10px); transition: opacity 1.2s ease, transform 1.2s ease; pointer-events: none; font-family: var(--sans); }
  .title:global(.on) { opacity: 1; transform: none; }
  .els { margin: 0 0 .7rem; font: 600 var(--t2) var(--sans); display: flex; gap: .9rem; flex-wrap: wrap; letter-spacing: .01em; }
  .els span { color: var(--c); }
  .line { font: 600 var(--t1)/1.5 var(--sans); color: #fff; margin: 0 0 .6rem; text-shadow: 0 2px 14px #000; }
  .meet { font: 500 var(--t0) var(--sans); color: #c8c8c8; margin: 0; }
  .zones { position: absolute; z-index: 3; left: 50%; bottom: 1.6rem; transform: translate(-50%, 20px); display: flex; gap: .5rem; flex-wrap: wrap; justify-content: center; opacity: 0; transition: opacity .8s ease, transform .8s ease; pointer-events: none; }
  .zones:global(.on) { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .zones button { display: grid; justify-items: center; gap: .15rem; min-width: 6.2rem; padding: .65rem 1.1rem .55rem; border: 0; border-radius: 8px; background: rgb(255 255 255 / .1); color: #fff; cursor: pointer; font: 500 var(--t0) var(--sans); transition: background .25s, transform .25s cubic-bezier(.2,.8,.3,1.3); backdrop-filter: blur(6px); }
  .zones button .bn { font: 400 var(--t-2) var(--bangla); color: var(--c); opacity: .85; }
  .zones button:hover { background: rgb(255 255 255 / .18); transform: translateY(-2px); }
  .zones button[aria-pressed="true"] { background: var(--c); color: #000; }
  .zones button[aria-pressed="true"] .bn { color: #000; }
  .zones .all { align-self: stretch; color: #c8c8c8; font-size: var(--t-1); }
  .hud { position: absolute; z-index: 4; top: 1rem; right: 1.2rem; display: flex; gap: .6rem; }
  .snd { font: 500 var(--t-1) var(--sans); color: #fff; background: rgb(255 255 255 / .12); border: 0; border-radius: 6px; padding: .45rem .9rem; cursor: pointer; }
  .snd[aria-pressed="false"] { text-decoration: line-through; opacity: .7; }
  .skip-game { font: 500 var(--t-1) var(--sans); color: #000; background: #fff; border-radius: 6px; padding: .45rem .9rem; text-decoration: none; }
  .plate { position: absolute; z-index: 3; right: clamp(1rem, 3vw, 2.4rem); top: 50%; width: min(24rem, 88vw); transform: translate(24px, -50%); opacity: 0; pointer-events: none; padding: 1.2rem 1.3rem 1.1rem; border-radius: 10px; background: rgb(10 10 12 / .9); border: 1px solid #262626; backdrop-filter: blur(10px); color: #ececec; font-family: var(--sans); transition: opacity .6s ease .5s, transform .6s cubic-bezier(.2,.8,.3,1) .5s; }
  .plate:global(.on) { opacity: 1; transform: translate(0, -50%); pointer-events: auto; }
  .plate .kicker { margin: 0 0 .2rem; font: 600 var(--t-1) var(--sans); color: var(--c); }
  .plate .bn { font-family: var(--bangla); font-weight: 400; }
  .plate h2 { font: 600 var(--t2)/1.2 var(--sans); color: #fff; margin: 0 0 .6rem; }
  .pline { font: 500 var(--t0)/1.5 var(--sans); color: #d0d0d0; margin: 0 0 .9rem; }
  .plate dl { display: grid; grid-template-columns: auto 1fr; gap: .3rem .9rem; margin: 0 0 .9rem; padding: .7rem .8rem; border-radius: 6px; background: rgb(255 255 255 / .06); }
  .plate dt { font: 600 var(--t-2) var(--sans); color: #8c8c8c; }
  .plate dd { margin: 0; font: 400 var(--t-1) var(--mono); color: #fff; font-variant-numeric: tabular-nums; }
  .real { font: 500 var(--t-2)/1.5 var(--sans); color: #8c8c8c; margin: 0; }
  .real a { color: #fff; }
  @media (max-width: 760px) { .plate { top: auto; bottom: 6.5rem; transform: translate(0, 20px); max-height: 46svh; overflow: auto; } .plate:global(.on) { transform: none; } }
  .poster-img { display: none; }
  .poster .poster-img { display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .poster #world { display: none; }
  .mission-row { display: flex; align-items: center; gap: .6rem; margin: .9rem 0 0; }
  .mission :global(.start), .mission :global(.ghost) { display: inline-block; font: 600 var(--t-1) var(--sans); color: #000; background: var(--c); border: 0; border-radius: 6px; padding: .55rem 1.1rem; cursor: pointer; text-decoration: none; transition: transform .12s; }
  .mission :global(.ghost) { background: rgb(255 255 255 / .1); color: #fff; box-shadow: none; }
  .mission :global(.mission-row) { flex-wrap: wrap; }
  .mission :global(h3) { font: 600 var(--t1) var(--sans); color: #fff; margin: 1rem 0 .4rem; }
  .mission :global(.m-text) { font: 500 var(--t-1)/1.6 var(--sans); color: #e2e2e2; margin: 0 0 .6rem; }
  .mission :global(.obs) { color: #fff; font-weight: 600; }
  .mission :global(.m-q) { font: 600 var(--t-1) var(--sans); color: var(--c); margin: .8rem 0 .5rem; }
  .mission :global(.hyps) { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .mission :global(.hyps button) { width: 100%; text-align: left; font: 600 var(--t-1)/1.45 var(--sans); color: #fff; background: rgb(255 255 255 / .07); border: 1px solid rgb(255 255 255 / .12); border-radius: 6px; padding: .6rem .8rem; cursor: pointer; }
  .mission :global(.hyps button:hover:not([aria-disabled="true"])) { border-color: var(--c); }
  .mission :global(.hyps button.struck) { color: #8c8c8c; text-decoration: line-through; text-decoration-color: #ff6b5b; text-decoration-thickness: 2px; cursor: default; }
  .mission :global(.reply) { font: 500 var(--t-2)/1.5 var(--sans); color: #c8c8c8; margin: .35rem .2rem 0; }
  .mission :global(.nums) { font: 400 var(--t-2)/1.6 var(--mono); color: #8dff6a; margin: 0 0 .6rem; }
  .plate:global(.in-mission) .pline, .plate:global(.in-mission) dl, .plate:global(.in-mission) .real, .plate:global(.in-mission) .things-h, .plate:global(.in-mission) .things { display: none; }
  .guide { position: absolute; z-index: 6; left: 50%; bottom: 5.6rem; width: min(44rem, 90vw); transform: translate(-50%, 8px); margin: 0; text-align: center; font: 400 var(--t0)/1.5 var(--sans); color: #fff; text-shadow: 0 2px 10px rgb(0 0 0 / .8), 0 0 2px rgb(0 0 0 / .9); opacity: 0; transition: opacity .6s ease, transform .6s ease; pointer-events: none; }
  .guide.on { opacity: 1; transform: translate(-50%, 0); }
  .guide .who { color: #ff9ec2; font-weight: 600; margin-right: .3rem; }
  .start:active { transform: translateY(3px); box-shadow: 0 1px 0 rgb(0 0 0 / .25); }
  .here { font: 500 var(--t-2) var(--sans); color: var(--c); }
  .zones button[data-done]::after { content: ""; position: absolute; top: .35rem; right: .45rem; width: .45rem; height: .45rem; border-radius: 50%; background: #8dff6a; box-shadow: 0 0 6px #8dff6a; }
  .zones button { position: relative; }
  .things-h { margin: .9rem 0 .4rem; font: 600 var(--t-2) var(--sans); color: #8c8c8c; }
  .things { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .things button, .voy { font: 500 var(--t-1) var(--sans); color: #fff; background: rgb(255 255 255 / .12); border: 0; border-radius: 6px; padding: .4rem .85rem; cursor: pointer; }
  .things button:hover { background: var(--c); color: #000; }
  .tip { position: absolute; left: 0; top: 0; z-index: 6; margin: 0; pointer-events: none; font: 600 var(--t-1) var(--sans); color: #000; background: #fff; border-radius: 6px; padding: .3rem .75rem; opacity: 0; transition: opacity .15s; }
  .tip:global(.on) { opacity: 1; }
  .places { position: relative; }
  .places summary { list-style: none; font: 500 var(--t-1) var(--sans); color: #fff; background: rgb(255 255 255 / .12); border-radius: 6px; padding: .45rem .9rem; cursor: pointer; }
  .places summary::-webkit-details-marker { display: none; }
  .places ul { position: absolute; right: 0; top: 2.6rem; list-style: none; margin: 0; padding: .4rem; display: grid; gap: .2rem; min-width: 12rem; border-radius: 8px; background: rgb(9 14 44 / .92); backdrop-filter: blur(10px); }
  .places ul button { width: 100%; text-align: left; font: 500 var(--t-1) var(--sans); color: #fff; background: none; border: 0; border-radius: .6rem; padding: .45rem .7rem; cursor: pointer; }
  .places ul button:hover { background: rgb(255 255 255 / .12); }
  .nojs { position: absolute; inset: auto 1rem 1rem; z-index: 12; color: #fff; }
</style>

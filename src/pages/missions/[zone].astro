---
/**
 * After-action reports, one per mission: the report in the main column (what was planned, what
 * happened, why, what fixed it, what to keep and what to change), and a notebook margin
 * (Bunnu's note, the line from someone who said it first, a real picture).
 */
import Base from "../../layouts/Base.astro";
import Schematic from "../../components/game/Schematic.astro";
import Explore from "../../components/note/Explore.astro";
import { MISSIONS, type Mission } from "../../game/missions";
import { ZONE_INFO } from "../../game/zones";
import { lessons } from "../../data/lessons";
import { projects } from "../../data/elements";
import { dims } from "../../data/media";

// the failure, reproducible: one explorable per mission
const TRY: Record<string, { id?: string; bench?: string; title: string; hint: string }> = {
  air: { id: "filter", title: "The 2024 estimator, with and without memory", hint: "pick an estimator, drag the gyro weight" },
  water: { id: "fossil", title: "What a full camera queue actually holds", hint: "drag the stall and pick a policy" },
  earth: { bench: "ebhapa", title: "E-Bhapa as flashed in 2024, and as fixed", hint: "watch both run" },
  fire: { id: "liveness", title: "Alive is not working", hint: "pick a monitoring policy" },
};
const LINK: Record<string, { lesson: string; project: string; photo?: [string, string] }> = {
  air: { lesson: "a-filter-with-no-memory", project: "gimbal" },
  water: { lesson: "a-mailbox-not-a-queue", project: "mongla", photo: ["/media/lab/latency-verdict.webp", "Measured on live hardware, both cameras: the verdict is the one you want."] },
  earth: { lesson: "uint8-and-the-polite-crawl", project: "e-bhapa", photo: ["/media/e-bhapa/e-bhapa-upright.webp", "E-Bhapa: one ultrasonic sensor and a lot of confidence."] },
  fire: { lesson: "a-detector-with-no-model", project: "mongla", photo: ["/media/mongla-docs/cores.webp", "Mongla's compute, core by core."] },
};
export const getStaticPaths = () => MISSIONS.map((m) => ({ params: { zone: m.zone }, props: { m } }));
const { m } = Astro.props as { m: Mission };
const z = ZONE_INFO.find((x) => x.id === m.zone)!;
const L = LINK[m.zone], ex = TRY[m.zone];
const lesson = lessons.find((l) => l.slug === L.lesson)!;
const project = projects.find((p) => p.slug === L.project)!;
const photo = L.photo ? { src: L.photo[0], cap: L.photo[1], ...dims(L.photo[0]) } : null;
const i = MISSIONS.indexOf(m), next = MISSIONS[(i + 1) % MISSIONS.length];
---
<Base title={`After-action report: ${m.title}`} description={lesson.lesson} bodyClass="planet-page" crumb={{ href: "/missions/air", label: `Mission ${i + 1} of 4`, bn: z.bn }} progress>
  <main id="main" class="aar" style={`--c:${z.colour}`}>
    <header>
      <p class="kick"><span class="bn" lang="bn">{z.bn}</span> {z.name}, mission {i + 1} of 4, after-action report</p>
      <h1>{m.title}</h1>
      <p class="dek">{lesson.lesson}</p>
    </header>
    <div class="aar-grid">
      <article class="report">
        <Schematic zone={m.zone} />
        <section><h2>The mission</h2><p>{((s) => s.charAt(0).toUpperCase() + s.slice(1))(m.setup.replace(/^Mission \w+: /, ""))}</p></section>
        <section><h2>What happened</h2><p>{lesson.driving}</p><p class="obs">{m.fail}</p></section>
        <section><h2>What I believed</h2><p class="wrong">{lesson.believed}</p>
          <ul class="tried">{m.hypotheses.filter((h) => !h.right).map((h) => <li><span class="wrong">{h.text}</span> <span class="why">{h.reply}</span></li>)}</ul>
        </section>
        <section><h2>What was true</h2><p>{lesson.truth}</p></section>
        <section class="try"><h2>Try it yourself</h2><Explore id={ex.id} bench={ex.bench} title={ex.title} hint={ex.hint} /></section>
        <section><h2>The fix</h2><p>{m.fix}</p>{m.numbers && <p class="nums">{m.numbers}</p>}<p class="ev">Evidence: {lesson.refs.map((r, k) => <>{k > 0 && ", "}<a href={r.href} class:list={{ h: r.href.includes("/commit/") }}>{r.label}</a></>)}</p></section>
        <section class="two"><div><h2>Keep doing</h2><p>{lesson.lesson}</p></div><div><h2>Do differently</h2><p>{lesson.recommendation}</p></div></section>
      </article>
      <aside class="aar-margin" aria-label="Context, source images and related work">
        <div class="note bunnu"><p class="who">Bunnu, on what he kept</p><p>{m.bunnu}</p></div>
        {photo && <figure class="note photo"><a href={photo.src} target="_blank" rel="noreferrer" aria-label={`Open full-size image: ${photo.cap}`}><img src={photo.src} alt={photo.cap} width={photo.w} height={photo.h} loading="lazy" /></a><figcaption>{photo.cap}<span class="image-hint">Open image to inspect at full size.</span></figcaption></figure>}
        <div class="note"><p class="who">Where this lives</p><p><a href={`/projects/${project.slug}`}>{project.title}</a>. {project.line}</p><p><a href={`/lessons/${lesson.slug}`}>The lesson, in NASA's format</a></p></div>
      </aside>
    </div>
    <p class="nextr"><a class="pill" href={`/missions/${next.zone}`}>Next report: {next.title}</a></p>
  </main>
</Base>
<style>
  :global(body.planet-page) { background:var(--page); color:var(--ink); }
  .aar { max-width:var(--page-width); margin:0 auto; padding:var(--section-gap) var(--gutter) 2rem; font-family:var(--sans); }
  .nextr { margin:1.5rem 0 0; }
  .kick { margin: 0 0 .5rem; font: 500 var(--t-1) var(--sans); color: var(--c); }
  .bn { font-family: var(--bangla); font-weight: 400; }
  h1 { font:600 clamp(1.75rem,2.5vw,2.25rem)/1.18 var(--display); color:var(--ink-hi); margin:0 0 .65rem; letter-spacing:-.01em; }
  .dek { font:400 1.0625rem/1.55 var(--sans); color:var(--ink); max-width:72ch; margin:0 0 1.25rem; }
  .aar-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem); gap: 2.4rem; align-items: start; }
  .aar-grid > * { min-width:0; }
  .report section { margin:0 0 1.25rem; max-width:85ch; }
  .report section.try { max-width: none; }
  h2 { font: 600 var(--t1) var(--sans); color: var(--c); margin: 0 0 .4rem; }
  .report p { font:400 var(--body-size)/var(--lh) var(--sans); color:var(--ink); margin:0 0 .65rem; }
  .obs { color: #fff !important; font-weight: 700 !important; }
  .wrong { color:var(--dim); text-decoration:line-through; text-decoration-color:var(--failure); text-decoration-thickness:2px; }
  .tried { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .tried li { font: 500 var(--t-1)/1.5 var(--sans); }
  .why { display:block; color:var(--dim); }
  .nums { font:400 var(--t-1)/1.6 var(--mono)!important; color:var(--measured)!important; }
  .ev a, .note a { color:var(--action); }
  .h { font-family: var(--mono); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; max-width: none !important; }
  .aar-margin { display:grid; gap:1rem; position:sticky; top:calc(var(--header-height) + 1rem); max-height:calc(100svh - var(--header-height) - 2rem); overflow:auto; padding:.25rem; }
  .note { margin:0; padding:.9rem 1rem; border-radius:var(--r-3); background:var(--surface); font:400 var(--t-1)/1.55 var(--sans); color:var(--ink); }
  .note p { margin: 0 0 .4rem; }
  .note .who { font:500 var(--t-2) var(--sans); color:var(--action); margin-bottom:.2rem; }
  .bunnu { border-left: 2px solid var(--c); border-radius: 0 var(--r-2) var(--r-2) 0; }
  blockquote.note p { font-style: italic; color: #fff; }
  blockquote.note footer { font:400 var(--t-2)/1.5 var(--sans); color:var(--dim); }
  .photo img { width: 100%; height: auto; border-radius: var(--r-2); display: block; }
  .photo figcaption { margin-top:.5rem; font:400 var(--t-2)/1.5 var(--sans); color:var(--dim); }
  .photo a { display:block; border-radius:var(--r-2); }
  .image-hint { display:block; color:var(--action); margin-top:.35rem; }
  @media(max-width:860px) { .aar-grid { grid-template-columns:minmax(0,1fr); } .aar-margin { position:static; max-height:none; overflow:visible; } .two { grid-template-columns:minmax(0,1fr); } }
</style>

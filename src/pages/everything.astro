---
/**
 * All the work, without the planet: every project by element, the writing, and every public
 * repository. The GitHub numbers are read at build time (scripts/github-stats.mjs), never typed in.
 */
import Base from "../layouts/Base.astro";
import { elements } from "../data/elements";
import { lessons } from "../data/lessons";
import { MISSIONS } from "../game/missions";
import WorkList from "../components/WorkList.astro";
import gh from "../data/github.json";
import { getCollection } from "astro:content";
const notes = await getCollection("notes");
const repoSummaries = new Map(notes.filter((note) => note.data.kind === "project" && note.data.repo).map((note) => [note.data.repo!.toLowerCase(), note.data.dek] as const));
const repos = [...gh.repos].sort((a, b) => a.createdAt.localeCompare(b.createdAt));
const ago = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---
<Base title="All the work" description="Every project by Fahim Faisal, grouped by where it has to work: air, water, land and silicon. The writing, the lessons, and every public repository.">
  <main id="main" class="screens">
    <header class="screen">
      <div class="measure">
        <h1 class="s-h1">All the work</h1>
        <p class="s-dek">Machines that have to work on their own: in the air, under water, on land and on small chips. Each one links to what broke and what fixed it.</p>
        <p class="s-txt archive-intro">The machines are only part of it. The small tools, early experiments and unfinished ideas are here too.</p>
        <nav class="index-paths" aria-label="Other ways through the archive"><a href="/log">The life behind the projects</a><a href="/about">Experience, press and papers</a><a href="#h-r">Including the small and unfinished repositories</a></nav>
      </div>
    </header>

    {elements.map((el) => (
      <section class="screen" style={`--c:${el.colour}`} aria-labelledby={`h-${el.id}`}>
        <h2 class="s-h2" id={`h-${el.id}`}><span class="bn" lang="bn">{el.bn}</span> {el.name}</h2>
        <WorkList projects={el.projects} />
      </section>
    ))}

    <section class="screen" aria-labelledby="h-w">
      <h2 class="s-h2" id="h-w">The writing</h2>
      <ul class="trio">
        <li><a href="/missions/air"><span class="ti">Missions</span><span class="ln">{MISSIONS.length} real failures you can debug yourself, each with an after-action report.</span></a></li>
        <li><a href="/notes"><span class="ti">Notebook</span><span class="ln">{notes.length} long notes, most with something to drag.</span></a></li>
        <li><a href="/lessons"><span class="ti">What I got wrong</span><span class="ln">{lessons.length} lessons learned, filed the NASA way, each with its fix.</span></a></li>
      </ul>
    </section>

    <section class="screen" aria-labelledby="h-r">
      <h2 class="s-h2" id="h-r">Every public repository</h2>
      <p class="s-meta">Ordered by when they began. Public GitHub snapshot: {gh.generatedAtLabel}.</p>
      <ul class="repos">
        {repos.map((r) => (
          <li><a href={r.url}><span class="rn">{r.name}</span><span class="ln">{repoSummaries.get(r.name.toLowerCase()) ?? (r.description || "No public project description; open the repository for its current contents.")}</span><span class="s-meta">Started {ago(r.createdAt)}; {r.archived ? "archived" : `updated ${ago(r.pushedAt)}`}</span></a></li>
        ))}
      </ul>
    </section>
  </main>
</Base>
<style>
  .bn { color: var(--c); margin-right: .4rem; }
  .archive-intro { margin-top:1.4rem; max-width:60ch; }
  .ti { font:600 var(--t1)/1.3 var(--display); color:var(--ink-hi); }
  .ti::after { content:" →"; color:var(--action); }
  .ln { font:400 var(--t0)/1.45 var(--sans); color:var(--ink); }
  .trio { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 2.4rem; }
  .trio a, .repos a { display: grid; gap: .4rem; text-decoration: none; }
  .repos { list-style:none; margin:0; padding:0; width:100%; }
  .repos li { padding:1rem 0; border-top:1px solid var(--line-2); }
  .repos a { grid-template-columns:minmax(12rem,.65fr) minmax(0,2fr) minmax(10rem,.65fr); gap:.35rem 2rem; align-items:baseline; }
  .repos .s-meta { grid-column:3; }
  .index-paths { display:flex; flex-wrap:wrap; gap:.8rem 1.4rem; margin-top:1.5rem; font-size:var(--t-1); }
  @media(max-width:1000px) { .repos a { grid-template-columns:minmax(10rem,.65fr) minmax(0,2fr); } .repos .s-meta { grid-column:2; } }
  @media(max-width:700px) { .repos a { grid-template-columns:1fr; } .repos .s-meta { grid-column:1; } }
  .rn { font:400 var(--t0) var(--mono); color:var(--action); }
  .repos .ln { font-weight:400; font-size:var(--t-1); color:var(--dim); }
  .repos a:hover .rn { color:var(--ink-hi); text-decoration:underline; }
</style>

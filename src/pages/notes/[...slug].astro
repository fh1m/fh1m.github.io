---
/**
 * A note as a sequence of screens: a full-bleed cover, then one scene per idea (built by
 * src/lib/rehype-scenes.mjs). The stage beside the text follows the paragraph being read.
 */
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { seriesById } from "../../data/series";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => {
    const parts = notes.filter((n) => n.data.series === note.data.series).sort((a, b) => a.data.part - b.data.part);
    const i = parts.findIndex((n) => n.id === note.id);
    return { params: { slug: note.id }, props: { note, parts, prev: parts[i - 1], next: parts[i + 1] } };
  });
}
const { note, parts, prev, next } = Astro.props;
const { Content } = await render(note);
const d = note.data;
const ser = seriesById[d.series];
const ACCENT: Record<string, string> = { workshop: "#e0b062", water: "#4f8fe0", sight: "#ef6a4f", time: "#a98cf0", ground: "#79b35f", air: "#eaa63b" };
const when = new Date(d.date + (d.date.length === 7 ? "-01" : "")).toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---
<Base title={d.title} description={d.dek} bodyClass="note-page" crumb={{ href: `/notes#${ser.id}`, label: `${ser.title}, part ${d.part} of ${parts.length}`, bn: ser.bn }} progress>
  <main id="main" class="note" style={`--acc:${ACCENT[ser.domain] ?? "#4f8fe0"}`}>

    <header class="cover">
      {d.hero && <img class:list={["cover-img", { plot: d.heroPlot }]} src={d.hero} alt={d.heroAlt ?? ""} fetchpriority="high" />}
      <div class="cover-text">
        <p class="kicker"><time datetime={d.date}>{when}</time></p>
        <h1>{d.title}</h1>
        <p class="dek">{d.dek}</p>
      </div>
    </header>

    <article class="scenes"><Content /></article>

    <footer class="scene end">
      <div class="end-col">
        <h2>{ser.title}</h2>
        <ol class="chapters">{parts.map((p) => <li><a href={`/notes/${p.id}`} aria-current={p.id === note.id ? "page" : undefined}><span class="pn">{p.data.part}</span><span>{p.data.title}</span></a></li>)}</ol>
        <p class="moves">{prev && <a href={`/notes/${prev.id}`} rel="prev" class="pill ghost">Previous: {prev.data.title}</a>}{next && <a href={`/notes/${next.id}`} rel="next" class="pill">Next: {next.data.title}</a>}</p>
      </div>
      <div class="end-col">
        {d.repo && <><h2>Code</h2><p><a href={`https://github.com/fh1m/${d.repo}`}>github.com/fh1m/{d.repo}</a></p></>}
        {d.sources.length > 0 && <><h2>Sources</h2><ul class="sources">{d.sources.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul></>}
      </div>
    </footer>
  </main>
</Base>

<script>
  // the stage follows the beat being read; runs on every page load (ClientRouter swaps pages)
  document.addEventListener("astro:page-load", () => {
    const split = document.querySelectorAll<HTMLElement>(".scene-split");
    if (!split.length && !document.querySelector(".scene")) return;
    split.forEach((sc) => sc.querySelector(".stage-item")?.classList.add("on"));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const beat = e.target as HTMLElement, sc = beat.closest(".scene")!;
        sc.querySelectorAll<HTMLElement>(".stage-item").forEach((it) => it.classList.toggle("on", it.dataset.step === beat.dataset.step));
      }
    }, { rootMargin: "-45% 0px -45% 0px" });
    document.querySelectorAll(".scene-split .beat").forEach((b) => io.observe(b));
    const seen = new IntersectionObserver((entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add("in")), { threshold: 0.15 });
    document.querySelectorAll(".scene").forEach((s) => seen.observe(s));
  });
</script>

<style>
  .note { --acc: #4f8fe0; position: relative; }
  .bn { font-family: var(--bangla); color: var(--acc); }

  .cover { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  .cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .cover-img.plot { object-fit: contain; filter: invert(1) hue-rotate(180deg); opacity: .35; }
  .cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 30%, #0b1233 92%); }
  .cover-text { position: relative; z-index: 1; padding: 0 var(--gutter) 12svh; max-width: 70rem; }
  .kicker { font: 700 var(--t-1) var(--story); color: var(--acc); margin: 0 0 .8rem; }
  h1 { font: 900 clamp(2.6rem, 7vw, 6rem)/1 var(--story); color: #fff; margin: 0 0 1.2rem; letter-spacing: -.02em; max-width: 18ch; }
  .dek { font: 600 clamp(1.15rem, 2vw, 1.6rem)/1.4 var(--story); color: #dfe4ff; max-width: 40ch; margin: 0; }

  .scenes :global(.scene) { position: relative; min-height: 100svh; padding: 14svh var(--gutter); display: grid; align-content: center; opacity: .25; transform: translateY(24px); transition: opacity .8s ease, transform .8s ease; }
  .scenes :global(.scene.in) { opacity: 1; transform: none; }
  .scenes :global(.scene + .scene) { border-top: 1px solid rgb(255 255 255 / .06); }
  .scenes :global(.scene-split) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 4vw; align-items: start; align-content: start; }
  .scenes :global(.scene-stage) { position: sticky; top: 0; height: 100svh; margin: -14svh 0; display: grid; align-items: center; }
  .scenes :global(.stage-inner) { display: grid; }
  .scenes :global(.stage-item) { grid-area: 1 / 1; opacity: 0; transform: scale(.98); transition: opacity .6s ease, transform .6s ease; pointer-events: none; max-height: 86svh; overflow: auto; }
  .scenes :global(.stage-item.on) { opacity: 1; transform: none; pointer-events: auto; }
  .scenes :global(.stage-item > *) { margin: 0 !important; max-width: none !important; width: 100%; }
  .scenes :global(.stage-item img) { max-height: 74svh; width: 100%; object-fit: contain; }
  .scenes :global(.beat) { min-height: 42svh; display: grid; align-content: center; padding: 4svh 0; }
  .scenes :global(.scene-split .scene-text) { padding: 6svh 0; }
  .scenes :global(.scene-text h2) { font: 900 clamp(1.8rem, 3.6vw, 3rem)/1.08 var(--story); color: #fff; margin: 0 0 1.4rem; max-width: 20ch; letter-spacing: -.01em; }
  .scenes :global(.scene-text p), .scenes :global(.scene-text li) { font: 500 clamp(1.05rem, 1.3vw, 1.25rem)/1.7 var(--story); color: #dfe4ff; max-width: 52ch; }
  .scenes :global(.scene-text strong) { color: #fff; }
  .scenes :global(.scene-text a) { color: #fff; text-decoration-color: var(--acc); }
  .scenes :global(.scene-statement) { justify-items: center; text-align: left; }
  .scenes :global(.scene-statement .scene-text) { max-width: 56rem; }
  .scenes :global(.scene-statement .scene-text p) { font-size: clamp(1.2rem, 1.8vw, 1.55rem); max-width: 46ch; }
  .scenes :global(.scene-intro p:first-child) { font-size: clamp(1.3rem, 2.2vw, 1.9rem); line-height: 1.45; color: #fff; }
  .scenes :global(.pull) { margin: 2rem 0; padding: 0; border: 0; }
  .scenes :global(.pull p) { font: 900 clamp(1.6rem, 3.4vw, 2.8rem)/1.15 var(--story) !important; color: var(--acc) !important; max-width: 24ch !important; }
  .scenes :global(table) { width: 100%; font: 400 var(--t-1)/1.5 var(--mono); }
  .scenes :global(pre) { font-size: clamp(.95rem, 1.3vw, 1.2rem); padding: 1.4rem; background: #0e1640; border-radius: 1rem; overflow-x: auto; }

  .end { min-height: 80svh; padding: 14svh var(--gutter); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 4vw; align-content: center; border-top: 1px solid rgb(255 255 255 / .08); }
  .end h2 { font: 800 var(--t1) var(--story); color: var(--acc); margin: 0 0 1rem; }
  .chapters { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: .3rem; }
  .chapters a { display: grid; grid-template-columns: 2.4rem 1fr; gap: .6rem; padding: .7rem 0; border-bottom: 1px solid rgb(255 255 255 / .08); text-decoration: none; font: 700 clamp(1.05rem, 1.6vw, 1.4rem)/1.3 var(--story); color: #9aa6d8; }
  .chapters a:hover, .chapters a[aria-current="page"] { color: #fff; }
  .chapters .pn { font-family: var(--mono); color: var(--acc); }
  .moves { display: flex; flex-wrap: wrap; gap: .6rem; }
  .sources { margin: 0 0 2rem; padding-left: 1.1rem; display: grid; gap: .4rem; font: 500 var(--t-1)/1.5 var(--story); }
  .sources a, .end-col > p a { color: #dfe4ff; }

  @media (max-width: 900px) {
    .scenes :global(.scene-split) { grid-template-columns: 1fr; }
    .scenes :global(.scene-stage) { order: -1; top: 3.4rem; height: auto; margin: 0; z-index: 2; background: #0b1233; padding: .6rem 0; }
    .scenes :global(.stage-item) { max-height: 42svh; }
    .scenes :global(.stage-item img) { max-height: 38svh; }
    .scenes :global(.beat) { min-height: 40svh; }
    .end { grid-template-columns: 1fr; }
    }
  @media (prefers-reduced-motion: reduce) { .scenes :global(.scene) { opacity: 1; transform: none; transition: none; } .scenes :global(.stage-item) { transition: none; } }
</style>

---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { seriesById } from "../../data/series";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => {
    const parts = notes.filter((n) => n.data.series === note.data.series).sort((a, b) => a.data.part - b.data.part);
    const i = parts.findIndex((n) => n.id === note.id);
    return { params: { slug: note.id }, props: { note, parts, prev: parts[i - 1], next: parts[i + 1] } };
  });
}
const { note, parts, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const d = note.data;
const ser = seriesById[d.series];
const kindLabel = { project: "project", essay: "from the notebook", regrade: "re-graded", story: "story" }[d.kind];
---
<Base title={d.title} description={d.dek} bodyClass="note-page" world={{ layer: "all", dist: 14, side: "right" }} crumbs={[{ href: "/notes", label: "Notebook" }, { href: `/notes#${ser.id}`, label: ser.title }]}>
  <main id="main" class:list={["note", `d-${ser.domain}`]}>
    <header class="head">
      {d.hero && <img class:list={["hero", { plot: d.heroPlot }]} src={d.hero} alt={d.heroAlt ?? ""} fetchpriority="high" />}
      <div class="head-text">
        <p class="kicker mono">
          <a href={`/notes#${ser.id}`}><span class="bn">{ser.bn}</span> {ser.title}</a>
          <span>part {d.part} of {parts.length}</span><span>{kindLabel}</span><time datetime={d.date}>{d.date}</time>
        </p>
        <h1>{d.title}</h1>
        <p class="dek">{d.dek}</p>
      </div>
    </header>
    <div class="layout">
      <aside class="rail" aria-label="About this note">
        <nav class="series" aria-label={`Series: ${ser.title}`}>
          <p class="mono dim"><span class="bn">{ser.bn}</span> {ser.title}</p>
          <ol>{parts.map((p) => <li><a href={`/notes/${p.id}`} aria-current={p.id === note.id ? "page" : undefined}><span class="pn">{p.data.part}</span> {p.data.title}</a></li>)}</ol>
        </nav>
        {headings.filter((h) => h.depth === 2).length > 1 && (
          <nav aria-label="In this note" class="toc">
            <p class="mono dim">in this note</p>
            <ol>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {d.repo && <p class="mono"><a href={`https://github.com/fh1m/${d.repo}`}>github.com/fh1m/{d.repo}</a></p>}
        {d.sources.length > 0 && (
          <div class="sources">
            <p class="mono dim">sources</p>
            <ul>{d.sources.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
          </div>
        )}
      </aside>
      <article class="body"><Content /></article>
    </div>
    <nav class="pager mono" aria-label="More notes">
      {prev ? <a href={`/notes/${prev.id}`} rel="prev">← part {prev.data.part}: {prev.data.title}</a> : <span />}
      <a href="/notes">all series</a>
      {next ? <a href={`/notes/${next.id}`} rel="next">part {next.data.part}: {next.data.title} →</a> : <span />}
    </nav>
  </main>
</Base>

<style>
  .note { position: relative; z-index: 1; padding: 0 0 4rem; background: linear-gradient(90deg, rgb(0 0 0 / .94) 0, rgb(0 0 0 / .94) 74%, rgb(0 0 0 / .55) 100%); }
  .head { display: grid; grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr) minmax(16rem, 30rem); gap: 1.4rem 3rem; align-items: end; padding: 1.4rem var(--gutter) 2rem; border-bottom: 1px solid var(--line); }
  .head-text { grid-column: 2; }
  .hero { grid-column: 3; grid-row: 1; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border: 1px solid var(--line); filter: saturate(.85); }
  .hero.plot { filter: invert(1) hue-rotate(180deg) saturate(.8); }
  .kicker { display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; font-size: var(--t-2); color: var(--faint); margin: 0 0 .7rem; }
  .kicker a { color: var(--blue); text-decoration: none; }
  h1 { font: 500 var(--t5)/1.12 var(--sans); max-width: 24ch; margin: 0 0 .7rem; color: var(--ink-hi); }
  .dek { font: italic 400 var(--t1)/1.45 var(--sans); color: var(--ink); max-width: 56ch; margin: 0; }
  .series a { display: grid; grid-template-columns: 1.4rem 1fr; gap: .3rem; }
  .series .pn { color: var(--faint); }
  .series a[aria-current="page"] { color: var(--ink-hi); }
  .series a[aria-current="page"] .pn { color: var(--red); }

  .layout { display: grid; grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr); gap: 2rem 3rem; padding: 2rem var(--gutter) 0; }
  .rail { position: sticky; top: 4.6rem; align-self: start; display: grid; gap: 1.4rem; }
  .rail ol, .rail ul { list-style: none; margin: .4rem 0 0; padding: 0; display: grid; gap: .4rem; }
  .rail a { font: 400 var(--t-2)/1.45 var(--mono); color: var(--dim); text-decoration: none; }
  .rail a:hover { color: var(--ink-hi); }
  .dim { color: var(--faint); margin: 0; font-size: var(--t-2); }

  .body { max-width: 76rem; }
  .body :global(> p), .body :global(> ul), .body :global(> ol) { max-width: 66ch; color: var(--ink); }
  .body :global(> h2) { font: 500 var(--t3)/1.25 var(--sans); margin: 3rem 0 .8rem; color: var(--ink-hi); max-width: 32ch; }
  .body :global(> h3) { font: 500 var(--t1) var(--sans); margin: 2rem 0 .6rem; color: var(--ink-hi); }
  .body :global(> figure:not(.wide)) { max-width: 66ch; }
  .body :global(table) { max-width: 64rem; }
  .body :global(li) { margin-bottom: .35rem; }
  .body :global(li::marker) { color: var(--faint); }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; padding: 3rem var(--gutter) 0; font-size: var(--t-1); }
  .pager a { text-decoration: none; color: var(--dim); }
  .pager a:hover { color: var(--ink-hi); }
  .pager a:last-child { text-align: right; }

  @media (max-width: 1100px) { .head { grid-template-columns: 1fr; } .head-text, .hero { grid-column: 1; } .hero { grid-row: auto; max-width: 30rem; } }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .rail { position: static; order: 2; border-top: 1px solid var(--line); padding-top: 1.4rem; }
    .pager { grid-template-columns: 1fr; }
    .pager a:last-child { text-align: left; }
  }
</style>

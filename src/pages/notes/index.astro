---
/** The notebook: one screen per series, each note a numbered chapter. */
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { series } from "../../data/series";
import { seriesColours } from "../../data/palette";
import { dims } from "../../data/media";
const notes = await getCollection("notes");
---
<Base title="Notebook" description="The long versions: how the machines work, what water does to light and radio, seeing, time, measuring honestly, and building things that run. Most have something to drag.">
  <main id="main" class="screens">
    <header class="screen">
      <div class="measure">
        <h1 class="s-h1">Notebook</h1>
        <p class="s-dek">The long versions, in {series.length} series that build from first principles. Most have something you can drag.</p>
      </div>
      <nav class="series-index" aria-label="Notebook series">{series.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}</nav>
    </header>
    {series.map((s) => {
      const parts = notes.filter((n) => n.data.series === s.id).sort((a, b) => a.data.part - b.data.part);
      return parts.length > 0 && (
        <section class="screen ser" id={s.id} style={`--acc:${seriesColours[s.domain]}`} aria-labelledby={`h-${s.id}`}>
          <div class="ser-head">
            <p class="s-kicker"><span class="bn" lang="bn">{s.bn}</span>{parts.length} notes</p>
            <h2 class="s-h2" id={`h-${s.id}`}>{s.title}</h2>
            <p class="s-txt">{s.blurb}</p>
          </div>
          <ol class="chap">
            {parts.map((n) => {
              const image = n.data.hero ? { src:n.data.hero, ...dims(n.data.hero) } : null;
              return (
              <li>
                <a href={`/notes/${n.id}`}>
                  <span class="pn">{n.data.part}</span>
                  <span class="tt"><span class="ti">{n.data.title}</span><span class="dk">{n.data.dek}</span></span>
                  {image && <img class:list={{ plot:n.data.heroPlot }} src={image.src} alt="" width={image.w} height={image.h} loading="lazy" />}
                </a>
              </li>
              );
            })}
          </ol>
        </section>
      );
    })}
  </main>
</Base>
<style>
  .series-index { display:flex; flex-wrap:wrap; gap:.6rem 1.2rem; margin-top:1.3rem; font:500 var(--t-1)/1.5 var(--interface); }
  .ser { grid-template-columns:minmax(0,1fr); gap:1.25rem; align-items:start; align-content:start; scroll-margin-top:calc(var(--header-height) + 1rem); }
  .ser-head { display:grid; grid-template-columns:minmax(0,4fr) minmax(0,8fr); gap:.3rem 4vw; align-items:start; }
  .ser-head .s-kicker { grid-column:1/-1; margin-bottom:.25rem; }
  .ser-head .s-h2 { margin:0; max-width:20ch; }
  .ser-head .s-txt { margin:0; }
  .bn { color:var(--acc); }
  .chap { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 2rem; }
  .chap li { min-width:0; }
  .chap a { display:grid; grid-template-columns:2rem minmax(0,1fr) 6.5rem; gap:.8rem; align-items:start; height:100%; padding:1.2rem 0; border-top:1px solid var(--line); text-decoration:none; }
  .chap a:not(:has(img)) { grid-template-columns:2rem minmax(0,1fr); }
  .pn { font:400 var(--t-1)/1.7 var(--mono); color:var(--acc); }
  .tt { display:grid; gap:.45rem; }
  .ti { font:600 1.1rem/1.35 var(--display); color:var(--ink-hi); }
  .ti::after { content:" →"; color:var(--action); }
  .dk { font:400 var(--t-1)/1.5 var(--sans); color:var(--dim); }
  .chap img { width:6.5rem; height:auto; max-height:7.5rem; object-fit:contain; border-radius:var(--r-1); align-self:center; }
  .chap img.plot { filter:invert(1) hue-rotate(180deg); }
  .chap a:is(:hover,:focus-visible) .ti { color:var(--action); }
  @media(max-width:1100px) { .chap { grid-template-columns:minmax(0,1fr); } .chap a { grid-template-columns:2rem minmax(0,1fr) 10rem; } .chap img { width:10rem; max-height:9rem; } }
  @media(max-width:900px) { .ser-head { grid-template-columns:minmax(0,1fr); gap:.8rem; } }
  @media(max-width:540px) { .chap a { grid-template-columns:1.5rem minmax(0,1fr); gap:.65rem; } .chap a:not(:has(img)) { grid-template-columns:1.5rem minmax(0,1fr); } .chap img { grid-column:2; width:100%; max-width:20rem; max-height:12rem; object-position:left; justify-self:start; } }
</style>

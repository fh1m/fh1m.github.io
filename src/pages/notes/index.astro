---
import Base from "../../layouts/Base.astro";
import Player from "../../components/album/Player.astro";
import { getCollection } from "astro:content";
import { series } from "../../data/series";
const notes = await getCollection("notes");
---
<Base title="Notebook" description="The long versions: how the machines work, what water does to light and radio, seeing, time, measuring honestly, and building things that run. Most have something to drag.">
  <main id="main" class="notebook">
    <header>
      <h1>Notebook</h1>
      <p>The long versions. Most of them have something you can drag.</p>
    </header>
    {series.map((s) => {
      const parts = notes.filter((n) => n.data.series === s.id).sort((a, b) => a.data.part - b.data.part);
      return parts.length > 0 && (
        <section id={s.id} aria-labelledby={`h-${s.id}`}>
          <h2 id={`h-${s.id}`}><span class="bn" lang="bn">{s.bn}</span> {s.title}</h2>
          <ol>
            {parts.map((n) => (
              <li>
                <a class="track" href={`/notes/${n.id}`} data-art={n.data.heroPlot ? "" : (n.data.hero ?? "")}>
                  <span class="ti">{n.data.title}</span>
                  <span class="dek">{n.data.dek}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
    <Player />
  </main>
</Base>
<script>
  import "../../scripts/album.ts";
</script>
<style>
  .notebook { position: relative; z-index: 1; padding: 3rem clamp(1.4rem, 5vw, 5rem) 0; max-width: 52rem; }
  header { position: relative; z-index: 1; }
  h1 { font: 500 var(--t5)/1.05 var(--sans); margin: 0 0 1rem; }
  header p { color: var(--dim); margin-bottom: 3rem; }
  section { position: relative; z-index: 1; margin-bottom: 3rem; scroll-margin-top: 1rem; }
  h2 { font: 500 var(--t2) var(--sans); margin: 0 0 .8rem; }
  .bn { font-family: var(--bangla); font-weight: 400; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .track { display: grid; gap: .15rem; text-decoration: none; }
  .ti { font-size: var(--t1); color: var(--ink-hi); }
  .dek { color: var(--dim); }
  .track:hover .ti, .track:focus-visible .ti { text-decoration: underline; }
  .notebook :global(.player) { display: none; }
</style>

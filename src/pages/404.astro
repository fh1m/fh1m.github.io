---
import Base from '../layouts/Base.astro';
---

<Base title="404: NO SIGNAL" description="Signal detached — no route at this coordinate.">
  <section class="not-found">
    <p class="mono-label">[404: NO SIGNAL]</p>
    <h1 class="display">SIGNAL DETACHED</h1>
    <p class="not-found-body">
      No route exists at this coordinate. The machine is still running — return to base.
    </p>
    <a class="not-found-link" href="/">← BACK TO HOME</a>
  </section>

  <style>
    .not-found {
      max-width: var(--max-width-editorial);
      margin: 0 auto;
      padding: var(--space-24) var(--space-6);
      display: grid;
      gap: var(--space-6);
    }

    .not-found h1 {
      font-weight: 900;
      /* Scoped display size: --text-display (8vw/9rem) overflows the 68ch
         column at desktop ("DETACHED" at 115px > 632px content width). */
      font-size: clamp(2.5rem, 7vw, 6.75rem);
    }

    .not-found-body {
      color: var(--ink-muted);
      max-width: 40ch;
    }

    .not-found-link {
      font-family: var(--font-mono), ui-monospace, monospace;
      font-size: var(--text-label);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      color: var(--signal);
      border: 1px solid var(--line);
      padding: var(--space-2) var(--space-3);
      width: fit-content;
    }

    .not-found-link:hover {
      color: var(--surface-0);
      background: var(--signal);
      border-color: var(--signal);
    }
  </style>
</Base>
---
/** One element as screens: what it does to a machine, the machine built for it, the works, and what it taught. */
import Base from "../layouts/Base.astro";
import WorkList from "../components/WorkList.astro";
import { elements, type ElementInfo } from "../data/elements";
import { byElement } from "../data/lessons";
import { ZONE_INFO } from "../game/zones";
import { MISSIONS } from "../game/missions";
export const getStaticPaths = () => elements.map((el) => ({ params: { element: el.id }, props: { el } }));
const { el } = Astro.props as { el: ElementInfo };
const ll = byElement(el.id);
const z = ZONE_INFO.find((x) => x.id === el.id);
const m = MISSIONS.find((x) => x.zone === el.id);
const first = el.projects.find((p) => p.hero);
---
<Base title={el.name} nation={el.id} description={`${el.name}: ${el.nature}`} crumb={{ href: "/everything", label: "All the work" }}>
  <main id="main" class="screens">
    <header class:list={["screen", "cover", { "has-img": !!first }]}>
      <div class="rel">
        <p class="bnbig" lang="bn">{el.bn}</p>
        <h1 class="s-h1">{el.name}</h1>
        <p class="s-dek">{el.nature}</p>
      </div>
      {first && <img class="cover-img" src={first.hero} alt={first.heroAlt ?? ""} fetchpriority="high" />}
    </header>

    {z && (
      <section class="screen split" aria-labelledby="h-m">
        <div>
          <p class="s-label">The machine for it</p>
          <h2 class="s-h2" id="h-m">{z.form}</h2>
          <p class="s-txt">{z.line}</p>
          <p class="s-meta">{z.real} <a href={z.source.href}>{z.source.label}</a></p>
          {m && <p class="go"><a class="pill" href={m.report}>Mission: {m.title}</a></p>}
        </div>
        <dl>{z.specs.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
      </section>
    )}

    <section class="screen" aria-labelledby="h-w">
      <h2 class="s-h2" id="h-w">What I built for {el.name.toLowerCase()}</h2>
      <WorkList projects={el.projects} />
    </section>

    {ll.length > 0 && (
      <section class="screen" aria-labelledby="h-l">
        <h2 class="s-h2" id="h-l">What {el.name.toLowerCase()} taught me</h2>
        <ul class="wall">{ll.map((l) => <li><a href={`/lessons/${l.slug}`}><span class="t">{l.title}</span><span class="s-struck b">{l.believed}</span></a></li>)}</ul>
      </section>
    )}
  </main>
</Base>
<style>
  .cover { grid-template-columns: minmax(0, 1fr); gap: 4vw; align-items: center; }
  .cover.has-img { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .cover-img { width: 100%; height: auto; max-height: 52svh; object-fit: contain; border-radius: 8px; }
  .rel { position: relative; z-index: 1; }
  .bnbig { font: 400 clamp(2.4rem, 5vw, 3.6rem)/1 var(--bangla); color: var(--c); margin: 0 0 .4rem; }
  .split { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4vw; align-items: center; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: .9rem 1.6rem; margin: 0; padding: 1.6rem; border-radius: 1rem; background: rgb(255 255 255 / .05); }
  dt { font: 500 var(--t-1) var(--sans); color: #8c8c8c; }
  dd { margin: 0; font: 400 var(--t0) var(--mono); color: #fff; }
  .go { margin-top: 1.6rem; }
  .wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 2rem 3rem; }
  .wall a { display: grid; gap: .4rem; text-decoration: none; }
  .t { font: 600 var(--t1)/1.3 var(--sans); color: #fff; }
  .b { font: 500 var(--t-1)/1.5 var(--sans); }
  @media (max-width: 900px) { .split, .cover.has-img { grid-template-columns: 1fr; } }
</style>

---
import Base from "../layouts/Base.astro";
import { person, education, roles, results, publications, skills, mongla } from "../data/facts";
import stats from "../data/github.json";
// Proof of work: each number is measured, and each links to the write-up or commit that shows how.
const proof = [
  { n: "396 → 16.9 ms", what: "age of the camera frame the vehicle steers by, after replacing the queue with a keep-up thread", href: "/notes/the-frame-age-problem" },
  { n: "18.0 ms", what: "median photon-to-detection latency on a Hailo-8, measured end to end", href: "/notes/mongla" },
  { n: "701 FPS", what: "XFeat backbone on the Hailo-8, 23× the Pi 5 CPU; no published figure found elsewhere", href: "/notes/the-71-transposes" },
  { n: "1.09 cm", what: "worst error turning a downward camera into a velocity sensor, over a 30 cm slide", href: "/notes/turning-a-camera-into-a-sensor" },
  { n: "30.4 % → 1.2 %", what: "gate detections with “image enhancement” switched on; 17 configurations, so the feature was deleted", href: "/notes/mongla" },
  { n: "958 / 958", what: "ESC frames reading zero with no motor attached; the health check was rewritten so it can fail", href: "/notes/from-worked-once-to-works-every-time" },
];
---
<Base title="CV" description="CV of Fahim Faisal (fh1m): autonomy and robotics: perception, control, embedded." bodyClass="cv-page">
  <main id="main" class="cv">
    <header class="cv-head">
      <div>
        <h1>{person.fullName}</h1>
        <p class="role">{person.line}</p>
        <p class="contact mono">
          <span>{person.place}</span>
          <a href={`mailto:${person.email}`}>{person.email}</a>
          <a href={person.github}>github.com/{person.handle}</a>
          <a href="https://fh1m.github.io">fh1m.github.io</a>
          {person.linkedin && <a href={person.linkedin}>LinkedIn</a>}
        </p>
      </div>
      <p class="dl no-print"><a class="btn-pill" href="/cv/fahim-faisal-cv.pdf" download>Download the PDF</a></p>
    </header>

    <section aria-labelledby="cv-proof">
      <h2 id="cv-proof">Proof of work</h2>
      <p class="dim lede">Measured, not estimated. Each one links to how it was measured.</p>
      <ul class="proof">{proof.map((p) => <li><a href={p.href}><span class="pn">{p.n}</span><span class="pw">{p.what}</span></a></li>)}</ul>
      <p class="dim gh">{stats.commitsLastYear.toLocaleString("en-US")} commits in the last year across {stats.ownRepos} public repositories of my own. Every project on the <a href="/everything">work index</a> links to its code.</p>
    </section>
    <section aria-labelledby="cv-results">
      <h2 id="cv-results">Results</h2>
      <ul class="results">
        {results.map((r) => <li><span class="num">{r.year}</span><span><b>{r.event}</b> · {r.team}: {r.result}.{r.detail && <span class="dim"> {r.detail}</span>}</span></li>)}
      </ul>
    </section>

    <section aria-labelledby="cv-exp">
      <h2 id="cv-exp">Experience</h2>
      {roles.map((r) => (
        <article class="role-item">
          <header><h3>{r.url ? <a href={r.url}>{r.org}</a> : r.org}</h3><span class="mono dates">{r.dates}</span></header>
          <p class="title">{r.title}</p>
          <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </section>

    <section aria-labelledby="cv-own">
      <h2 id="cv-own">Selected work</h2>
      <ul class="own">
        <li><a href="https://github.com/fh1m/mongla_ws"><b>Mongla</b></a>: independent ROS 2 autonomy stack for AUVs. {mongla.loopHz} Hz board loop (board and firmware by Rakibul Islam), {mongla.detectHz} Hz detection through the live graph, {mongla.tests.toLocaleString("en-US")} tests. Not yet in water.</li>
        <li><a href="https://github.com/fh1m/Dristy"><b>Dristy</b></a>: open firmware and host API for a K210 vision co-processor (KPU nets, classical vision, compact serial answers).</li>
        <li><a href="https://github.com/fh1m/rupsha_ws"><b>Rupsha</b></a>: ROS 2 autonomy stack for an Ackermann rover; Gazebo-verified, chassis in build.</li>
        <li><a href="https://github.com/fh1m/mongla_sim"><b>Mongla Sim</b></a>: Gazebo + ArduSub SITL with six courses, a native DVL and an operator lab.</li>
        <li><b>Re-graded early work</b> (2023–24, revisited 2026 with measurements and fixes): <a href="https://github.com/fh1m/green-at-depth">green-at-depth</a>, <a href="https://github.com/fh1m/half-a-second">half-a-second</a>, <a href="https://github.com/fh1m/four-leds">four-leds</a>, <a href="https://github.com/fh1m/E-Bhapa">E-Bhapa</a>, <a href="https://github.com/fh1m/trust-issues">trust-issues</a>, <a href="https://github.com/fh1m/pareidolia">pareidolia</a>, <a href="https://github.com/fh1m/interview-bottle">interview-bottle</a>.</li>
        <li><b>Security</b>: <a href="https://github.com/fh1m/passless">Passless</a> (WebAuthn, 25 tests), <a href="https://github.com/fh1m/secure-terminal-p2p-chat">secure terminal P2P chat</a> (RSA-OAEP + AES-256-GCM, strict mode).</li>
      </ul>
    </section>

    <section aria-labelledby="cv-pub">
      <h2 id="cv-pub">Publications</h2>
      <ul class="pubs">{publications.map((p) => <li><b>{p.title}</b>. {p.authors}. <span class="dim">{p.venue}.</span></li>)}</ul>
    </section>

    <section aria-labelledby="cv-edu">
      <h2 id="cv-edu">Education</h2>
      {education.map((e) => (
        <article class="role-item">
          <header><h3>{e.org}</h3><span class="mono dates">{e.dates}</span></header>
          <p class="title">{e.degree}{e.note && <span class="dim"> {e.note}</span>}</p>
        </article>
      ))}
    </section>

    <section aria-labelledby="cv-skills">
      <h2 id="cv-skills">Tools</h2>
      <dl class="skills">{Object.entries(skills).filter(([k]) => k !== "source").map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </section>

    <p class="src">Generated from the site's single facts file, {stats.generatedAtLabel}. Every line has a source in <a href="https://github.com/fh1m/fh1m.github.io/blob/main/src/data/facts.ts">facts.ts</a>.</p>
  </main>
</Base>

<style>
  .cv { position: relative; z-index: 1; max-width: 58rem; margin-inline: auto; padding: 3rem clamp(1.4rem, 5vw, 5rem) 0; --pink: var(--ink-hi); }
  .cv-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--line-2); padding-bottom: 1.2rem; margin-bottom: 1.6rem; }
  h1 { font: 500 var(--t5) var(--sans); color: var(--ink-hi); margin: 0 0 .3rem; }
  .role { font: italic 400 var(--t1) var(--sans); color: var(--ink); margin: 0 0 .6rem; }
  .contact { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; margin: 0; color: var(--dim); font-size: var(--t-1); }
  h2 { display: flex; align-items: center; gap: .9rem; font: 500 var(--t1) var(--sans); color: var(--ink-hi); margin: 2.4rem 0 .9rem; }
  h2::after { content: ""; flex: 1; height: 1px; background: var(--line-2); }
  .lede { margin: -.3rem 0 1rem; font-size: var(--t-1); }
  .proof { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1px; background: var(--line-2); border: 1px solid var(--line-2); border-radius: var(--r-3); overflow: hidden; }
  .proof li { background: #070809; }
  .proof a { display: grid; gap: .35rem; height: 100%; box-sizing: border-box; padding: 1rem 1.1rem 1.1rem; text-decoration: none; transition: background .15s; }
  .proof a:hover { background: #101216; }
  .pn { font: 500 var(--t2)/1.1 var(--mono); color: #ffcf8a; font-variant-numeric: tabular-nums; }
  .pw { font: 400 var(--t-1)/1.45 var(--sans); color: var(--ink); }
  .gh { margin: .9rem 0 0; font-size: var(--t-1); }
  .results, .own, .pubs { list-style: none; padding: 0; margin: 0; display: grid; gap: .7rem; }
  .results li { display: grid; grid-template-columns: 3.4rem 1fr; gap: .8rem; }
  .results .num { color: var(--ink-hi); }
  .role-item { margin: 0 0 1.4rem; }
  .role-item header { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
  .role-item h3 { font: 500 var(--t1) var(--sans); color: var(--ink-hi); margin: 0; }
  .role-item h3 a { text-decoration: none; }
  .dates { color: var(--dim); font-size: var(--t-2); }
  .title { margin: .15rem 0 .4rem; color: var(--ink); }
  .role-item ul { margin: 0; padding-left: 1.1rem; color: var(--ink); }
  .role-item li { margin: .2rem 0; font-size: var(--t-1); }
  .role-item li::marker { color: var(--faint); }
  .dim { color: var(--dim); }
  .skills { display: grid; gap: .45rem; margin: 0; }
  .skills div { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; }
  .skills dt { font: 400 var(--t-2) var(--mono); color: var(--dim); }
  .skills dd { margin: 0; }
  .src { margin-top: 3rem; }
  .btn-pill { display: inline-block; font: 400 var(--t-1) var(--sans); text-decoration: none; padding: .55rem 1rem; border: 1px solid var(--line-2); border-radius: var(--r-2); color: var(--ink-hi); }
  .btn-pill:hover { border-color: var(--blue); }
  @media print {
    :global(html), :global(body) { background: #fff !important; color: #000 !important; font-size: 9.3pt; line-height: 1.38; }
    :global(.top), :global(.foot), :global(.skip), :global(.world), :global(.descent), .no-print { display: none !important; }
    :global(.grain::after) { display: none; }
    .cv { padding: 0 1mm !important; margin: 0 !important; max-width: none !important; width: auto !important; background: none !important; border: 0 !important; backdrop-filter: none !important; --pink: #1d3d7a; }
    :global(html), :global(body), :global(main) { background: #fff !important; }
    :global(:root) { color-scheme: light !important; }
    .role, .results .num, .results b, .skills dt, .own b, .pubs b { color: #000 !important; }
    h2 { color: #1d3d7a; }
    h1 { font-size: 22pt; }
    .role { font-size: 12pt; margin-bottom: .3rem; }
    .role-item li { font-size: 9pt; margin: .05rem 0; }
    .results, .own, .pubs { gap: .3rem; }
    h1, .title, .role-item h3 { color: #000; }
    .contact, .dates, .dim, .src, .role-item ul { color: #333; }
    .role-item ul, .skills dd, .results li, .own li, .pubs li { color: #111; }
    a { color: #000; text-decoration: none; }
    h2 { margin-top: 1.1rem; break-after: avoid; }
    .role-item { break-inside: avoid; margin-bottom: .7rem; }
    .cv-head { margin-bottom: 1rem; padding-bottom: .8rem; }
    .proof { background: #ccc !important; border-color: #ccc !important; border-radius: 4px; grid-template-columns: repeat(3, 1fr); }
    .proof li { background: #fff !important; } .proof a { padding: .35rem .5rem; gap: .1rem; }
    .pn { color: #1d3d7a !important; font-size: 11pt; } .pw { color: #111 !important; font-size: 8.3pt; }
    .lede, .gh { display: none; }
    .src { display: none; }
    h2::after { background: #ccc; }
  }
</style>

---
import Base from "../layouts/Base.astro";
import { person, education, roles, publications, skills, hailoSharing } from "../data/facts";
const experience = roles.filter((r) => !r.org.startsWith("Mongla"));
const concise = Astro.props.concise === true;
const resumeOrder = ["BRACU Duburi", "Amateur Experimental Rocketry (AERD)", "Dubotech", "BRACU Mongol-Tori"];
const selectedExperience = concise ? resumeOrder.flatMap(org => experience.filter(r => r.org === org)) : experience;
const projects = [
  { name: "Mongla", url: "https://github.com/fh1m/mongla_ws", detail: `Developed an independent ROS 2 AUV autonomy stack integrating perception, estimation and mission execution over MAVLink. Bench-tested two ${hailoSharing.requestedDetectorHz} Hz detection networks plus ${hailoSharing.requestedXfeatHz} Hz XFeat on one Hailo-8 (${hailoSharing.durationS} s, repeated-frame input; ${hailoSharing.date}). No water trials. Control board and firmware by Rakibul Islam.` },
  { name: "Camera capture latency", url: "/notes/the-frame-age-problem", detail: "Replaced queued camera consumption with latest-frame capture, reducing kernel-stamped frame age from 396.1 ms to 16.9 ms in a controlled stall benchmark. Evaluated buffering policies against the kernel timestamps rather than using throughput as a proxy for freshness." },
  { name: "Optical-flow velocity: bench evaluation", url: "/notes/turning-a-camera-into-a-sensor", detail: "Evaluated downward-camera optical flow on three axial 30 cm manual slides in air: 0.13–1.09 cm integrated-distance-magnitude error. This is a small bench evaluation, not full trajectory accuracy or underwater DVL validation." },
  { name: "Dristy", url: "https://github.com/fh1m/Dristy", detail: "Built K210 vision firmware and a host API combining neural inference and classical vision. Designed compact serial responses so host software consumes detection results rather than transferring full video frames." },
  { name: "Rupsha", url: "https://github.com/fh1m/rupsha_ws", detail: "Developed a ROS 2 autonomy stack for an Ackermann rover and evaluated behavior in Gazebo. Physical chassis remains in build; simulation results are not represented as field deployment." },
];
const resumeProjects = [
  { name: "Camera capture latency", url: "/notes/the-frame-age-problem", detail: "Reduced kernel-stamped frame age from 396.1 ms to 16.9 ms in a controlled camera-stall benchmark; compared buffering policies against kernel timestamps, not throughput." },
  { name: "Visual-navigation investigations: Dhrubotara / Matra / Dhara", url: "/notes/dhrubotara", detail: "Reference matching/homography, depth-scale normalization and capture-time velocity units, evaluated with CPU-controlled experiments and recorded-input replay; not flight validation." },
];
const rolePoints = (r: (typeof roles)[number]) => !concise ? r.points : r.org === "BRACU Duburi" ? [r.points[0], "Built the CNN perception stack and dataset pipeline; deployed edge inference and integrated perception into the shared ROS 2 vehicle stack."] : r.points.slice(0, r.org === "Amateur Experimental Rocketry (AERD)" ? 2 : 1);
---
<Base title={concise ? "Résumé" : "Technical CV"} description="Muhammad Fahim Faisal: robotics and autonomy experience, selected engineering projects, education and publications." bodyClass="cv-page">
  <main id="main" class:list={["cv", { concise }]}>
    <nav class="document-tools no-print" aria-label="Professional documents"><a href="/about">Contributions &amp; CV</a><a href="/cv/fahim-faisal-resume.pdf" download>One-page résumé</a><a href="/cv/fahim-faisal-cv.pdf" download>Two-page CV</a></nav>
    <header class="cv-head">
      <h1>{person.fullName}</h1>
      <p class="specialism">Robotics and autonomy • Perception, control and embedded systems</p>
      <p class="contact"><span>{person.place}</span><a href={`mailto:${person.email}`}>{person.email}</a><a href={person.github}>github.com/fh1m</a><a href="https://fh1m.github.io">fh1m.github.io</a>{person.linkedin && <a href={person.linkedin}>LinkedIn</a>}</p>
    </header>
    <p class="summary">{concise ? "Computer science undergraduate building perception, control and autonomy software across underwater vehicles, rovers and experimental rocketry. Evaluates edge systems with source-linked bench, replay and simulation evidence." : "Computer science undergraduate with engineering experience across underwater vehicles, rover perception and experimental rocketry. Builds and evaluates perception and control software on resource-constrained hardware; documents measured results and validation limits."}</p>
    <section aria-labelledby="experience"><h2 id="experience">Engineering experience</h2>
      {selectedExperience.map((r) => <article class="entry"><h3>{r.org}</h3><p class="position">{r.title.replaceAll(" · ", "; ")} <span class="dates">({r.dates})</span></p>{r.url && <p class="project-source"><a href={r.url}>{r.url}</a></p>}<ul>{rolePoints(r).map((p) => <li>{p.replace(" The first code of mine that someone else depended on.", "")}</li>)}</ul></article>)}
    </section>
    <section aria-labelledby="projects"><h2 id="projects">Selected engineering projects</h2>{(concise ? resumeProjects : projects).map((p) => <article class="project"><h3>{p.name} <a class="project-source" href={p.url}>{new URL(p.url, Astro.site).href}</a></h3><p>{p.detail}</p>{concise && p.url === "/notes/dhrubotara" && <p class="project-source">Related investigations: <a href="https://fh1m.github.io/notes/matra/">Matra: depth scale</a> · <a href="https://fh1m.github.io/notes/dhara/">Dhara: capture-time units</a></p>}</article>)}</section>
    <section aria-labelledby="education"><h2 id="education">Education</h2>{education.map((e) => <article class="education"><h3>{e.org}</h3><p>{e.org === "BRAC University" ? "Coursework toward B.Sc. Computer Science; minor studies in Electrical and Electronic Engineering. Degree not completed." : e.org.startsWith("IU ") ? "Coursework toward B.Sc. Autonomous Systems (one semester, on campus) — Bad Honnef, Germany." : e.degree}{e.current && " (in progress)"} <span class="dates">({e.dates})</span></p></article>)}</section>
    <section aria-labelledby="skills"><h2 id="skills">Technical skills</h2><div class="skills">{Object.entries(skills).filter(([k]) => k !== "source").map(([k,v]) => <p><b>{k}:</b> {v}</p>)}</div></section>
    {!concise && <section aria-labelledby="publications"><h2 id="publications">Publications and technical reports</h2><ul>{publications.map((p) => <li><a href={p.url}><b>{p.title}.</b></a> {p.authors}. {p.venue}.</li>)}<li>Co-author, BRACU Duburi Technical Design Reports, RoboSub 2025 and 2026.</li></ul></section>}
    <p class="source-note no-print">Supporting measurements, source code and project histories are available on the <a href="/about">work page</a>. Team results are distinguished from individual contributions; bench and simulation results are not field-validation claims.</p>
  </main>
</Base>
<style>
  .cv { position: relative; z-index: 1; box-sizing: border-box; max-width: 56rem; margin: 2rem auto; padding: 2.8rem; background: #fff; color: #20252b; font: 400 1rem/1.5 var(--sans); border-radius: 3px; }
  .cv p { max-width:none; }
  .cv a { color: #174866; } .document-tools { display:flex; flex-wrap:wrap; gap:.7rem 1.2rem; margin-bottom:2rem; font-size:.85rem; }
  .cv b { color:inherit; } .cv { color-scheme:light; } .cv :global(::selection) { background:#c9dce8; color:#111; }
  .cv-head { text-align:center; border-bottom:1px solid #71808a; padding-bottom:1rem; } h1 { color:#172630; font:600 2rem/1.15 var(--sans); margin:0 0 .5rem; } .specialism { margin:.3rem 0; font-size:.95rem; } .contact { display:flex; justify-content:center; flex-wrap:wrap; gap:.2rem 1rem; font-size:.8rem; margin:.5rem 0 0; }
  .summary { margin:1.2rem 0; }
  h2 { color:#172630; font:600 1.05rem/1.2 var(--sans); margin:1.6rem 0 .75rem; padding-bottom:.3rem; border-bottom:1px solid #b8c1c7; }
  h3 { font:600 1rem/1.3 var(--sans); margin:0; color:#20252b; }
  .dates { font-size:.85em; white-space:nowrap; }
  .position { font-style:italic; margin:.12rem 0 .3rem; }
  ul { padding-left:1.2rem; margin:.3rem 0 .9rem; }
  li { margin:.25rem 0; }
  .entry { margin-bottom:1rem; }
  .project { margin:.65rem 0; }
  .project p,.education p { margin:.2rem 0 .6rem; }
  .project-source { font-size:.9em; font-weight:400; overflow-wrap:anywhere; }
  .entry .project-source { margin:.15rem 0 .3rem; }
  .project h3 .project-source { margin-left:.6rem; }
  .skills p { margin:.25rem 0; }
  .skills b { font-weight:600; }
  .source-note { font-size:.85rem; margin-top:2rem; }
  @media(max-width:600px) { .cv { margin:0; padding:1.5rem 1.1rem; } h1 { font-size:1.65rem; } }
  @media print {
    :global(html),:global(body) { background:#fff!important; color:#20252b!important; font-size:10pt; line-height:1.3; }
    :global(.sbar),:global(.top),:global(.foot),:global(.skip),:global(.world),.no-print { display:none!important; }
    :global(body::before),:global(body::after) { display:none!important; }
    .cv { max-width:none; padding:0; margin:0; border:0; font-size:10pt; line-height:1.3; }
    .cv:not(.concise) section[aria-labelledby="projects"] { break-before:page; }
    h1 { font-size:21pt; }
    h2 { font-size:11pt; margin:1rem 0 .45rem; break-after:avoid; }
    h3 { font-size:10pt; }
    .contact { font-size:9pt; }
    .specialism { font-size:10pt; }
    .summary { margin:.7rem 0; }
    .entry,.project,.education { break-inside:avoid; }
    .entry { margin-bottom:.65rem; }
    ul { margin:.2rem 0 .5rem; }
    li { margin:.16rem 0; }
    .cv a { color:inherit; text-decoration:none; }
    .concise { font-size:10pt; line-height:1.25; }
    .concise h2 { margin:.65rem 0 .3rem; }
    .concise h3 { font-size:10pt; }
    .concise .entry { margin-bottom:.4rem; }
    .concise .summary { margin:.5rem 0; }
  }
  @media print { :global(html) { color-scheme:light; } :global(.bar-space) { display:none!important; } }
</style>
